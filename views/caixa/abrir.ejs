<%
  /* ─── Defensive fallbacks ─── */
  const _op = (
    (typeof utilizador !== 'undefined' && utilizador) ? utilizador :
    (typeof locals !== 'undefined' && locals.utilizador) ? locals.utilizador :
    'Operador'
  );
  const _iniciais = _op.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();
  const _erro = (typeof erro !== 'undefined' && erro) ? erro : null;
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Abrir Caixa — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --primary: #E53935; --primary-dark: #c62828; --primary-soft: #FFF5F5;
  --dark: #2E2E2E; --dark-2: #3a3a3a;
  --success: #4CAF50; --success-dark: #2E7D32; --success-soft: #E8F5E9;
  --warning: #FF9800; --warning-dark: #E65100; --warning-soft: #FFF8E1;
  --info: #2196F3; --info-dark: #1565C0; --info-soft: #E3F2FD;

  --bg: #F5F6F8; --surface: #FFFFFF; --surface-subtle: #FAFBFC;
  --border: #e6e8ec; --border-strong: #d0d4dc;
  --fg: #1f2328; --fg-soft: #4a5058; --fg-muted: #8b939f; --fg-placeholder: #b0b7c0;

  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px;

  --sidebar-w: 220px; --radius: 4px;
  color-scheme: light;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px; line-height: 1.5; color: var(--fg); background: var(--bg);
  display: flex; min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
:focus { outline: none; }
:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }

.btn {
  display: inline-flex; align-items: center; gap: var(--s-2);
  padding: var(--s-2) var(--s-3); border: 1px solid transparent;
  border-radius: var(--radius); font: inherit; font-size: 13px; font-weight: 500;
  cursor: pointer; transition: background-color .15s, border-color .15s, color .15s;
  white-space: nowrap;
}
.btn i { font-size: 11px; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-dark); }
.btn-primary i { color: #fff; }
.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border-strong); }
.btn-outline:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); }
.btn-outline i { color: var(--fg-soft); }
.btn-block { display: flex; width: 100%; justify-content: center; }

.sidebar {
  width: var(--sidebar-w); background: var(--dark); color: #fff;
  padding: var(--s-5) 0; height: 100vh; position: fixed; inset: 0 auto 0 0;
  overflow-y: auto; z-index: 100; display: flex; flex-direction: column;
}
.logo {
  display: flex; align-items: center; gap: var(--s-2);
  font-size: 15px; font-weight: 700; color: var(--primary); letter-spacing: .5px;
  padding: 0 var(--s-5) var(--s-5); border-bottom: 1px solid #2a2a2a; margin-bottom: var(--s-4);
}
.logo i { color: var(--primary); font-size: 15px; }
.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex; align-items: center; gap: var(--s-3);
  padding: var(--s-3) var(--s-5); font-size: 13px; font-weight: 500; color: #d5d9df;
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover { background: var(--dark-2); color: var(--primary); }
.nav-menu a.active { background: var(--dark-2); color: var(--primary); border-left-color: var(--primary); }
.nav-menu a.active i { color: var(--primary); }
.nav-menu i { width: 16px; text-align: center; font-size: 12px; color: #666; }
.user-info {
  padding: var(--s-4) var(--s-5) 0; border-top: 1px solid #2a2a2a;
  margin-top: var(--s-4); display: flex; align-items: center; gap: var(--s-3);
}
.user-avatar {
  width: 32px; height: 32px; border-radius: 50%; background: var(--primary);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 600; font-size: 12px; flex-shrink: 0;
}
.user-details { min-width: 0; flex: 1; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

.main-content {
  flex: 1; margin-left: var(--sidebar-w); padding: var(--s-5);
  min-width: 0; display: flex; flex-direction: column;
}
.page-container {
  width: 100%; max-width: 640px; margin: 0 auto;
  display: flex; flex-direction: column; gap: var(--s-4);
}

.topbar {
  display: flex; align-items: center; gap: var(--s-3);
  padding-bottom: var(--s-4); border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-4);
}
.topbar-back {
  width: 36px; height: 36px; border-radius: var(--radius);
  background: var(--surface); border: 1px solid var(--border);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--fg-soft); transition: color .15s, border-color .15s;
}
.topbar-back:hover { color: var(--primary); border-color: var(--primary); }
.topbar h1 {
  font-size: 20px; font-weight: 600; letter-spacing: -.005em;
}
.topbar .subtitle {
  font-size: 12px; color: var(--fg-muted); margin-top: 2px;
}

.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
}
.card-head {
  padding: var(--s-3) var(--s-4);
  background: var(--surface-subtle);
  border-bottom: 1px solid var(--border);
}
.card-head h3 { font-size: 14px; font-weight: 600; }
.card-body { padding: var(--s-4); }

.form-group { display: flex; flex-direction: column; gap: var(--s-1); margin-bottom: var(--s-4); }
.form-label { font-size: 12px; color: var(--fg); font-weight: 500; }
.form-label .required { color: var(--primary); margin-left: 2px; }
.input-money { position: relative; }
.input-money input { padding-right: 36px; text-align: right; font-variant-numeric: tabular-nums; }
.input-money::after {
  content: 'Kz'; position: absolute; right: 12px; top: 50%;
  transform: translateY(-50%); font-size: 10px; font-weight: 500;
  color: var(--fg-muted); pointer-events: none;
}
.form-control {
  width: 100%; padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border); border-radius: var(--radius);
  font: inherit; font-size: 13px; background: var(--surface); color: var(--fg);
  caret-color: var(--primary); transition: border-color .15s;
}
.form-control:focus {
  outline: 2px solid var(--primary); outline-offset: 1px;
  border-color: var(--primary);
}
.form-hint { font-size: 11px; color: var(--fg-muted); margin-top: var(--s-1); }

.notice {
  display: flex; gap: var(--s-2); padding: var(--s-3);
  border-left: 3px solid var(--warning); background: var(--warning-soft);
  border-radius: var(--radius); font-size: 13px; color: var(--warning-dark);
  line-height: 1.5; margin-bottom: var(--s-4);
}
.notice i { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
.notice strong { color: var(--fg); font-weight: 600; }

.form-actions {
  display: flex; justify-content: flex-end; gap: var(--s-2);
  padding-top: var(--s-4); border-top: 1px solid var(--border);
  margin-top: var(--s-4);
}

@media (max-width: 900px) {
  :root { --sidebar-w: 60px; }
  .sidebar .logo span, .sidebar .nav-menu a span, .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { padding: var(--s-3); }
}
@media (max-width: 600px) {
  .main-content { padding: var(--s-2); }
  .form-actions { flex-direction: column-reverse; }
  .form-actions .btn { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
</style>
</head>
<body>

<aside class="sidebar">
  <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
  <ul class="nav-menu">
    <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i><span>Painel principal</span></a></li>
    <li><a href="/caixa" class="active"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
    <li><a href="/vendas"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
    <li><a href="/produtos"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
    <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
    <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
    <li><a href="#"><i class="fas fa-cog"></i><span>Configurações</span></a></li>
  </ul>
  <div class="user-info">
    <div class="user-avatar"><%= _iniciais %></div>
    <div class="user-details">
      <div class="user-name"><%= _op %></div>
      <div class="user-role">Gerente</div>
    </div>
  </div>
</aside>

<main class="main-content">
  <div class="page-container">

    <div class="topbar">
      <a href="/caixa" class="topbar-back" title="Voltar" aria-label="Voltar">
        <i class="fas fa-arrow-left"></i>
      </a>
      <div>
        <h1>Abrir caixa</h1>
        <div class="subtitle">Informe o valor inicial do caixa</div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h3>Abertura de caixa</h3>
      </div>
      <div class="card-body">

        <% if (_erro) { %>
        <div class="notice">
          <i class="fas fa-exclamation-triangle"></i>
          <div>
            <strong>Não foi possível abrir o caixa.</strong>
            <%= _erro === 'caixa_aberto' ? 'Já existe um caixa em aberto. Feche-o antes de abrir outro.' : _erro %>
          </div>
        </div>
        <% } %>

        <form method="POST" action="/caixa/abrir" id="formAbrirCaixa">
          <div class="form-group">
            <label class="form-label" for="valor_abertura">
              Valor de abertura <span class="required">*</span>
            </label>
            <div class="input-money">
              <input type="number" id="valor_abertura" name="valor_abertura"
                     class="form-control" step="0.01" min="0" value="0"
                     placeholder="0,00" inputmode="decimal" required autofocus>
            </div>
            <div class="form-hint">Dinheiro disponível no caixa no momento da abertura.</div>
          </div>

          <div class="form-actions">
            <a href="/caixa" class="btn btn-outline">Cancelar</a>
            <button type="submit" class="btn btn-primary" id="btnAbrir">
              <i class="fas fa-lock-open"></i> Abrir caixa
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</main>

<script>
  document.getElementById('formAbrirCaixa').addEventListener('submit', function () {
    const btn = document.getElementById('btnAbrir');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A abrir…';
  });
</script>

</body>
</html>