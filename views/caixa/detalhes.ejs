<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Caixa <%= typeof caixa !== 'undefined' ? caixa.id : '' %> — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  /* ─── Cores originais (mantidas) ─── */
  --primary:        #E53935;
  --primary-dark:   #c62828;
  --primary-soft:   #FFF3F3;
  --dark:           #2E2E2E;
  --dark-2:         #1a1a1a;
  --success:        #4CAF50;
  --success-dark:   #2E7D32;
  --success-soft:   #E8F5E9;
  --warning:        #FF9800;
  --warning-dark:   #F57C00;
  --warning-soft:   #FFF3E0;
  --info:           #17a2b8;
  --info-dark:      #138496;
  --info-soft:      #E3F2FD;
  --danger:         #dc3545;
  --danger-dark:    #c82333;
  --danger-soft:    #FFEBEE;

  --bg:             #F5F5F5;
  --surface:        #FFFFFF;
  --surface-subtle: #FAFAFA;
  --border:         #e5e5e5;
  --border-strong:  #ddd;
  --fg:             #2E2E2E;
  --fg-soft:        #666666;
  --fg-muted:       #888888;

  --neutral-soft:   #F5F5F5;

  /* ─── Escala de espaço ─── */
  --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px; --s-7: 48px;

  --radius: 4px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg);
  background: var(--bg);
  display: flex;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }
::selection { background: var(--fg); color: var(--surface); }
:focus { outline: none; }
:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
  border-radius: 4px;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: .35; }
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- Botões ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border: 1px solid transparent;
  border-radius: var(--radius);
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
  white-space: nowrap;
}
.btn i { font-size: 11px; }
.btn:disabled { opacity: .55; cursor: not-allowed; }

.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-dark); }
.btn-primary:active:not(:disabled) { background: var(--primary-dark); }
.btn-primary i { color: #fff; }

.btn-warning { background: var(--warning); color: #fff; }
.btn-warning:hover:not(:disabled) { background: var(--warning-dark); }
.btn-warning:active:not(:disabled) { background: var(--warning-dark); }
.btn-warning i { color: #fff; }

.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border-strong); }
.btn-outline:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); }
.btn-outline:hover:not(:disabled) i { color: var(--primary); }
.btn-outline:active:not(:disabled) { background: var(--surface-subtle); }
.btn-outline i { color: var(--fg-soft); }

.btn-sm { padding: var(--s-1) var(--s-2); font-size: 12px; }
.btn-sm i { font-size: 10px; }
.btn-block { display: flex; width: 100%; }

.icon-btn {
  padding: 0;
  width: 28px; height: 28px;
  justify-content: center;
}

/* ---------- Sidebar ---------- */
.sidebar {
  width: 220px;
  background: var(--dark);
  color: #fff;
  padding: var(--s-5) 0;
  height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  overflow-y: auto;
  z-index: 100;
  display: flex;
  flex-direction: column;
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: 15px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: .5px;
  padding: 0 var(--s-5) var(--s-5);
  border-bottom: 1px solid #2a2a2a;
  margin-bottom: var(--s-4);
}
.logo i { color: var(--primary); font-size: 15px; }

.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  font-size: 13px;
  font-weight: 500;
  color: #d4d4d4;
  padding: var(--s-3) var(--s-5);
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover { background: #3a3a3a; color: var(--primary); }
.nav-menu a:hover i { color: var(--primary); }
.nav-menu a.active {
  background: #3a3a3a;
  color: var(--primary);
  border-left-color: var(--primary);
}
.nav-menu a.active i { color: var(--primary); }
.nav-menu a:focus-visible { outline-color: #fff; }
.nav-menu i {
  width: 16px;
  text-align: center;
  font-size: 12px;
  color: #666;
  transition: color .2s ease;
}

.user-info {
  padding: var(--s-4) var(--s-5) 0;
  border-top: 1px solid #2a2a2a;
  margin-top: var(--s-4);
  display: flex;
  align-items: center;
  gap: var(--s-3);
}
.user-avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: var(--primary);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  font-weight: 600;
  font-size: 12px;
  flex-shrink: 0;
}
.user-details { flex: 1; min-width: 0; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

/* ---------- Main ---------- */
.main-content {
  flex: 1;
  margin-left: 220px;
  padding: var(--s-5);
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--s-4);
}

/* ---------- Header ---------- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-4);
  flex-wrap: wrap;
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.header-left { display: flex; align-items: center; gap: var(--s-3); }
.header-back {
  width: 36px; height: 36px;
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--fg-soft);
  transition: color .15s, border-color .15s;
  flex-shrink: 0;
}
.header-back:hover { color: var(--primary); border-color: var(--primary); }
.header-back:active { background: var(--surface-subtle); }
.page-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -.005em;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.page-subtitle {
  font-size: 12px;
  color: var(--fg-muted);
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: var(--s-2);
  flex-wrap: wrap;
  font-variant-numeric: tabular-nums;
}
.page-subtitle .sep { color: var(--border); }
.header-actions {
  display: flex;
  gap: var(--s-2);
  flex-wrap: wrap;
  align-items: center;
}
.search-box {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: var(--s-1) var(--s-3);
  transition: border-color .15s;
}
.search-box:focus-within { border-color: var(--primary); }
.search-box i { color: var(--fg-muted); font-size: 12px; }
.search-box input {
  border: none;
  outline: none;
  padding: var(--s-1);
  width: 180px;
  font: inherit;
  font-size: 13px;
  background: transparent;
  color: var(--fg);
  caret-color: var(--primary);
}
.search-box input::placeholder { color: #999; }

/* ---------- KPI strip ---------- */
.kpi-strip {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: var(--s-4);
  padding: var(--s-4) var(--s-5);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}
.kpi { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.kpi-label {
  font-size: 12px;
  color: var(--fg-muted);
  font-weight: 500;
}
.kpi-value {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -.005em;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
  color: var(--fg);
}
.kpi-sub {
  font-size: 11px;
  color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
}
.kpi.kpi-success .kpi-value { color: var(--success-dark); }
.kpi.kpi-warning .kpi-value { color: var(--warning-dark); }
.kpi.kpi-primary .kpi-value { color: var(--primary); }

/* ---------- Layout 2 colunas ---------- */
.layout {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--s-4);
  align-items: start;
}
.col-main, .col-side { min-width: 0; }

/* ---------- Card ---------- */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: var(--s-4);
  overflow: hidden;
}
.card:last-child { margin-bottom: 0; }
.card-header {
  background: var(--surface-subtle);
  padding: var(--s-3) var(--s-4);
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
}
.card-header h3 {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: var(--s-2);
}
.card-header-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 12px;
  flex-shrink: 0;
}
.card-header-icon i { font-size: 12px; color: inherit; }
.card-header-icon.is-primary { background: var(--primary-soft); color: var(--primary); }
.card-header-icon.is-info    { background: var(--info-soft);    color: var(--info-dark); }
.card-header-icon.is-neutral { background: var(--neutral-soft); color: var(--fg-soft); }
.card-header-actions {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  flex-wrap: wrap;
}
.card-header-actions .counter {
  font-size: 12px;
  color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
}
.card-body { padding: var(--s-4); }

/* ---------- Info groups ---------- */
.info-list { display: flex; flex-direction: column; }
.info-group {
  padding: var(--s-3) 0;
  border-bottom: 1px solid var(--border);
}
.info-group:first-child { padding-top: 0; }
.info-group:last-child { border-bottom: none; padding-bottom: 0; }
.info-group label {
  display: flex;
  align-items: center;
  gap: var(--s-1);
  font-weight: 500;
  color: var(--fg-muted);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: var(--s-1);
}
.info-group label i { font-size: 11px; color: var(--fg-muted); }
.info-value {
  color: var(--fg);
  font-weight: 600;
  font-size: 14px;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}
.info-value.text-success { color: var(--success-dark); }
.info-value.text-danger  { color: var(--primary-dark); }
.info-value.text-primary { color: var(--primary); font-size: 18px; }

/* ---------- Status ---------- */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .3px;
  text-transform: uppercase;
}
.status-badge::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}
.status-badge.status-aberto {
  background: var(--success-soft);
  color: var(--success-dark);
}
.status-badge.status-aberto::before {
  animation: pulse 1.6s ease-in-out infinite;
}
.status-badge.status-fechado {
  background: var(--danger-soft);
  color: var(--primary-dark);
}

/* ---------- Badges ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .3px;
}
.badge i { font-size: 9px; }
.badge-success { background: var(--success-soft); color: var(--success-dark); }
.badge-danger  { background: var(--danger-soft);  color: var(--primary-dark); }
.badge-info    { background: var(--info-soft);    color: var(--info-dark); }
.badge-neutral { background: var(--neutral-soft); color: var(--fg-soft); }

/* ---------- Tabelas ---------- */
.table-responsive { overflow-x: auto; }
.data-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
}
.data-table thead th {
  text-align: left;
  padding: var(--s-3);
  font-size: 11px;
  font-weight: 500;
  color: var(--fg-muted);
  text-transform: uppercase;
  letter-spacing: .5px;
  border-bottom: 1px solid var(--border);
  background: var(--surface-subtle);
  white-space: nowrap;
}
.data-table tbody td {
  padding: var(--s-3);
  border-bottom: 1px solid var(--border);
  font-size: 13px;
  vertical-align: middle;
}
.data-table tbody tr { transition: background-color .1s; }
.data-table tbody tr:hover td { background: var(--surface-subtle); }
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tfoot td {
  background: var(--surface-subtle);
  font-weight: 600;
  border-top: 1px solid var(--border);
  font-size: 13px;
  padding: var(--s-3);
  font-variant-numeric: tabular-nums;
}
.data-table td.text-end,
.data-table th.text-end { text-align: right; font-variant-numeric: tabular-nums; }
.data-table td.text-center,
.data-table th.text-center { text-align: center; }

/* ---------- Filtros de tabela ---------- */
.table-filters {
  display: flex;
  gap: var(--s-2);
  flex-wrap: wrap;
  align-items: center;
  padding: var(--s-3) var(--s-4);
  background: var(--surface-subtle);
  border-bottom: 1px solid var(--border);
}
.filter-input {
  padding: var(--s-1) var(--s-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font: inherit;
  font-size: 13px;
  background: var(--surface);
  color: var(--fg);
  min-width: 140px;
  transition: border-color .15s;
}
.filter-input:focus { outline: 2px solid var(--primary); outline-offset: 1px; border-color: var(--primary); }
.filter-search-wrapper { position: relative; flex: 1; min-width: 180px; }
.filter-search-wrapper i {
  position: absolute;
  left: var(--s-3);
  top: 50%;
  transform: translateY(-50%);
  color: var(--fg-muted);
  font-size: 12px;
  pointer-events: none;
}
.filter-search-wrapper .filter-input { width: 100%; padding-left: 32px; }

/* ---------- Movimentos ---------- */
.mov-desc { font-weight: 500; color: var(--fg); }
.mov-valor {
  font-weight: 600;
  font-size: 13px;
  font-variant-numeric: tabular-nums;
}
.mov-valor.entrada { color: var(--success-dark); }
.mov-valor.saida   { color: var(--primary-dark); }
.mov-data-hora { display: flex; flex-direction: column; line-height: 1.3; }
.mov-data-hora .data { font-weight: 500; }
.mov-data-hora .hora { font-size: 11px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }

/* ---------- Empty ---------- */
.empty-state {
  padding: var(--s-6) var(--s-4);
  text-align: center;
  color: var(--fg-muted);
  font-size: 13px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s-2);
}
.empty-state i {
  font-size: 22px;
  color: var(--border-strong);
}

/* ---------- Toasts ---------- */
#toast-container {
  position: fixed;
  top: var(--s-4);
  right: var(--s-4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}
.toast {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border-radius: var(--radius);
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--fg-muted);
  color: var(--fg);
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(0,0,0,.08);
  animation: fadeIn .15s ease;
  max-width: 360px;
}
.toast i { font-size: 12px; flex-shrink: 0; }
.toast.success { border-left-color: var(--success); }
.toast.success i { color: var(--success); }
.toast.error { border-left-color: var(--primary); }
.toast.error i { color: var(--primary); }
.toast.info { border-left-color: var(--info); }
.toast.info i { color: var(--info); }
.toast.warning { border-left-color: var(--warning); }
.toast.warning i { color: var(--warning); }

/* ---------- Modal ---------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--s-4);
  overflow-y: auto;
}
.modal-backdrop.open { display: flex; animation: fadeIn .15s ease; }
.modal {
  background: var(--surface);
  border-radius: var(--radius);
  width: 100%;
  max-width: 500px;
  box-shadow: 0 8px 24px rgba(0,0,0,.15);
  overflow: hidden;
  margin: auto;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 32px);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-4);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.modal-header h3 { font-size: 14px; font-weight: 600; }
.modal-close {
  background: none;
  border: none;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  color: var(--fg-muted);
  padding: 0 var(--s-1);
  transition: color .15s;
}
.modal-close:hover { color: var(--fg); }
.modal-body {
  padding: var(--s-4);
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  overflow-y: auto;
  flex: 1;
}
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--s-2);
  padding: var(--s-3) var(--s-4);
  border-top: 1px solid var(--border);
  background: var(--surface-subtle);
  flex-shrink: 0;
}

/* ---------- Formulário ---------- */
.form-group { display: flex; flex-direction: column; gap: var(--s-1); }
.form-label {
  font-size: 12px;
  color: var(--fg);
  font-weight: 500;
}
.form-label .required { color: var(--primary); margin-left: 2px; }
.form-control {
  width: 100%;
  padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font: inherit;
  font-size: 13px;
  background: var(--surface);
  color: var(--fg);
  caret-color: var(--primary);
  transition: border-color .15s;
}
.form-control::placeholder { color: #999; }
.form-control:focus {
  outline: 2px solid var(--primary);
  outline-offset: 1px;
  border-color: var(--primary);
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }

/* Tipo entrada/saída — sem :has(), com sibling selector */
.tipo-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-2);
}
.tipo-opt { position: relative; }
.tipo-opt input { position: absolute; opacity: 0; pointer-events: none; }
.tipo-opt-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  color: var(--fg-soft);
  background: var(--surface);
  transition: background-color .15s, border-color .15s, color .15s;
}
.tipo-opt-inner i { font-size: 11px; }
.tipo-opt:hover .tipo-opt-inner { border-color: var(--primary); }
.tipo-opt input:focus-visible + .tipo-opt-inner {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}
.tipo-opt input[value="entrada"]:checked + .tipo-opt-inner {
  background: var(--success-soft);
  border-color: var(--success);
  color: var(--success-dark);
}
.tipo-opt input[value="saida"]:checked + .tipo-opt-inner {
  background: var(--danger-soft);
  border-color: var(--primary);
  color: var(--primary-dark);
}

/* ---------- Info estático (caixa fechado) ---------- */
.info-static {
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
  padding: var(--s-3);
  margin-top: var(--s-2);
  background: var(--surface-subtle);
  border: 1px solid var(--border);
  border-left: 3px solid var(--fg-muted);
  border-radius: var(--radius);
  font-size: 12px;
  color: var(--fg-soft);
  line-height: 1.5;
}
.info-static i { color: var(--fg-muted); font-size: 12px; margin-top: 1px; flex-shrink: 0; }

/* ---------- Print header (só visível em @media print) ---------- */
.print-header { display: none; }

/* ---------- Responsivo ---------- */
@media (max-width: 1100px) {
  .layout { grid-template-columns: 1fr; }
}

@media (max-width: 900px) {
  .sidebar { width: 60px; }
  .sidebar .logo span,
  .sidebar .nav-menu a span,
  .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { margin-left: 60px; padding: var(--s-3); }
  .kpi-strip { padding: var(--s-3) var(--s-4); }
}

@media (max-width: 600px) {
  .page-title { font-size: 18px; }
  .header-actions { width: 100%; }
  .header-actions .btn { flex: 1; justify-content: center; }
  .search-box { flex: 1; }
  .search-box input { width: 100%; }
  .form-row { grid-template-columns: 1fr; }
  .table-filters { flex-direction: column; align-items: stretch; }
  .filter-input { width: 100%; }
  .kpi-strip { grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .kpi-value { font-size: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
  .status-badge.status-aberto::before { animation: none; }
}

/* ---------- Impressão ---------- */
@media print {
  @page { size: A4 portrait; margin: 12mm; }
  html, body {
    background: #fff !important;
    display: block !important;
    font-size: 10pt;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .sidebar, .header, .no-print, .btn, #toast-container,
  .modal-backdrop, .table-filters, .card-header-actions { display: none !important; }
  .main-content { margin: 0 !important; padding: 0 !important; gap: 12pt; }

  .print-header {
    display: flex !important;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20pt;
    padding-bottom: 8pt;
    margin-bottom: 12pt;
    border-bottom: 2pt solid var(--dark);
    flex-wrap: wrap;
  }
  .print-brand-name { font-size: 16pt; font-weight: 700; letter-spacing: .5pt; }
  .print-brand-sub { font-size: 9pt; color: #555; line-height: 1.4; }
  .print-meta { text-align: right; font-size: 9pt; line-height: 1.5; color: #333; }
  .print-meta strong { color: #000; }

  .kpi-strip {
    border: 1pt solid #999 !important;
    page-break-inside: avoid;
    border-radius: 0 !important;
  }
  .layout { display: block; }
  .col-main, .col-side { width: 100%; margin-bottom: 12pt; }
  .card {
    border: 1pt solid #999 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    break-inside: avoid;
    margin-bottom: 12pt;
  }
  .data-table thead th {
    background: var(--dark) !important;
    color: #fff !important;
  }
  .status-badge, .badge { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .card-header { background: #f5f5f5 !important; }
}
</style>
</head>
<body>

<%
  /* ---------- Helpers ---------- */
  const _caixa = (typeof caixa !== 'undefined') ? caixa : {};
  const _fmtKz = (n) => Number(n || 0).toLocaleString('pt-AO', {
    minimumFractionDigits: 2, maximumFractionDigits: 2
  });
  const _nomeOperador = (typeof locals !== 'undefined' && locals.utilizador)
    ? locals.utilizador : 'João Silva';
  const _iniciaisOperador = _nomeOperador.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();

  const _formas = {
    'dinheiro':       'Dinheiro',
    'cartao_debito':  'TPA',
    'Tpa':            'TPA',
    'cartao_credito': 'Cartão Crédito',
    'transferencia':  'Transferência'
  };

  /* Saldo: 0 é válido → usar != null (não ||) */
  const _saldoAtual = (_caixa.saldo_final != null)
    ? Number(_caixa.saldo_final)
    : Number(_caixa.valor_abertura || 0);

  /* Totalizações de movimentos para o KPI strip */
  let _totEntradas = 0, _totSaidas = 0, _countEntradas = 0, _countSaidas = 0;
  if (Array.isArray(_caixa.MovimentoCaixas)) {
    _caixa.MovimentoCaixas.forEach(m => {
      const v = Number(m.valor || 0);
      if (m.tipo === 'entrada') { _totEntradas += v; _countEntradas++; }
      else { _totSaidas += v; _countSaidas++; }
    });
  }

  const _temMovimentos = Array.isArray(_caixa.MovimentoCaixas) && _caixa.MovimentoCaixas.length > 0;
  const _temVendas = Array.isArray(_caixa.Vendas) && _caixa.Vendas.length > 0;
  const _aberto = _caixa.status === 'aberto';

  const _agora = new Date().toLocaleString('pt-AO', {
    day: '2-digit', month: '2-digit', year: 'numeric',
    hour: '2-digit', minute: '2-digit'
  });
%>

<!-- ============================================================
     SIDEBAR
     ============================================================ -->
<aside class="sidebar no-print">
    <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
    <ul class="nav-menu">
        <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i><span>Painel principal</span></a></li>
        <li><a href="/caixa" class="active"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
        <li><a href="/vendas"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
        <li><a href="/produtos"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
        <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
        <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
        <li><a href="#"><i class="fas fa-cog"></i><span>Configurações</span></a></li>
    </ul>
    <div class="user-info">
        <div class="user-avatar"><%= _iniciaisOperador %></div>
        <div class="user-details">
            <div class="user-name"><%= _nomeOperador %></div>
            <div class="user-role">Gerente</div>
        </div>
    </div>
</aside>

<!-- ============================================================
     MAIN
     ============================================================ -->
<main class="main-content">

    <!-- Print-only header -->
    <div class="print-header">
        <div>
            <div class="print-brand-name">BOM MUNDO</div>
            <div class="print-brand-sub">Comércio Geral e Prestação de Serviços</div>
            <div class="print-brand-sub">NIF: 5000000000 · Luanda, Angola</div>
        </div>
        <div class="print-meta">
            <div><strong>Documento:</strong> Caixa #<%= _caixa.id %></div>
            <div><strong>Emitido:</strong> <%= _agora %></div>
            <div><strong>Operador:</strong> <%= _nomeOperador %></div>
        </div>
    </div>

    <!-- HEADER -->
    <header class="header no-print">
        <div class="header-left">
            <a href="/caixa" class="header-back" title="Voltar para caixas" aria-label="Voltar para caixas">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">Caixa #<%= _caixa.id %></h1>
                <div class="page-subtitle">
                    <span class="status-badge status-<%= _caixa.status %>">
                        <%= _aberto ? 'Aberto' : 'Fechado' %>
                    </span>
                    <span class="sep">·</span>
                    <span><%= _caixa.Funcionario ? _caixa.Funcionario.nome : '—' %></span>
                    <span class="sep">·</span>
                    <span><%= _aberto ? 'Em operação' : 'Encerrado' %></span>
                </div>
            </div>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="globalSearch" placeholder="Pesquisar movimentos">
            </div>
            <button type="button" class="btn btn-outline" onclick="window.print()">
                <i class="fas fa-print"></i> Imprimir
            </button>
            <button type="button" class="btn btn-outline" onclick="window.location.reload()" title="Actualizar">
                <i class="fas fa-rotate"></i> Actualizar
            </button>
            <% if (_aberto) { %>
            <button type="button" class="btn btn-primary" onclick="abrirModalMovimento()" title="Alt+N">
                <i class="fas fa-plus"></i> Novo movimento
            </button>
            <% } %>
        </div>
    </header>

    <!-- KPI STRIP -->
    <section class="kpi-strip" aria-label="Resumo do caixa">
        <div class="kpi">
            <span class="kpi-label">Valor de abertura</span>
            <span class="kpi-value"><%= _fmtKz(_caixa.valor_abertura) %> Kz</span>
        </div>
        <div class="kpi kpi-success">
            <span class="kpi-label">Entradas</span>
            <span class="kpi-value">+ <%= _fmtKz(_totEntradas) %> Kz</span>
            <span class="kpi-sub"><%= _countEntradas %> <%= _countEntradas === 1 ? 'movimento' : 'movimentos' %></span>
        </div>
        <div class="kpi kpi-warning">
            <span class="kpi-label">Saídas</span>
            <span class="kpi-value">− <%= _fmtKz(_totSaidas) %> Kz</span>
            <span class="kpi-sub"><%= _countSaidas %> <%= _countSaidas === 1 ? 'movimento' : 'movimentos' %></span>
        </div>
        <div class="kpi kpi-primary">
            <span class="kpi-label">Saldo actual</span>
            <span class="kpi-value"><%= _fmtKz(_saldoAtual) %> Kz</span>
            <span class="kpi-sub">Disponível em caixa</span>
        </div>
    </section>

    <div class="layout">

        <!-- ====================================================
             COLUNA PRINCIPAL
             ==================================================== -->
        <div class="col-main">

            <!-- MOVIMENTOS -->
            <div class="card">
                <div class="card-header">
                    <h3>
                        <span class="card-header-icon is-primary"><i class="fas fa-exchange-alt"></i></span>
                        Movimentações do caixa
                    </h3>
                    <div class="card-header-actions no-print">
                        <span class="counter" id="movCount"></span>
                        <button type="button" class="btn btn-outline btn-sm" onclick="exportarMovimentosCSV()">
                            <i class="fas fa-file-csv"></i> CSV
                        </button>
                    </div>
                </div>

                <% if (_temMovimentos) { %>
                <div class="table-filters no-print">
                    <div class="filter-search-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text" id="movSearch" class="filter-input" placeholder="Pesquisar descrição">
                    </div>
                    <select id="movTipoFilter" class="filter-input" aria-label="Filtrar por tipo">
                        <option value="">Todos os tipos</option>
                        <option value="entrada">Entradas</option>
                        <option value="saida">Saídas</option>
                    </select>
                    <select id="movCatFilter" class="filter-input" aria-label="Filtrar por categoria">
                        <option value="">Todas as categorias</option>
                        <option value="venda">Venda</option>
                        <option value="despesa">Despesa</option>
                        <option value="outros">Outros</option>
                    </select>
                </div>
                <% } %>

                <div class="table-responsive">
                    <% if (_temMovimentos) { %>
                    <table class="data-table" id="tabelaMovimentos">
                        <thead>
                            <tr>
                                <th>Data / hora</th>
                                <th>Descrição</th>
                                <th class="text-end">Valor (Kz)</th>
                                <th class="text-center">Tipo</th>
                                <th>Categoria</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyMovimentos">
                            <% _caixa.MovimentoCaixas.forEach(mov => {
                                const isEntrada = mov.tipo === 'entrada';
                                const dt = new Date(mov.data_movimento);
                            %>
                            <tr data-tipo="<%= mov.tipo %>" data-categoria="<%= mov.categoria %>">
                                <td>
                                    <div class="mov-data-hora">
                                        <span class="data"><%= dt.toLocaleDateString('pt-AO') %></span>
                                        <span class="hora"><%= dt.toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit' }) %></span>
                                    </div>
                                </td>
                                <td><span class="mov-desc"><%= mov.descricao %></span></td>
                                <td class="text-end">
                                    <span class="mov-valor <%= isEntrada ? 'entrada' : 'saida' %>">
                                        <%= isEntrada ? '+' : '−' %> <%= _fmtKz(mov.valor) %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge <%= isEntrada ? 'badge-success' : 'badge-danger' %>">
                                        <i class="fas fa-arrow-<%= isEntrada ? 'down' : 'up' %>"></i>
                                        <%= isEntrada ? 'Entrada' : 'Saída' %>
                                    </span>
                                </td>
                                <td><span class="badge badge-neutral"><%= mov.categoria %></span></td>
                            </tr>
                            <% }); %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2" class="text-end">Totais do período</td>
                                <td class="text-end">
                                    <div style="color: var(--success-dark);">+ <%= _fmtKz(typeof totalEntradas !== 'undefined' ? totalEntradas : _totEntradas) %></div>
                                    <div style="color: var(--primary-dark);">− <%= _fmtKz(typeof totalSaidas !== 'undefined' ? totalSaidas : _totSaidas) %></div>
                                </td>
                                <td colspan="2">
                                    <strong>Saldo: <span style="color: var(--success-dark);"><%= _fmtKz(_saldoAtual) %></span></strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <div id="movEmptyFilter" class="empty-state" style="display: none;">
                        <i class="fas fa-filter"></i>
                        <span>Sem movimentos para os filtros aplicados.</span>
                    </div>
                    <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <span>Sem movimentos registados.</span>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- VENDAS -->
            <div class="card">
                <div class="card-header">
                    <h3>
                        <span class="card-header-icon is-info"><i class="fas fa-receipt"></i></span>
                        Vendas relacionadas
                    </h3>
                    <div class="card-header-actions no-print">
                        <% if (_temVendas) { %>
                            <span class="counter">
                                <%= _caixa.Vendas.length %> <%= _caixa.Vendas.length === 1 ? 'venda' : 'vendas' %>
                            </span>
                            <a href="/vendas" class="btn btn-outline btn-sm">
                                <i class="fas fa-external-link-alt"></i> Ver todas
                            </a>
                        <% } %>
                    </div>
                </div>

                <% if (_temVendas) { %>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Data / hora</th>
                                <th class="text-end">Valor (Kz)</th>
                                <th>Pagamento</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% _caixa.Vendas.forEach(venda => { %>
                            <tr>
                                <td><strong>#<%= venda.id %></strong></td>
                                <td><%= new Date(venda.data_venda).toLocaleString('pt-AO') %></td>
                                <td class="text-end" style="font-weight: 600; color: var(--primary); font-variant-numeric: tabular-nums;">
                                    <%= _fmtKz(venda.valor_total) %>
                                </td>
                                <td>
                                    <span class="badge badge-info">
                                        <i class="fas fa-credit-card"></i>
                                        <%= _formas[venda.forma_pagamento] || venda.forma_pagamento %>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="/vendas/<%= venda.id %>" class="btn btn-outline btn-sm icon-btn"
                                       title="Ver factura" aria-label="Ver factura <%= venda.id %>">
                                        <i class="fas fa-file-invoice"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Sem vendas associadas.</span>
                </div>
                <% } %>
            </div>

        </div>

        <!-- ====================================================
             COLUNA LATERAL — INFO
             ==================================================== -->
        <aside class="col-side">

            <div class="card">
                <div class="card-header">
                    <h3>
                        <span class="card-header-icon is-neutral"><i class="fas fa-info-circle"></i></span>
                        Informações do caixa
                    </h3>
                </div>
                <div class="card-body">
                    <div class="info-list">

                        <div class="info-group">
                            <label>Estado</label>
                            <div class="info-value">
                                <span class="status-badge status-<%= _caixa.status %>">
                                    <%= _aberto ? 'Aberto' : 'Fechado' %>
                                </span>
                            </div>
                        </div>

                        <div class="info-group">
                            <label>Identificação</label>
                            <div class="info-value">Caixa #<%= _caixa.id %></div>
                        </div>

                        <div class="info-group">
                            <label>Funcionário responsável</label>
                            <div class="info-value"><%= _caixa.Funcionario ? _caixa.Funcionario.nome : '—' %></div>
                        </div>

                        <div class="info-group">
                            <label>Abertura</label>
                            <div class="info-value"><%= new Date(_caixa.data_abertura).toLocaleString('pt-AO') %></div>
                        </div>

                        <% if (_caixa.data_fecho) { %>
                        <div class="info-group">
                            <label>Fecho</label>
                            <div class="info-value"><%= new Date(_caixa.data_fecho).toLocaleString('pt-AO') %></div>
                        </div>
                        <% } %>

                        <div class="info-group">
                            <label>Valor de abertura</label>
                            <div class="info-value"><%= _fmtKz(_caixa.valor_abertura) %> Kz</div>
                        </div>

                        <div class="info-group">
                            <label>Saldo actual</label>
                            <div class="info-value text-success"><%= _fmtKz(_saldoAtual) %> Kz</div>
                        </div>

                        <% if (_aberto) { %>
                        <div class="info-group" style="padding-top: var(--s-4);">
                            <button type="button" class="btn btn-warning btn-block" id="btnFecharCaixa">
                                <i class="fas fa-lock"></i> Fechar caixa
                            </button>
                        </div>
                        <% } else { %>
                        <div class="info-static no-print">
                            <i class="fas fa-lock"></i>
                            <span>Este caixa está fechado. Não é possível adicionar movimentos.</span>
                        </div>
                        <% } %>

                    </div>
                </div>
            </div>

        </aside>
    </div>

</main>

<!-- Form oculto para fechar (existe sempre — submit via JS) -->
<form id="fecharCaixaForm" action="/caixa/fechar/<%= _caixa.id %>" method="POST" style="display:none;"></form>

<!-- ============================================================
     MODAL: NOVO MOVIMENTO
     ============================================================ -->
<% if (_aberto) { %>
<div class="modal-backdrop no-print" id="movimentoModal" onclick="if (event.target === this) fecharModalMovimento()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="movimentoTitulo">
        <div class="modal-header">
            <h3 id="movimentoTitulo">Novo movimento</h3>
            <button type="button" class="modal-close" onclick="fecharModalMovimento()" aria-label="Fechar">&times;</button>
        </div>
        <form id="adicionar-movimento-form" method="POST" action="/caixa/<%= _caixa.id %>/movimento" style="display: contents;">
            <div class="modal-body">

                <div class="form-group">
                    <label class="form-label">Tipo <span class="required">*</span></label>
                    <div class="tipo-toggle">
                        <label class="tipo-opt">
                            <input type="radio" name="tipo" value="entrada" checked>
                            <span class="tipo-opt-inner">
                                <i class="fas fa-arrow-down"></i>
                                <span>Entrada</span>
                            </span>
                        </label>
                        <label class="tipo-opt">
                            <input type="radio" name="tipo" value="saida">
                            <span class="tipo-opt-inner">
                                <i class="fas fa-arrow-up"></i>
                                <span>Saída</span>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="descricao">
                        Descrição <span class="required">*</span>
                    </label>
                    <input type="text" id="descricao" name="descricao" class="form-control"
                           placeholder="Motivo do movimento" required autofocus>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="valor">
                            Valor (Kz) <span class="required">*</span>
                        </label>
                        <input type="number" id="valor" name="valor" class="form-control"
                               step="0.01" min="0.01" placeholder="0,00" required inputmode="decimal">
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="categoria">
                            Categoria <span class="required">*</span>
                        </label>
                        <select id="categoria" name="categoria" class="form-control" required>
                            <option value="venda">Venda</option>
                            <option value="despesa">Despesa</option>
                            <option value="outros">Outros</option>
                        </select>
                    </div>
                </div>

            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline" onclick="fecharModalMovimento()">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnSubmitMovimento">
                    <i class="fas fa-plus"></i> Adicionar
                </button>
            </div>
        </form>
    </div>
</div>
<% } %>

<!-- ============================================================
     MODAL: CONFIRMAÇÃO
     ============================================================ -->
<div class="modal-backdrop no-print" id="confirmModal" onclick="if (event.target === this) fecharModal()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" style="max-width: 440px;">
        <div class="modal-header">
            <h3 id="confirmTitle">Confirmar</h3>
            <button type="button" class="modal-close" onclick="fecharModal()" aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body">
            <p id="confirmMessage" style="font-size: 13px; color: var(--fg-soft); line-height: 1.6;"></p>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline" onclick="fecharModal()">Cancelar</button>
            <button type="button" class="btn btn-primary" id="confirmOkBtn">Confirmar</button>
        </div>
    </div>
</div>

<div id="toast-container" aria-live="polite"></div>

<script>
/* ============================================================
   TOASTS
   ============================================================ */
function toast(msg, tipo = 'info', dur = 3000) {
    const c = document.getElementById('toast-container');
    const icons = {
        success: 'fa-check-circle',
        error: 'fa-exclamation-circle',
        info: 'fa-info-circle',
        warning: 'fa-exclamation-triangle'
    };
    const t = document.createElement('div');
    t.className = 'toast ' + tipo;
    t.innerHTML = '<i class="fas ' + (icons[tipo] || icons.info) + '"></i><span></span>';
    t.querySelector('span').textContent = msg;
    c.appendChild(t);
    setTimeout(() => {
        t.style.transition = 'opacity .2s ease';
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 200);
    }, dur);
}

/* ============================================================
   MODAL DE CONFIRMAÇÃO
   ============================================================ */
let confirmCallback = null;
function confirmar(titulo, mensagem, callback, btnLabel = 'Confirmar') {
    document.getElementById('confirmTitle').textContent = titulo;
    document.getElementById('confirmMessage').textContent = mensagem;
    const okBtn = document.getElementById('confirmOkBtn');
    okBtn.innerHTML = btnLabel;
    confirmCallback = callback;
    document.getElementById('confirmModal').classList.add('open');
    okBtn.onclick = () => {
        fecharModal();
        if (confirmCallback) confirmCallback();
    };
}
function fecharModal() {
    document.getElementById('confirmModal').classList.remove('open');
    confirmCallback = null;
}

/* ============================================================
   MODAL: NOVO MOVIMENTO
   ============================================================ */
function abrirModalMovimento() {
    const modal = document.getElementById('movimentoModal');
    if (!modal) return;
    modal.classList.add('open');
    setTimeout(() => document.getElementById('descricao')?.focus(), 80);
}
function fecharModalMovimento() {
    const modal = document.getElementById('movimentoModal');
    if (!modal) return;
    modal.classList.remove('open');
    const form = document.getElementById('adicionar-movimento-form');
    if (form) form.reset();
}

/* ============================================================
   FECHAR CAIXA
   ============================================================ */
const btnFechar = document.getElementById('btnFecharCaixa');
if (btnFechar) {
    btnFechar.addEventListener('click', () => {
        confirmar(
            'Fechar caixa',
            'Esta acção é definitiva. Após o fecho, não será possível adicionar movimentos.',
            () => {
                btnFechar.disabled = true;
                btnFechar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A fechar…';
                const form = document.getElementById('fecharCaixaForm');
                if (form) form.submit();
            },
            'Fechar caixa'
        );
    });
}

/* ============================================================
   FILTROS DE MOVIMENTOS
   ============================================================ */
const movSearch = document.getElementById('movSearch');
const movTipoFilter = document.getElementById('movTipoFilter');
const movCatFilter = document.getElementById('movCatFilter');

function filtrarMovimentos() {
    const tbody = document.getElementById('tbodyMovimentos');
    if (!tbody) return;

    const termo = (movSearch?.value || '').toLowerCase().trim();
    const tipo = movTipoFilter?.value || '';
    const cat = movCatFilter?.value || '';

    let visiveis = 0;
    tbody.querySelectorAll('tr').forEach(tr => {
        const desc = (tr.querySelector('.mov-desc')?.textContent || '').toLowerCase();
        const match = (!termo || desc.includes(termo))
            && (!tipo || tr.dataset.tipo === tipo)
            && (!cat || tr.dataset.categoria === cat);
        tr.style.display = match ? '' : 'none';
        if (match) visiveis++;
    });

    const emptyFilter = document.getElementById('movEmptyFilter');
    const tabela = document.getElementById('tabelaMovimentos');
    if (emptyFilter && tabela) {
        emptyFilter.style.display = visiveis === 0 ? 'flex' : 'none';
        tabela.style.display = visiveis === 0 ? 'none' : '';
    }

    const movCount = document.getElementById('movCount');
    if (movCount) movCount.textContent = visiveis + (visiveis === 1 ? ' movimento' : ' movimentos');
}

if (movSearch) movSearch.addEventListener('input', filtrarMovimentos);
if (movTipoFilter) movTipoFilter.addEventListener('change', filtrarMovimentos);
if (movCatFilter) movCatFilter.addEventListener('change', filtrarMovimentos);

/* ============================================================
   PESQUISA GLOBAL
   ============================================================ */
const globalSearch = document.getElementById('globalSearch');
if (globalSearch) {
    globalSearch.addEventListener('input', function () {
        if (movSearch) {
            movSearch.value = this.value;
            filtrarMovimentos();
        }
    });
}

/* ============================================================
   EXPORTAR MOVIMENTOS PARA CSV
   ============================================================ */
function exportarMovimentosCSV() {
    const tbody = document.getElementById('tbodyMovimentos');
    if (!tbody || tbody.querySelectorAll('tr').length === 0) {
        toast('Não há movimentos para exportar.', 'warning');
        return;
    }

    const sep = ';';
    const linhas = [];
    linhas.push(['BOM MUNDO — MOVIMENTOS DO CAIXA #<%= _caixa.id %>']);
    linhas.push(['Funcionário', '<%= _caixa.Funcionario ? _caixa.Funcionario.nome : "" %>']);
    linhas.push(['Data de abertura', '<%= new Date(_caixa.data_abertura).toLocaleString("pt-AO") %>']);
    linhas.push(['Estado', '<%= _aberto ? "Aberto" : "Fechado" %>']);
    linhas.push([]);
    linhas.push(['Data/Hora', 'Descrição', 'Valor (Kz)', 'Tipo', 'Categoria']);

    tbody.querySelectorAll('tr').forEach(tr => {
        if (tr.style.display === 'none') return;
        const c = tr.querySelectorAll('td');
        const dataHora = (c[0]?.innerText || '').trim().replace(/\s+/g, ' ');
        const descricao = (c[1]?.innerText || '').trim();
        const valor = (c[2]?.innerText || '').trim();
        const tipo = (c[3]?.innerText || '').trim();
        const categoria = (c[4]?.innerText || '').trim();
        linhas.push([dataHora, descricao, valor, tipo, categoria]);
    });

    const csv = '\uFEFF' + linhas.map(l =>
        l.map(c => {
            const s = String(c == null ? '' : c);
            return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
        }).join(sep)
    ).join('\r\n');

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Movimentos_Caixa_<%= _caixa.id %>_' + new Date().toISOString().slice(0, 10) + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast('CSV exportado.', 'success');
}

/* ============================================================
   ATALHOS
   ============================================================ */
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        fecharModal();
        fecharModalMovimento();
    }
    const isTyping = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName);
    if (isTyping) return;
    if (e.altKey && e.key.toLowerCase() === 'n' && document.getElementById('movimentoModal')) {
        e.preventDefault();
        abrirModalMovimento();
    }
});

/* ============================================================
   INIT
   ============================================================ */
(function () {
    const rows = document.querySelectorAll('#tbodyMovimentos tr');
    const movCount = document.getElementById('movCount');
    if (movCount) movCount.textContent = rows.length + (rows.length === 1 ? ' movimento' : ' movimentos');
})();

const movForm = document.getElementById('adicionar-movimento-form');
if (movForm) {
    movForm.addEventListener('submit', function (e) {
        const valor = parseFloat(document.getElementById('valor').value);
        if (!valor || valor <= 0) {
            e.preventDefault();
            toast('Introduza um valor maior que zero.', 'error');
            document.getElementById('valor').focus();
            return;
        }
        const btn = document.getElementById('btnSubmitMovimento');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A adicionar…';
    });
}
</script>

</body>
</html>