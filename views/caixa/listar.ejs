<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Caixas — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
    --primary:#E53935;--primary-dark:#c62828;--primary-soft:#FFF3F3;
    --dark:#2E2E2E;--dark-2:#3a3a3a;
    --success:#4CAF50;--success-dark:#388E3C;--success-soft:#E8F5E9;
    --warning:#FF9800;--warning-dark:#F57C00;--warning-soft:#FFF3E0;
    --info:#2196F3;--info-dark:#1976D2;--info-soft:#E3F2FD;
    --bg:#F5F6F8;--card:#fff;--border:#e6e8ec;--border-strong:#d0d4dc;
    --text:#1f2328;--text-soft:#4a5058;--muted:#8b939f;
    --shadow-sm:0 1px 3px rgba(0,0,0,.05);
    --shadow:0 4px 12px rgba(0,0,0,.06);
    --shadow-lg:0 12px 32px rgba(0,0,0,.12);
    --radius:10px;--radius-sm:6px;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}
body{background:var(--bg);color:var(--text);line-height:1.5;display:flex;min-height:100vh;font-size:14px}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 16px;border-radius:var(--radius-sm);font-weight:600;font-size:13.5px;border:1px solid transparent;transition:all .18s;white-space:nowrap}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover:not(:disabled){background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 10px rgba(229,57,53,.3)}
.btn-success{background:var(--success);color:#fff}
.btn-success:hover:not(:disabled){background:var(--success-dark);transform:translateY(-1px);box-shadow:0 4px 10px rgba(76,175,80,.3)}
.btn-warning{background:var(--warning);color:#fff}
.btn-warning:hover:not(:disabled){background:var(--warning-dark);transform:translateY(-1px);box-shadow:0 4px 10px rgba(255,152,0,.3)}
.btn-outline{background:#fff;color:var(--text);border-color:var(--border-strong)}
.btn-outline:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
.btn-sm{padding:6px 11px;font-size:12px}
.btn-icon{width:34px;height:34px;padding:0;border-radius:6px}

.sidebar{width:240px;background:var(--dark);color:#fff;padding:18px 0;height:100vh;position:fixed;top:0;left:0;overflow-y:auto;box-shadow:2px 0 12px rgba(0,0,0,.06);z-index:100}
.logo{font-size:22px;font-weight:800;color:var(--primary);display:flex;align-items:center;gap:10px;padding:0 20px 18px;border-bottom:1px solid #444;margin-bottom:14px;letter-spacing:.5px}
.logo i{font-size:24px}
.nav-menu{list-style:none}
.nav-menu li{margin-bottom:2px}
.nav-menu a{color:#d5d9df;font-weight:500;padding:11px 20px;display:flex;align-items:center;gap:12px;border-left:3px solid transparent;transition:all .18s;font-size:14px}
.nav-menu a:hover{background:var(--dark-2);color:#fff}
.nav-menu a.active{background:var(--dark-2);color:#fff;border-left-color:var(--primary);font-weight:600}
.nav-menu a.active i{color:var(--primary)}
.nav-menu i{width:20px;text-align:center;font-size:15px}
.user-info{padding:16px 20px;border-top:1px solid #444;margin-top:18px;display:flex;align-items:center;gap:11px}
.user-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;flex-shrink:0}
.user-details{min-width:0;flex:1}
.user-name{font-weight:600;font-size:13.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-role{font-size:11.5px;color:#9aa1ab}

.main-content{flex:1;margin-left:240px;padding:18px 22px;min-width:0;display:flex;flex-direction:column;gap:16px}

.topbar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.topbar-left h1{font-size:22px;font-weight:700;letter-spacing:-.3px}
.topbar-left .page-subtitle{font-size:12.5px;color:var(--muted);margin-top:2px}
.topbar-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}

/* ============================================================
   PAINEL: CAIXA EM OPERAÇÃO
   ============================================================ */
.caixa-ativo-panel{
    background:linear-gradient(135deg,#ffffff 0%,#fafbfc 100%);
    border:1px solid var(--border);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    overflow:hidden;
    position:relative;
}
.caixa-ativo-panel::before{
    content:'';
    position:absolute;top:0;left:0;right:0;height:4px;
    background:linear-gradient(90deg,var(--success),#66BB6A);
}
.caixa-ativo-header{
    display:flex;justify-content:space-between;align-items:center;
    padding:16px 20px;gap:14px;flex-wrap:wrap;
    border-bottom:1px solid var(--border);
    background:#fff;
}
.caixa-ativo-header-left{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.caixa-ativo-badge{
    display:inline-flex;align-items:center;gap:7px;
    background:var(--success-soft);color:var(--success-dark);
    font-size:11.5px;font-weight:700;padding:5px 12px;border-radius:20px;
    text-transform:uppercase;letter-spacing:.5px;
}
.caixa-ativo-badge::before{
    content:'';width:8px;height:8px;border-radius:50%;
    background:var(--success-dark);animation:pulse 1.6s infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.caixa-ativo-title{font-size:15.5px;font-weight:700;color:var(--text)}
.caixa-ativo-title span{color:var(--muted);font-weight:500;font-size:12.5px;margin-left:8px}
.caixa-ativo-actions{display:flex;gap:8px;flex-wrap:wrap}

.caixa-ativo-kpis{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:12px;
    padding:16px 20px;
    background:#fafbfc;
}
.mini-kpi{
    background:#fff;border:1px solid var(--border);border-radius:8px;
    padding:14px 16px;display:flex;flex-direction:column;gap:4px;
    position:relative;overflow:hidden;transition:all .2s;
}
.mini-kpi:hover{transform:translateY(-1px);box-shadow:var(--shadow)}
.mini-kpi::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--primary)}
.mini-kpi.green::before{background:var(--success)}
.mini-kpi.orange::before{background:var(--warning)}
.mini-kpi.blue::before{background:var(--info)}
.mini-kpi.dark::before{background:var(--dark)}
.mini-kpi-label{
    font-size:10.5px;text-transform:uppercase;letter-spacing:.8px;
    color:var(--muted);font-weight:700;
    display:flex;align-items:center;gap:6px;
}
.mini-kpi-label i{color:#c0c5cc}
.mini-kpi.green .mini-kpi-label i{color:var(--success)}
.mini-kpi.orange .mini-kpi-label i{color:var(--warning)}
.mini-kpi.blue .mini-kpi-label i{color:var(--info)}
.mini-kpi-value{
    font-size:20px;font-weight:800;color:var(--text);
    letter-spacing:-.5px;line-height:1.15;margin:2px 0;
}
.mini-kpi-value.green{color:var(--success-dark)}
.mini-kpi-value.red{color:#c62828}
.mini-kpi-sub{font-size:11.5px;color:var(--muted)}

/* Card */
.card{background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:12px;background:#fafbfc;flex-wrap:wrap}
.card-head h3{font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:9px}
.card-head h3 i{color:var(--primary)}

.filter-bar{padding:12px 14px;border-bottom:1px solid var(--border);background:#fafbfc;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.filter-group{display:flex;align-items:center;gap:6px;background:#fff;border:1.5px solid var(--border-strong);border-radius:6px;padding:6px 11px;transition:border .15s}
.filter-group:focus-within{border-color:var(--primary)}
.filter-group i{color:var(--muted);font-size:12px}
.filter-group input,.filter-group select{border:none;outline:none;font-size:12.5px;background:transparent;font-family:inherit;color:var(--text);min-width:120px}
.filter-bar .spacer{flex:1}

/* Tabela */
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
thead th{background:#f5f6f8;color:var(--text-soft);text-align:left;padding:11px 14px;font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;border-bottom:1.5px solid var(--border);white-space:nowrap}
tbody td{padding:13px 14px;border-bottom:1px solid #f0f2f5;vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:not(.expanded-row):hover{background:#fafbfc}
.text-end{text-align:right}
.text-center{text-align:center}
.text-danger{color:var(--primary);font-weight:700}
.text-success{color:var(--success-dark);font-weight:700}
.text-muted{color:var(--muted)}

/* Expandir linhas */
.row-expand-btn{
    width:28px;height:28px;border-radius:6px;border:1px solid transparent;
    background:transparent;color:var(--muted);
    display:inline-flex;align-items:center;justify-content:center;
    transition:all .18s;font-size:12px;
}
.row-expand-btn:hover{background:#f0f2f5;color:var(--primary);border-color:var(--border)}
.row-expand-btn i{transition:transform .22s}
tr.row-open .row-expand-btn i{transform:rotate(90deg)}
tr.row-open .row-expand-btn{color:var(--primary);background:var(--primary-soft)}

.expanded-row td{padding:0!important;background:#FAFBFC;border-bottom:2px solid var(--primary)!important}
.expanded-content{padding:16px 22px 20px;animation:expandDown .22s ease}
@keyframes expandDown{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}

.expanded-title{
    font-size:13px;font-weight:700;color:var(--text);
    display:flex;align-items:center;gap:9px;margin-bottom:12px;
}
.expanded-title i{color:var(--primary)}
.count-badge{
    background:var(--primary);color:#fff;font-size:11px;font-weight:700;
    padding:2px 9px;border-radius:12px;margin-left:4px;
}
.count-badge.neutral{background:#e4e7ec;color:var(--text-soft)}

.mini-sales-table{
    width:100%;border-collapse:collapse;background:#fff;
    border:1px solid var(--border);border-radius:6px;overflow:hidden;font-size:13px;
}
.mini-sales-table th{
    background:#F5F6F8;padding:9px 12px;font-size:11px;font-weight:700;
    text-transform:uppercase;letter-spacing:.4px;color:var(--text-soft);
    text-align:left;border-bottom:1px solid var(--border);
}
.mini-sales-table td{padding:9px 12px;border-bottom:1px solid #f0f2f5;font-size:13px}
.mini-sales-table tr:last-child td{border-bottom:none}

.no-sales{
    text-align:center;padding:24px 16px;color:var(--muted);
    font-size:13px;background:#fff;border:1px dashed var(--border);
    border-radius:6px;
}
.no-sales i{display:block;font-size:28px;color:#d0d4dc;margin-bottom:8px}

.badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:12px;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.badge-success{background:var(--success-soft);color:var(--success-dark)}
.badge-danger{background:#FFEBEE;color:#c62828}
.badge-info{background:var(--info-soft);color:var(--info-dark)}
.badge-neutral{background:#e4e7ec;color:var(--text-soft)}
.badge i{font-size:10px}

.id-tag{display:inline-flex;align-items:center;gap:5px;background:#f0f2f5;color:var(--text-soft);font-size:12px;font-weight:700;padding:3px 10px;border-radius:12px;font-family:Consolas,monospace}
.func-cell{display:flex;align-items:center;gap:10px}
.func-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;font-size:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.func-nome{font-weight:600;font-size:13px;color:var(--text)}

.row-actions{display:inline-flex;gap:5px;align-items:center;justify-content:center}

.empty{padding:60px 20px;text-align:center;color:var(--muted)}
.empty i{font-size:52px;color:#d0d4dc;margin-bottom:14px;display:block}
.empty h4{font-size:16px;color:var(--text-soft);margin-bottom:6px;font-weight:600}
.empty p{font-size:13px;margin-bottom:16px}

.pag-bar{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 16px;border-top:1px solid var(--border);background:#fafbfc;font-size:12.5px;color:var(--muted);flex-wrap:wrap}
.pag-controls{display:flex;gap:4px}
.pag-btn{min-width:32px;height:32px;padding:0 10px;border:1px solid var(--border-strong);background:#fff;border-radius:6px;font-size:12.5px;font-weight:700;color:var(--text-soft);display:inline-flex;align-items:center;justify-content:center;transition:all .15s}
.pag-btn:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
.pag-btn.active{background:var(--primary);border-color:var(--primary);color:#fff}
.pag-btn:disabled{opacity:.4;cursor:not-allowed}

/* Modal */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:2000;padding:20px;backdrop-filter:blur(2px)}
.modal-backdrop.open{display:flex}
.modal{background:#fff;border-radius:12px;width:100%;max-width:480px;box-shadow:0 20px 50px rgba(0,0,0,.3);overflow:hidden;animation:modalPop .22s ease}
@keyframes modalPop{from{transform:scale(.94) translateY(8px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.modal-header{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#FAFAFA;border-bottom:1px solid #eee}
.modal-header h3{font-size:17px;font-weight:700;display:flex;align-items:center;gap:10px}
.modal-header h3 i{color:var(--warning)}
.modal-close{background:none;border:none;font-size:26px;line-height:1;cursor:pointer;color:#888;padding:0 4px;border-radius:6px;transition:all .15s}
.modal-close:hover{color:var(--primary);background:#f5f5f5}
.modal-body{padding:22px}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;padding:0 22px 22px}
.form-group{margin-bottom:16px}
.form-group:last-child{margin-bottom:0}
.form-label{display:block;margin-bottom:7px;color:var(--text);font-weight:600;font-size:13px;display:flex;align-items:center;gap:6px}
.form-label i{color:var(--muted);font-size:12px}
.form-label .required{color:var(--primary)}
.form-control{width:100%;padding:11px 13px;border:1px solid #ddd;border-radius:6px;font-size:14.5px;transition:all .2s;background:#fff;color:var(--text);font-family:inherit}
.form-control:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 3px rgba(229,57,53,.08)}
.alert-modal{display:flex;gap:12px;padding:12px 14px;border-radius:8px;font-size:13px;line-height:1.5;margin-bottom:18px;background:var(--warning-soft);color:#856404;border-left:3px solid var(--warning)}
.alert-modal i{font-size:16px;flex-shrink:0;margin-top:2px}
.alert-modal strong{color:#5c4408}
.caixa-detalhes-modal{background:#FAFAFA;border:1px solid #eee;border-radius:8px;padding:12px 14px;margin-bottom:18px;display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:12.5px}
.caixa-detalhes-modal .det-label{color:var(--muted);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px}
.caixa-detalhes-modal .det-valor{color:var(--text);font-weight:700;margin-top:2px}

@media(max-width:900px){
    .sidebar{width:64px}
    .sidebar .logo span,.sidebar .nav-menu span,.sidebar .user-details{display:none}
    .sidebar .logo{justify-content:center;padding:0 8px 16px}
    .sidebar .logo i{margin:0}
    .sidebar .nav-menu a{justify-content:center;padding:12px 8px}
    .sidebar .user-info{justify-content:center;padding:14px 8px}
    .main-content{margin-left:64px;padding:14px}
}
@media(max-width:600px){
    .caixa-ativo-kpis{grid-template-columns:1fr}
    .filter-bar{flex-direction:column;align-items:stretch}
    .filter-group{width:100%}
    .filter-group input,.filter-group select{width:100%}
    .caixa-detalhes-modal{grid-template-columns:1fr}
}
</style>
</head>
<body>

<aside class="sidebar">
    <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
    <ul class="nav-menu">
        <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i><span>Painel principal</span></a></li>
        <li><a href="/caixa" class="active"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
        <li><a href="/vendas"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
        <li><a href="/produtos"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
        <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
        <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
        <li><a href="#"><i class="fas fa-cog"></i><span>Configurações</span></a></li>
    </ul>
    <div class="user-info">
        <div class="user-avatar">JS</div>
        <div class="user-details">
            <div class="user-name"><%= locals.utilizador || 'Operador' %></div>
            <div class="user-role">Gerente</div>
        </div>
    </div>
</aside>

<main class="main-content">

    <div class="topbar">
        <div class="topbar-left">
            <h1>Gestão de Caixas</h1>
            <div class="page-subtitle">Controle de aberturas, fechos e movimentos</div>
        </div>
        <div class="topbar-right">
            <a href="/vendas/nova" class="btn btn-success">
                <i class="fas fa-shopping-cart"></i> Nova Venda
            </a>
            <a href="/caixa/abrir" class="btn btn-primary">
                <i class="fas fa-plus"></i> Abrir Novo Caixa
            </a>
        </div>
    </div>

    <%
        const listaCaixas = (typeof caixas !== 'undefined' && Array.isArray(caixas)) ? caixas : [];
        const fmt = n => Number(n||0).toLocaleString('pt-AO',{minimumFractionDigits:2,maximumFractionDigits:2}) + ' Kz';

        const caixaAtivo = listaCaixas.find(c => c.status === 'aberto') || null;
        let ativoSaldo = 0, ativoEntradas = 0, ativoSaidas = 0;
        let ativoCountEntradas = 0, ativoCountSaidas = 0;
        let ativoVendasCount = 0, ativoVendasTotal = 0;

        if (caixaAtivo) {
            const movs = caixaAtivo.MovimentoCaixas || [];
            movs.forEach(m => {
                const v = Number(m.valor || 0);
                if (m.tipo === 'entrada') { ativoEntradas += v; ativoCountEntradas++; }
                else { ativoSaidas += v; ativoCountSaidas++; }
            });
            const vendasArr = Array.isArray(caixaAtivo.Vendas) ? caixaAtivo.Vendas : [];
            ativoVendasCount = vendasArr.length;
            ativoVendasTotal = vendasArr.reduce((s, v) => s + Number(v.valor_total || 0), 0);
            ativoSaldo = Number(caixaAtivo.saldo_final || (Number(caixaAtivo.valor_abertura || 0) + ativoEntradas - ativoSaidas));
        }
    %>

    <!-- ============================================================
         PAINEL: CAIXA EM OPERAÇÃO
         ============================================================ -->
    <% if (caixaAtivo) { %>
    <section class="caixa-ativo-panel">
        <div class="caixa-ativo-header">
            <div class="caixa-ativo-header-left">
                <span class="caixa-ativo-badge"><i class="fas fa-lock-open"></i> Em Operação</span>
                <div class="caixa-ativo-title">
                    Caixa #<%= caixaAtivo.id %>
                    <span>· <%= caixaAtivo.Funcionario?.nome || '—' %></span>
                </div>
            </div>
            <div class="caixa-ativo-actions">
                <a href="/caixa/<%= caixaAtivo.id %>" class="btn btn-outline btn-sm">
                    <i class="fas fa-eye"></i> Ver Detalhes
                </a>
                <button type="button" class="btn btn-warning btn-sm" 
                        onclick="abrirModalFecharCaixa(<%= caixaAtivo.id %>, '<%= (caixaAtivo.Funcionario?.nome || '').replace(/'/g, "\\'") %>', '<%= fmt(ativoSaldo) %>')">
                    <i class="fas fa-lock"></i> Fechar Caixa
                </button>
            </div>
        </div>

        <div class="caixa-ativo-kpis">
            <div class="mini-kpi dark">
                <span class="mini-kpi-label"><i class="fas fa-wallet"></i> Saldo Atual</span>
                <span class="mini-kpi-value"><%= fmt(ativoSaldo) %></span>
                <span class="mini-kpi-sub">Após todos os movimentos</span>
            </div>
            <div class="mini-kpi green">
                <span class="mini-kpi-label"><i class="fas fa-arrow-down"></i> Entradas</span>
                <span class="mini-kpi-value green"><%= fmt(ativoEntradas) %></span>
                <span class="mini-kpi-sub"><%= ativoCountEntradas %> <%= ativoCountEntradas === 1 ? 'movimento' : 'movimentos' %></span>
            </div>
            <div class="mini-kpi orange">
                <span class="mini-kpi-label"><i class="fas fa-arrow-up"></i> Saídas</span>
                <span class="mini-kpi-value <%= ativoSaidas > 0 ? 'red' : '' %>"><%= fmt(ativoSaidas) %></span>
                <span class="mini-kpi-sub"><%= ativoCountSaidas %> <%= ativoCountSaidas === 1 ? 'movimento' : 'movimentos' %></span>
            </div>
            <div class="mini-kpi blue">
                <span class="mini-kpi-label"><i class="fas fa-shopping-cart"></i> Vendas</span>
                <span class="mini-kpi-value"><%= ativoVendasCount %></span>
                <span class="mini-kpi-sub">Total vendido: <%= fmt(ativoVendasTotal) %></span>
            </div>
        </div>
    </section>
    <% } %>

    <!-- ============================================================
         LISTA DE CAIXAS
         ============================================================ -->
    <div class="card">
        <div class="card-head">
            <h3><i class="fas fa-list"></i> Todos os Caixas</h3>
            <span class="text-muted" style="font-size:12px;" id="contadorLabel"><%= listaCaixas.length %> registos</span>
        </div>

        <% if (listaCaixas.length === 0) { %>
            <div class="empty">
                <i class="fas fa-cash-register"></i>
                <h4>Nenhum caixa registado</h4>
                <p>Comece por abrir o primeiro caixa para iniciar as operações.</p>
                <a href="/caixa/abrir" class="btn btn-primary"><i class="fas fa-plus"></i> Abrir Novo Caixa</a>
            </div>
        <% } else { %>

            <div class="filter-bar">
                <div class="filter-group">
                    <i class="fas fa-search"></i>
                    <input type="text" id="filtroTexto" placeholder="Pesquisar por ID ou funcionário...">
                </div>
                <div class="filter-group">
                    <i class="fas fa-filter"></i>
                    <select id="filtroStatus">
                        <option value="">Todos os estados</option>
                        <option value="aberto">Abertos</option>
                        <option value="fechado">Fechados</option>
                    </select>
                </div>
                <div class="filter-group">
                    <i class="fas fa-calendar"></i>
                    <input type="date" id="filtroData">
                </div>
                <div class="spacer"></div>
                <button class="btn btn-outline btn-sm" onclick="limparFiltros()">
                    <i class="fas fa-eraser"></i> Limpar
                </button>
            </div>

            <div class="table-wrap">
                <table id="tabelaCaixas">
                    <thead>
                        <tr>
                            <th style="width:42px;"></th>
                            <th style="width:80px;">ID</th>
                            <th>Funcionário</th>
                            <th style="width:150px;">Abertura</th>
                            <th style="width:150px;">Fecho</th>
                            <th class="text-end" style="width:120px;">Valor Inicial</th>
                            <th class="text-end" style="width:120px;">Saldo Atual</th>
                            <th class="text-center" style="width:105px;">Estado</th>
                            <th class="text-center" style="width:80px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyCaixas">
                        <% listaCaixas.forEach(c => {
                            const iniciais = (c.Funcionario?.nome || '??').split(' ').map(p => p[0]).slice(0,2).join('').toUpperCase();
                            const dataAb = c.data_abertura ? new Date(c.data_abertura).toLocaleString('pt-AO',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
                            const dataFe = c.data_fecho ? new Date(c.data_fecho).toLocaleString('pt-AO',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—';
                            const isAberto = c.status === 'aberto';
                            const nomeFuncSafe = (c.Funcionario?.nome || '').replace(/'/g, "\\'");
                            const saldoFmt = fmt(c.saldo_final || c.valor_abertura);
                            const vendasArr = Array.isArray(c.Vendas) ? c.Vendas : [];
                            const vendasCount = vendasArr.length;
                            const formasPgto = {
                                'dinheiro': 'Dinheiro',
                                'cartao_debito': 'TPA',
                                'Tpa': 'TPA',
                                'cartao_credito': 'Cartão Crédito',
                                'transferencia': 'Transferência'
                            };
                        %>
                        <tr data-id="<%= c.id %>" data-status="<%= c.status %>" data-funcionario="<%= (c.Funcionario?.nome || '').toLowerCase() %>" data-data="<%= c.data_abertura || '' %>">
                            <td class="text-center" style="padding-left:10px;">
                                <button type="button" class="row-expand-btn" onclick="toggleRow(<%= c.id %>)" title="Ver vendas">
                                    <i class="fas fa-chevron-right"></i>
                                </button>
                            </td>
                            <td><span class="id-tag"><i class="fas fa-hashtag"></i><%= c.id %></span></td>
                            <td>
                                <div class="func-cell">
                                    <span class="func-avatar"><%= iniciais %></span>
                                    <span class="func-nome"><%= c.Funcionario?.nome || '—' %></span>
                                </div>
                            </td>
                            <td><%= dataAb %></td>
                            <td><%= dataFe %></td>
                            <td class="text-end"><%= fmt(c.valor_abertura) %></td>
                            <td class="text-end <%= isAberto ? 'text-success' : '' %>">
                                <strong><%= saldoFmt %></strong>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= isAberto ? 'badge-success' : 'badge-danger' %>">
                                    <i class="fas <%= isAberto ? 'fa-lock-open' : 'fa-lock' %>"></i>
                                    <%= isAberto ? 'Aberto' : 'Fechado' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <a href="/caixa/<%= c.id %>" class="btn btn-outline btn-sm btn-icon" title="Ver detalhes">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                        <tr class="expanded-row" data-for="<%= c.id %>" style="display:none;">
                            <td colspan="9">
                                <div class="expanded-content">
                                    <div class="expanded-title">
                                        <i class="fas fa-receipt"></i>
                                        Vendas do Caixa #<%= c.id %>
                                        <span class="count-badge <%= vendasCount === 0 ? 'neutral' : '' %>"><%= vendasCount %></span>
                                    </div>

                                    <% if (vendasCount > 0) { %>
                                        <table class="mini-sales-table">
                                            <thead>
                                                <tr>
                                                    <th style="width:70px;">#</th>
                                                    <th style="width:170px;">Data / Hora</th>
                                                    <th>Forma de Pagamento</th>
                                                    <th class="text-end" style="width:140px;">Valor</th>
                                                    <th style="width:80px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% vendasArr.forEach(v => { %>
                                                    <tr>
                                                        <td><strong>#<%= v.id %></strong></td>
                                                        <td><%= new Date(v.data_venda).toLocaleString('pt-AO') %></td>
                                                        <td>
                                                            <span class="badge badge-info">
                                                                <i class="fas fa-credit-card"></i>
                                                                <%= formasPgto[v.forma_pagamento] || v.forma_pagamento %>
                                                            </span>
                                                        </td>
                                                        <td class="text-end"><strong style="color:#E53935;"><%= fmt(v.valor_total) %></strong></td>
                                                        <td>
                                                            <a href="/vendas/<%= v.id %>" class="btn btn-outline btn-sm btn-icon" title="Ver factura">
                                                                <i class="fas fa-file-invoice"></i>
                                                            </a>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    <% } else { %>
                                        <div class="no-sales">
                                            <i class="fas fa-shopping-cart"></i>
                                            Nenhuma venda registada neste caixa.
                                        </div>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="empty" id="emptyFiltro" style="display:none;">
                <i class="fas fa-search-minus"></i>
                <h4>Nenhum resultado</h4>
                <p>Ajuste os filtros para encontrar o caixa pretendido.</p>
            </div>

            <div class="pag-bar">
                <span id="pagInfo">—</span>
                <div class="pag-controls" id="pagControls"></div>
            </div>
        <% } %>
    </div>
</main>

<!-- MODAL: FECHAR CAIXA -->
<div class="modal-backdrop" id="fecharCaixaModal" onclick="if (event.target === this) fecharModalFechar()">
    <div class="modal" role="dialog" aria-modal="true">
        <div class="modal-header">
            <h3><i class="fas fa-lock"></i> Confirmar Fecho de Caixa</h3>
            <button type="button" class="modal-close" onclick="fecharModalFechar()" aria-label="Fechar">&times;</button>
        </div>

        <form id="fecharCaixaForm" method="POST" action="">
            <div class="modal-body">
                <div class="alert-modal">
                    <i class="fas fa-shield-alt"></i>
                    <div>
                        <strong>Operação sensível.</strong> Para fechar o caixa é necessário confirmar a senha do
                        <b>operador que abriu o caixa</b> ou de um <b>administrador</b>.
                    </div>
                </div>

                <div class="caixa-detalhes-modal">
                    <div>
                        <div class="det-label">Caixa</div>
                        <div class="det-valor" id="modalFecharCaixaId">#—</div>
                    </div>
                    <div>
                        <div class="det-label">Operador</div>
                        <div class="det-valor" id="modalFecharOperador">—</div>
                    </div>
                    <div style="grid-column:1/-1;">
                        <div class="det-label">Saldo Atual</div>
                        <div class="det-valor text-success" id="modalFecharSaldo">—</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="senhaFechar">
                        <i class="fas fa-key"></i> Senha de Confirmação <span class="required">*</span>
                    </label>
                    <input type="password" id="senhaFechar" name="senha" class="form-control"
                           placeholder="Introduza a sua senha" autocomplete="current-password" required>
                    <div style="font-size:11.5px;color:var(--muted);margin-top:6px;">
                        <i class="fas fa-info-circle"></i>
                        A senha será validada pelo sistema antes de efetivar o fecho.
                    </div>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline" onclick="fecharModalFechar()">Cancelar</button>
                <button type="submit" class="btn btn-warning" id="btnConfirmarFecho">
                    <i class="fas fa-lock"></i> Confirmar Fecho
                </button>
            </div>
        </form>
    </div>
</div>

<script>
/* ============================================================
   MODAL: FECHAR CAIXA
   ============================================================ */
function abrirModalFecharCaixa(caixaId, operador, saldo) {
    const modal = document.getElementById('fecharCaixaModal');
    const form = document.getElementById('fecharCaixaForm');
    const inputSenha = document.getElementById('senhaFechar');

    document.getElementById('modalFecharCaixaId').textContent = '#' + caixaId;
    document.getElementById('modalFecharOperador').textContent = operador || '—';
    document.getElementById('modalFecharSaldo').textContent = saldo || '—';

    form.action = '/caixa/fechar/' + caixaId;

    if (inputSenha) {
        inputSenha.value = '';
        setTimeout(() => inputSenha.focus(), 100);
    }

    const btn = document.getElementById('btnConfirmarFecho');
    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-lock"></i> Confirmar Fecho';

    modal.classList.add('open');
}

function fecharModalFechar() {
    document.getElementById('fecharCaixaModal').classList.remove('open');
    const inputSenha = document.getElementById('senhaFechar');
    if (inputSenha) inputSenha.value = '';
}

const formFechar = document.getElementById('fecharCaixaForm');
if (formFechar) {
    formFechar.addEventListener('submit', function (e) {
        const senha = document.getElementById('senhaFechar').value.trim();
        if (!senha) {
            e.preventDefault();
            document.getElementById('senhaFechar').focus();
            return;
        }
        const btn = document.getElementById('btnConfirmarFecho');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A validar...';
    });
}

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') fecharModalFechar();
});

/* ============================================================
   TOGGLE ROW (expandir vendas do caixa)
   ============================================================ */
function toggleRow(id) {
    const main = document.querySelector(`tr[data-id="${id}"]:not(.expanded-row)`);
    const expanded = document.querySelector(`tr.expanded-row[data-for="${id}"]`);
    if (!main || !expanded) return;

    const isOpen = main.classList.toggle('row-open');
    expanded.style.display = isOpen ? '' : 'none';
}

/* ============================================================
   FILTROS + PAGINAÇÃO
   ============================================================ */
const state = { page: 1, perPage: 10, texto: '', status: '', data: '' };

function getLinhas(){
    return [...document.querySelectorAll('#tbodyCaixas tr:not(.expanded-row)')];
}

function aplicarFiltros(){
    let visiveis = 0;
    getLinhas().forEach(tr => {
        const id = tr.dataset.id;
        const func = tr.dataset.funcionario || '';
        const status = tr.dataset.status;
        const dataIso = tr.dataset.data ? tr.dataset.data.slice(0,10) : '';

        const okTexto = !state.texto || id.includes(state.texto) || func.includes(state.texto);
        const okStatus = !state.status || status === state.status;
        const okData = !state.data || dataIso === state.data;

        const match = okTexto && okStatus && okData;
        tr.dataset.visivel = match ? '1' : '0';
        if (match) visiveis++;

        // Sincroniza expanded-row
        const expanded = document.querySelector(`tr.expanded-row[data-for="${id}"]`);
        if (expanded && !match) expanded.style.display = 'none';
    });
    return visiveis;
}

function renderPaginacao(totalVisivel){
    const totalPag = Math.max(1, Math.ceil(totalVisivel / state.perPage));
    if(state.page > totalPag) state.page = totalPag;

    const visiveis = getLinhas().filter(tr => tr.dataset.visivel === '1');
    visiveis.forEach((tr, i) => {
        const dentro = (i >= (state.page-1)*state.perPage) && (i < state.page*state.perPage);
        tr.style.display = dentro ? '' : 'none';

        const expanded = document.querySelector(`tr.expanded-row[data-for="${tr.dataset.id}"]`);
        if (expanded) {
            const isOpen = tr.classList.contains('row-open');
            expanded.style.display = (dentro && isOpen) ? '' : 'none';
        }
    });

    const ini = totalVisivel === 0 ? 0 : (state.page - 1) * state.perPage + 1;
    const fim = Math.min(state.page * state.perPage, totalVisivel);
    const info = document.getElementById('pagInfo');
    if(info) info.textContent = totalVisivel === 0 ? 'Sem resultados' : `Mostrando ${ini}–${fim} de ${totalVisivel}`;

    const c = document.getElementById('pagControls');
    if(!c) return;
    if(totalPag <= 1){ c.innerHTML = ''; return; }

    const btns = [];
    btns.push(`<button class="pag-btn" ${state.page===1?'disabled':''} data-go="${state.page-1}"><i class="fas fa-chevron-left"></i></button>`);
    for(let p=1; p<=totalPag; p++){
        if(p === 1 || p === totalPag || Math.abs(p - state.page) <= 1){
            btns.push(`<button class="pag-btn ${p===state.page?'active':''}" data-go="${p}">${p}</button>`);
        } else if(Math.abs(p - state.page) === 2){
            btns.push(`<span style="padding:0 4px;color:#aaa;">…</span>`);
        }
    }
    btns.push(`<button class="pag-btn" ${state.page===totalPag?'disabled':''} data-go="${state.page+1}"><i class="fas fa-chevron-right"></i></button>`);
    c.innerHTML = btns.join('');

    c.querySelectorAll('[data-go]').forEach(b => {
        b.addEventListener('click', () => {
            if(b.disabled) return;
            state.page = parseInt(b.dataset.go, 10);
            renderPaginacao(aplicarFiltros());
        });
    });
}

function limparFiltros(){
    state.texto = ''; state.status = ''; state.data = ''; state.page = 1;
    document.getElementById('filtroTexto').value = '';
    document.getElementById('filtroStatus').value = '';
    document.getElementById('filtroData').value = '';
    renderLista();
}

function renderLista(){
    const total = aplicarFiltros();
    renderPaginacao(total);
    const empty = document.getElementById('emptyFiltro');
    const tabela = document.getElementById('tabelaCaixas');
    const pag = document.querySelector('.pag-bar');
    if(empty) empty.style.display = total === 0 ? 'block' : 'none';
    if(tabela) tabela.style.display = total === 0 ? 'none' : '';
    if(pag) pag.style.display = total === 0 ? 'none' : 'flex';
    const cont = document.getElementById('contadorLabel');
    if(cont) cont.textContent = total + ' de ' + getLinhas().length + ' registos';
}

document.getElementById('filtroTexto')?.addEventListener('input', e => { state.texto = e.target.value.toLowerCase().trim(); state.page = 1; renderLista(); });
document.getElementById('filtroStatus')?.addEventListener('change', e => { state.status = e.target.value; state.page = 1; renderLista(); });
document.getElementById('filtroData')?.addEventListener('change', e => { state.data = e.target.value; state.page = 1; renderLista(); });

if(getLinhas().length) renderLista();
</script>
</body>
</html>