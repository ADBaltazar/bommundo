<%#
  CONTRATO (server-side):
    utilizador: string
    currentPath: string
    vendas: [{ id, data_venda, valor_total, desconto, status,
               Funcionario:{nome}|null }]
    produtos: [{ id, nome, quantidade_estoque, quantidade_minima }]
    caixas: [{ id, status, valor_abertura, saldo_final, data_abertura,
               Funcionario:{nome}|null, MovimentoCaixas:[{tipo,valor}] }]
%>
<%
  const _op = (
    (typeof utilizador !== 'undefined' && utilizador) ? utilizador :
    ((typeof usuario !== 'undefined' && usuario) ? usuario :
    ((typeof usuário !== 'undefined' && usuário) ? usuário : 'Operador'))
  );
  const _iniciais = _op.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();

  const _vendas   = (typeof vendas   !== 'undefined' && Array.isArray(vendas))   ? vendas   : [];
  const _produtos = (typeof produtos !== 'undefined' && Array.isArray(produtos)) ? produtos : [];
  const _caixas   = (typeof caixas   !== 'undefined' && Array.isArray(caixas))   ? caixas   : [];

  const _fmt = n => Number(n || 0).toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  const _agora = new Date();
  const _diaLocal = d => `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const _hojeStr = _diaLocal(_agora);
  const _iniMes = new Date(_agora.getFullYear(), _agora.getMonth(), 1);
  const _iniMesAnt = new Date(_agora.getFullYear(), _agora.getMonth() - 1, 1);
  const _fimMesAnt = new Date(_agora.getFullYear(), _agora.getMonth(), 0, 23, 59, 59);

  /* Normalizar todas as vendas (para a tabela) */
  const _vTodas = _vendas.map(v => {
    try {
      const d = new Date(v.data_venda);
      if (isNaN(d.getTime())) return null;
      return {
        ...v, _d: d, _diaStr: _diaLocal(d),
        _valor: Number(v.valor_total || 0),
        _desc: Number(v.desconto || 0),
        _liq: Math.max(0, Number(v.valor_total || 0) - Number(v.desconto || 0))
      };
    } catch (e) { return null; }
  }).filter(Boolean);

  /* Vendas efectivas (excluir canceladas) para agregações */
  const _v = _vTodas.filter(v => v.status !== 'cancelada');

  const _vHoje   = _v.filter(v => v._diaStr === _hojeStr);
  const _vMes    = _v.filter(v => v._d >= _iniMes);
  const _vMesAnt = _v.filter(v => v._d >= _iniMesAnt && v._d <= _fimMesAnt);

  const _totalHoje  = _vHoje.reduce((s, v) => s + v._liq, 0);
  const _countHoje  = _vHoje.length;
  const _ticketHoje = _countHoje ? _totalHoje / _countHoje : 0;

  const _totalMes   = _vMes.reduce((s, v) => s + v._liq, 0);
  const _countMes   = _vMes.length;
  const _totalMesAnt = _vMesAnt.reduce((s, v) => s + v._liq, 0);
  const _variacaoMes = _totalMesAnt > 0
    ? ((_totalMes - _totalMesAnt) / _totalMesAnt) * 100
    : null;

  /* Stock */
  const _totalProdutos = _produtos.length;
  const _totalStock = _produtos.reduce((s, p) => s + Number(p.quantidade_estoque || 0), 0);
  const _semStockLista = _produtos.filter(p => Number(p.quantidade_estoque || 0) <= 0);
  const _stockBaixoLista = _produtos.filter(p => {
    const q = Number(p.quantidade_estoque || 0);
    const min = Number(p.quantidade_minima || 5);
    return q > 0 && q <= min;
  });
  const _totalCritico = _semStockLista.length + _stockBaixoLista.length;

  /* Caixa */
  const _caixaAberto = _caixas.find(c => c.status === 'aberto') || null;
  let _saldoCaixa = 0;
  let _vendasCaixaCount = 0;
  if (_caixaAberto) {
    if (_caixaAberto.saldo_final != null) _saldoCaixa = Number(_caixaAberto.saldo_final);
    else {
      const movs = Array.isArray(_caixaAberto.MovimentoCaixas) ? _caixaAberto.MovimentoCaixas : [];
      let ent = 0, sai = 0;
      movs.forEach(m => {
        const val = Number(m.valor || 0);
        if (m.tipo === 'entrada') ent += val; else sai += val;
      });
      _saldoCaixa = Number(_caixaAberto.valor_abertura || 0) + ent - sai;
    }
    _vendasCaixaCount = _v.filter(v => v.caixa_id === _caixaAberto.id).length;
  }

  /* Últimas 5 vendas (inclui canceladas, com estado claro) */
  const _ultimasVendas = [..._vTodas].sort((a, b) => b._d - a._d).slice(0, 5);

  /* Data/hora relativa */
  const _dataHoraRelativa = iso => {
    try {
      const d = new Date(iso);
      const hojeIni = new Date(); hojeIni.setHours(0,0,0,0);
      const ontemIni = new Date(hojeIni); ontemIni.setDate(ontemIni.getDate() - 1);
      const hora = d.toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit' });
      if (d >= hojeIni) return 'Hoje, ' + hora;
      if (d >= ontemIni) return 'Ontem, ' + hora;
      return d.toLocaleDateString('pt-AO', { day: '2-digit', month: '2-digit' }) + ' · ' + hora;
    } catch (e) { return '—'; }
  };

  const _temDados = _vendas.length + _produtos.length + _caixas.length > 0;
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Painel principal — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --primary: #E53935; --primary-dark: #c62828; --primary-soft: #FFF5F5;
  --dark: #2E2E2E; --dark-2: #3a3a3a;
  --success: #4CAF50; --success-dark: #2E7D32; --success-soft: #E8F5E9;
  --warning: #FF9800; --warning-dark: #E65100; --warning-soft: #FFF8E1;
  --info: #2196F3; --info-dark: #1565C0; --info-soft: #E3F2FD;

  --bg: #F5F6F8; --surface: #FFFFFF; --surface-subtle: #FAFBFC;
  --border: #e6e8ec; --border-strong: #d0d4dc;
  --fg: #1f2328; --fg-soft: #4a5058; --fg-muted: #8b939f; --fg-placeholder: #b0b7c0;
  --neutral-soft: #F2F4F7;

  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px; --s-7: 48px;

  --sidebar-w: 220px; --radius: 4px;
  color-scheme: light;
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px; line-height: 1.5;
  color: var(--fg); background: var(--bg);
  display: flex; min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
::selection { background: var(--fg); color: var(--surface); }
:focus { outline: none; }
:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }

/* Skip link */
.skip-link {
  position: absolute; left: -9999px; top: 0;
  background: var(--fg); color: var(--surface);
  padding: var(--s-2) var(--s-3); z-index: 9999;
  border-radius: 0 0 var(--radius) 0;
  font-weight: 500;
}
.skip-link:focus { left: 0; }

.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* Botões */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: var(--s-2); padding: var(--s-2) var(--s-3);
  border: 1px solid transparent; border-radius: var(--radius);
  font: inherit; font-size: 13px; font-weight: 500; line-height: 1.4;
  cursor: pointer; white-space: nowrap;
  transition: background-color .15s, border-color .15s, color .15s;
}
.btn i { font-size: 11px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-dark); }
.btn-primary i { color: #fff; }
.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border-strong); }
.btn-outline:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); }
.btn-outline:hover:not(:disabled) i { color: var(--primary); }
.btn-outline i { color: var(--fg-soft); }
.btn-sm { padding: var(--s-1) var(--s-2); font-size: 12px; }
.btn-block { display: flex; width: 100%; }
.btn-block + .btn-block { margin-top: var(--s-2); }

kbd {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 1px 5px; border: 1px solid var(--border); border-bottom-width: 2px;
  border-radius: 3px; background: var(--surface);
  font-family: ui-monospace, Consolas, monospace;
  font-size: 10px; font-weight: 500; color: var(--fg-muted); line-height: 1;
  min-width: 16px; height: 16px;
}

/* Sidebar */
.sidebar {
  width: var(--sidebar-w); background: var(--dark); color: #fff;
  padding: var(--s-5) 0; height: 100vh; position: fixed; inset: 0 auto 0 0;
  overflow-y: auto; z-index: 100; display: flex; flex-direction: column;
}
.logo {
  display: flex; align-items: center; gap: var(--s-2);
  font-size: 15px; font-weight: 700; color: var(--primary); letter-spacing: .5px;
  padding: 0 var(--s-5) var(--s-5); border-bottom: 1px solid #2a2a2a; margin-bottom: var(--s-4);
}
.logo i { color: var(--primary); font-size: 15px; }
.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex; align-items: center; gap: var(--s-3);
  padding: var(--s-3) var(--s-5); font-size: 13px; font-weight: 500; color: #d5d9df;
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover { background: var(--dark-2); color: var(--primary); }
.nav-menu a:hover i { color: var(--primary); }
.nav-menu a.active { background: var(--dark-2); color: var(--primary); border-left-color: var(--primary); }
.nav-menu a.active i { color: var(--primary); }
.nav-menu i { width: 16px; text-align: center; font-size: 12px; color: #666; transition: color .2s ease; }
.user-info {
  padding: var(--s-4) var(--s-5) 0; border-top: 1px solid #2a2a2a;
  margin-top: var(--s-4); display: flex; align-items: center; gap: var(--s-3);
}
.user-avatar {
  width: 32px; height: 32px; border-radius: 50%; background: var(--primary);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 600; font-size: 12px; flex-shrink: 0;
}
.user-details { min-width: 0; flex: 1; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

/* Main */
.main-content {
  flex: 1; margin-left: var(--sidebar-w); padding: var(--s-5);
  min-width: 0; display: flex; flex-direction: column;
}
.page-container {
  width: 100%; max-width: 1240px; margin: 0 auto;
  display: flex; flex-direction: column; gap: var(--s-4);
}

.print-header { display: none; }

/* Topbar */
.topbar {
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--s-4); flex-wrap: wrap; padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.topbar-left h1 {
  font-size: 20px; font-weight: 600; letter-spacing: -.005em; line-height: 1.2;
}
.topbar-left .page-subtitle {
  font-size: 12px; color: var(--fg-muted); margin-top: 2px;
  display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap;
  font-variant-numeric: tabular-nums;
}
.topbar-left .page-subtitle .sep { color: var(--border); }
.topbar-left .page-subtitle .hint { display: inline-flex; align-items: center; gap: 4px; }
.topbar-right { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }

/* Alert banner */
.alert-banner {
  display: flex; align-items: center; gap: var(--s-3);
  padding: var(--s-3) var(--s-4);
  background: var(--warning-soft); border: 1px solid rgba(255, 152, 0, 0.35);
  border-left: 3px solid var(--warning); border-radius: var(--radius);
  font-size: 13px; color: var(--warning-dark);
}
.alert-banner i { font-size: 16px; flex-shrink: 0; }
.alert-banner strong { font-weight: 600; }
.alert-banner a {
  margin-left: auto; font-size: 12px; font-weight: 500;
  color: var(--warning-dark); text-decoration: underline;
}
.alert-banner a:hover { color: var(--fg); }
.alert-banner.is-empty {
  background: var(--surface); border-color: var(--border);
  border-left-color: var(--fg-muted); color: var(--fg-muted);
}
.alert-banner.is-empty i { color: var(--fg-muted); }

/* Metrics */
.metrics-bar {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
}
.metric {
  padding: var(--s-4);
  display: flex; flex-direction: column; gap: 2px;
  border-right: 1px solid var(--border); min-width: 0;
}
.metric:last-child { border-right: none; }
.metric-label {
  font-size: 11px; color: var(--fg-muted); font-weight: 500;
  text-transform: uppercase; letter-spacing: .5px;
  display: flex; align-items: center; gap: var(--s-2); line-height: 1.3;
}
.metric-dot {
  width: 6px; height: 6px; border-radius: 50%;
  flex-shrink: 0; background: var(--fg-muted);
}
.metric-value {
  font-size: 22px; font-weight: 600; color: var(--fg);
  font-variant-numeric: tabular-nums; line-height: 1.15;
  letter-spacing: -.005em; word-break: break-word; margin-top: 2px;
}
.metric-sub {
  font-size: 12px; color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
  display: flex; align-items: center; gap: var(--s-1); flex-wrap: wrap;
}
.metric-sub .variacao {
  display: inline-flex; align-items: center; gap: 2px;
  padding: 0 4px;
  border-radius: 2px;
  font-weight: 600;
}
.metric-sub .variacao.is-up { background: var(--success-soft); color: var(--success-dark); }
.metric-sub .variacao.is-down { background: #FFEBEE; color: var(--primary-dark); }
.metric-sub .variacao i { font-size: 8px; }

.metric.is-success .metric-dot { background: var(--success); }
.metric.is-success .metric-value { color: var(--success-dark); }
.metric.is-info .metric-dot { background: var(--info); }
.metric.is-info .metric-value { color: var(--info-dark); }
.metric.is-danger.is-active .metric-dot { background: var(--primary); }
.metric.is-danger.is-active .metric-value { color: var(--primary-dark); }

/* Grid */
.grid-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 340px;
  gap: var(--s-4); align-items: start;
}

/* Card */
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); overflow: hidden;
}
.card-head {
  padding: var(--s-3) var(--s-4);
  border-bottom: 1px solid var(--border);
  background: var(--surface-subtle);
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--s-3); flex-wrap: wrap;
}
.card-head h3 {
  font-size: 14px; font-weight: 600;
  display: flex; align-items: center; gap: var(--s-2);
}
.card-head .card-icon {
  display: inline-flex; width: 24px; height: 24px;
  border-radius: 50%; background: var(--primary-soft); color: var(--primary);
  align-items: center; justify-content: center; font-size: 10px;
  flex-shrink: 0;
}
.card-head .card-actions { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
.card-head .card-actions a {
  font-size: 12px; font-weight: 500; color: var(--primary);
}
.card-head .card-actions a:hover { color: var(--primary-dark); text-decoration: underline; }
.card-body { padding: var(--s-4); }

/* Tabela */
.table-wrap { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; background: var(--surface); }
.data-table thead th {
  text-align: left; padding: var(--s-2) var(--s-4);
  font-size: 11px; font-weight: 500; color: var(--fg-muted);
  text-transform: uppercase; letter-spacing: .5px;
  border-bottom: 1px solid var(--border); background: var(--surface-subtle);
  white-space: nowrap;
}
.data-table tbody td {
  padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border);
  font-size: 13px; vertical-align: middle;
}
.data-table tbody tr:last-child td { border-bottom: none; }
.data-table tbody tr:hover td { background: var(--surface-subtle); }
.data-table td.text-end, .data-table th.text-end { text-align: right; font-variant-numeric: tabular-nums; }
.data-table td.text-center, .data-table th.text-center { text-align: center; }
.text-end { text-align: right; }
.text-center { text-align: center; }

.sale-id {
  font-family: ui-monospace, Consolas, monospace;
  font-size: 12px; font-weight: 500; color: var(--fg-soft);
}
.sale-hora {
  font-size: 12px; color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
}
.sale-func { font-size: 13px; color: var(--fg); }
.sale-valor {
  font-size: 13px; font-weight: 600; color: var(--fg);
  font-variant-numeric: tabular-nums;
}
.sale-valor.is-cancelled {
  color: var(--fg-muted);
  text-decoration: line-through;
}

.status-indicator {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 11px; font-weight: 500; color: var(--fg-soft);
}
.status-indicator .dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--fg-muted); flex-shrink: 0;
}
.status-indicator.status-ok .dot { background: var(--success); }
.status-indicator.status-ok { color: var(--success-dark); }
.status-indicator.status-low .dot { background: var(--warning); }
.status-indicator.status-low { color: var(--warning-dark); }
.status-indicator.status-cancelada .dot { background: var(--primary); }
.status-indicator.status-cancelada { color: var(--primary-dark); }

/* Empty */
.empty {
  padding: var(--s-6) var(--s-4); text-align: center;
  color: var(--fg-muted); font-size: 13px;
  display: flex; flex-direction: column; align-items: center; gap: var(--s-3);
}
.empty-icon {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--info-soft); color: var(--info);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
}

/* Caixa */
.caixa-status { display: flex; flex-direction: column; gap: var(--s-3); }
.caixa-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--s-2);
}
.caixa-indicator {
  display: inline-flex; align-items: center; gap: var(--s-2);
  font-size: 12px; font-weight: 600;
}
.caixa-indicator .dot {
  width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
}
.caixa-indicator.is-open { color: var(--success-dark); }
.caixa-indicator.is-open .dot { background: var(--success); }
.caixa-indicator.is-closed { color: var(--fg-muted); }
.caixa-indicator.is-closed .dot { background: var(--fg-muted); }
.caixa-numero {
  font-family: ui-monospace, Consolas, monospace;
  font-size: 13px; font-weight: 500; color: var(--fg-soft);
}
.caixa-saldo {
  padding: var(--s-4); background: var(--surface-subtle);
  border-radius: var(--radius); text-align: center;
}
.caixa-saldo .lbl {
  font-size: 11px; color: var(--fg-muted); text-transform: uppercase;
  letter-spacing: .5px; font-weight: 500;
}
.caixa-saldo .val {
  font-size: 24px; font-weight: 700; color: var(--primary-dark);
  font-variant-numeric: tabular-nums; margin-top: var(--s-1); line-height: 1.2;
}
.caixa-meta {
  display: flex; justify-content: space-between; gap: var(--s-3);
  font-size: 12px; color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
  padding-top: var(--s-2);
  border-top: 1px solid var(--border);
}
.caixa-meta strong { color: var(--fg); font-weight: 500; }
.caixa-actions { display: flex; gap: var(--s-2); flex-wrap: wrap; }
.caixa-actions .btn { flex: 1; justify-content: center; }

/* Responsivo */
@media (max-width: 1000px) {
  .grid-layout { grid-template-columns: 1fr; }
  .grid-layout .side-panel { order: 1; }
  .grid-layout .main-col { order: 2; }
}
@media (max-width: 900px) {
  :root { --sidebar-w: 60px; }
  .sidebar .logo span, .sidebar .nav-menu a span, .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { padding: var(--s-3); }
}
@media (max-width: 720px) {
  .metrics-bar {
    grid-template-columns: 1fr 1fr;
  }
  .metric {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
  .metric:nth-child(odd) { border-right: 1px solid var(--border); }
  .metric:last-child { border-bottom: none; }
  .metric:nth-last-child(2):nth-child(odd) { border-bottom: none; }
  .metric-value { font-size: 18px; }
}
@media (max-width: 600px) {
  .metrics-bar { grid-template-columns: 1fr; }
  .metric { border-right: none !important; border-bottom: 1px solid var(--border); }
  .metric:last-child { border-bottom: none; }
  .topbar { flex-direction: column; align-items: flex-start; }
  .topbar-right { width: 100%; }
  .topbar-right .btn { flex: 1; justify-content: center; }
  .page-subtitle .hint { display: none; }
  .alert-banner { flex-wrap: wrap; }
  .alert-banner a { margin-left: 0; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Impressão */
@media print {
  @page { size: A4 portrait; margin: 12mm; }
  html, body {
    background: #fff !important; display: block !important; font-size: 10pt;
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
  .sidebar, .topbar-right, .side-panel, kbd,
  .btn, .card-head .card-actions, .page-subtitle .hint { display: none !important; }
  .main-content { margin: 0 !important; padding: 0 !important; }
  .page-container { max-width: 100%; gap: 12pt; }
  .grid-layout { display: block; }
  .main-col { margin-bottom: 12pt; }
  .print-header {
    display: flex !important;
    justify-content: space-between; align-items: flex-start;
    gap: 20pt; padding-bottom: 8pt; margin-bottom: 12pt;
    border-bottom: 2pt solid var(--dark); flex-wrap: wrap;
  }
  .print-brand-name { font-size: 16pt; font-weight: 700; letter-spacing: .5pt; }
  .print-brand-sub { font-size: 9pt; color: #555; line-height: 1.4; }
  .print-meta { text-align: right; font-size: 9pt; line-height: 1.5; color: #333; }
  .print-meta strong { color: #000; }
  .topbar { border-bottom: 1pt solid #999; padding-bottom: 6pt; }
  .topbar-left h1 { font-size: 14pt; }
  .metrics-bar { page-break-inside: avoid; }
  .metric-value { font-size: 13pt; }
  .metric-label { font-size: 8pt; }
  .card { box-shadow: none !important; break-inside: avoid; }
  .card-head { background: #f5f5f5 !important; }
  .data-table thead th { background: var(--dark) !important; color: #fff !important; }
  .alert-banner { border: 1pt solid #999 !important; }
}
</style>
</head>
<body>

<a href="#main" class="skip-link">Saltar para o conteúdo</a>

<aside class="sidebar no-print" aria-label="Navegação principal">
    <div class="logo"><i class="fas fa-globe-americas" aria-hidden="true"></i><span>BOM MUNDO</span></div>
    <nav aria-label="Menu principal">
        <ul class="nav-menu">
            <li><a href="/dashboard" class="<%= currentPath === '/dashboard' || currentPath === '/' ? 'active' : '' %>" <%= currentPath === '/dashboard' || currentPath === '/' ? 'aria-current="page"' : '' %>><i class="fas fa-tachometer-alt" aria-hidden="true"></i><span>Painel</span></a></li>
            <li><a href="/caixa" class="<%= currentPath.startsWith('/caixa') ? 'active' : '' %>" <%= currentPath.startsWith('/caixa') ? 'aria-current="page"' : '' %>><i class="fas fa-cash-register" aria-hidden="true"></i><span>Caixas</span></a></li>
            <li><a href="/vendas" class="<%= currentPath.startsWith('/vendas') ? 'active' : '' %>" <%= currentPath.startsWith('/vendas') ? 'aria-current="page"' : '' %>><i class="fas fa-shopping-cart" aria-hidden="true"></i><span>Vendas</span></a></li>
            <li><a href="/produtos" class="<%= currentPath.startsWith('/produtos') ? 'active' : '' %>" <%= currentPath.startsWith('/produtos') ? 'aria-current="page"' : '' %>><i class="fas fa-boxes" aria-hidden="true"></i><span>Estoque</span></a></li>
            <li><a href="#"><i class="fas fa-users" aria-hidden="true"></i><span>Clientes</span></a></li>
            <li><a href="#"><i class="fas fa-chart-bar" aria-hidden="true"></i><span>Relatórios</span></a></li>
            <li><a href="#"><i class="fas fa-cog" aria-hidden="true"></i><span>Config.</span></a></li>
        </ul>
    </nav>
    <div class="user-info">
        <div class="user-avatar" aria-hidden="true"><%= _iniciais %></div>
        <div class="user-details">
            <div class="user-name"><%= _op %></div>
            <div class="user-role">Gerente</div>
        </div>
    </div>
</aside>

<main class="main-content" id="main" role="main">
    <div class="page-container">

        <div class="print-header">
            <div>
                <div class="print-brand-name">BOM MUNDO</div>
                <div class="print-brand-sub">Comércio Geral e Prestação de Serviços</div>
                <div class="print-brand-sub">NIF: 5000000000 · Luanda, Angola</div>
            </div>
            <div class="print-meta">
                <div><strong>Relatório:</strong> Painel principal</div>
                <div><strong>Emitido:</strong> <span id="printEmitido">—</span></div>
                <div><strong>Operador:</strong> <%= _op %></div>
            </div>
        </div>

        <!-- TOPBAR -->
        <div class="topbar">
            <div class="topbar-left">
                <h1>Painel principal</h1>
                <div class="page-subtitle">
                    <time datetime="<%= _hojeStr %>"><%= _agora.toLocaleDateString('pt-AO', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' }) %></time>
                    <span class="sep" aria-hidden="true">·</span>
                    <span class="hint"><kbd>Ctrl</kbd>+<kbd>P</kbd> imprimir</span>
                </div>
            </div>
            <div class="topbar-right">
                <% if (_caixaAberto) { %>
                    <a href="/vendas/nova" class="btn btn-primary">
                        <i class="fas fa-plus" aria-hidden="true"></i> Nova venda
                    </a>
                <% } else { %>
                    <a href="/caixa/abrir" class="btn btn-primary">
                        <i class="fas fa-lock-open" aria-hidden="true"></i> Abrir caixa
                    </a>
                <% } %>
            </div>
        </div>

        <!-- ALERTA (só se crítico) -->
        <% if (!_temDados) { %>
        <div class="alert-banner is-empty" role="status">
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            <div><strong>Sem dados carregados.</strong> Verifique a rota <code>/dashboard</code>.</div>
        </div>
        <% } else if (_totalCritico > 0) { %>
        <div class="alert-banner" role="alert">
            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            <div>
                <strong><%= _totalCritico %></strong>
                <%= _totalCritico === 1 ? 'produto precisa' : 'produtos precisam' %> de reposição
                (<%= _semStockLista.length %> sem stock, <%= _stockBaixoLista.length %> abaixo do mínimo).
            </div>
            <a href="/produtos">Ver estoque</a>
        </div>
        <% } %>

        <!-- MÉTRICAS ESSENCIAIS -->
        <section class="metrics-bar" aria-label="Indicadores do negócio" aria-live="polite">

            <div class="metric is-success">
                <div class="metric-label"><span class="metric-dot" aria-hidden="true"></span>Vendas hoje</div>
                <div class="metric-value"><%= _fmt(_totalHoje) %> Kz</div>
                <div class="metric-sub"><%= _countHoje %> <%= _countHoje === 1 ? 'venda' : 'vendas' %></div>
            </div>

            <div class="metric is-success">
                <div class="metric-label"><span class="metric-dot" aria-hidden="true"></span>Vendas mês</div>
                <div class="metric-value"><%= _fmt(_totalMes) %> Kz</div>
                <div class="metric-sub">
                    <% if (_variacaoMes === null) { %>
                        <%= _countMes %> vendas
                    <% } else if (_variacaoMes > 0) { %>
                        <span class="variacao is-up"><i class="fas fa-arrow-up" aria-hidden="true"></i> <%= _variacaoMes.toFixed(1) %>%</span>
                        <span>vs mês anterior</span>
                    <% } else if (_variacaoMes < 0) { %>
                        <span class="variacao is-down"><i class="fas fa-arrow-down" aria-hidden="true"></i> <%= Math.abs(_variacaoMes).toFixed(1) %>%</span>
                        <span>vs mês anterior</span>
                    <% } else { %>
                        <span>sem variação</span>
                    <% } %>
                </div>
            </div>

            <div class="metric is-info">
                <div class="metric-label"><span class="metric-dot" aria-hidden="true"></span>Ticket médio</div>
                <div class="metric-value"><%= _fmt(_ticketHoje) %> Kz</div>
                <div class="metric-sub">por venda hoje</div>
            </div>

            <div class="metric is-info">
                <div class="metric-label"><span class="metric-dot" aria-hidden="true"></span>Produtos</div>
                <div class="metric-value"><%= _totalProdutos %></div>
                <div class="metric-sub"><%= _totalStock %> unidades em stock</div>
            </div>

            <div class="metric <%= _totalCritico > 0 ? 'is-danger is-active' : '' %>">
                <div class="metric-label"><span class="metric-dot" aria-hidden="true"></span>Stock crítico</div>
                <div class="metric-value"><%= _totalCritico %></div>
                <div class="metric-sub"><%= _totalCritico > 0 ? 'requer atenção' : 'tudo disponível' %></div>
            </div>

        </section>

        <!-- GRID -->
        <div class="grid-layout">

            <div class="main-col">
                <section class="card" aria-labelledby="ultimas-title">
                    <div class="card-head">
                        <h3 id="ultimas-title">
                            <span class="card-icon" aria-hidden="true"><i class="fas fa-receipt"></i></span>
                            Últimas vendas
                        </h3>
                        <div class="card-actions">
                            <a href="/vendas">Ver todas</a>
                        </div>
                    </div>

                    <% if (_ultimasVendas.length === 0) { %>
                        <div class="empty">
                            <div class="empty-icon" aria-hidden="true"><i class="fas fa-receipt"></i></div>
                            <span>Sem vendas registadas.</span>
                            <% if (_caixaAberto) { %>
                                <a href="/vendas/nova" class="btn btn-primary btn-sm" style="margin-top: var(--s-2);">
                                    <i class="fas fa-plus" aria-hidden="true"></i> Registar primeira venda
                                </a>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="table-wrap">
                            <table class="data-table">
                                <caption class="sr-only">Últimas 5 vendas registadas</caption>
                                <thead>
                                    <tr>
                                        <th scope="col" style="width: 70px;">#</th>
                                        <th scope="col" style="width: 140px;">Quando</th>
                                        <th scope="col">Funcionário</th>
                                        <th scope="col" class="text-end" style="width: 140px;">Valor</th>
                                        <th scope="col" class="text-center" style="width: 110px;">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% _ultimasVendas.forEach(v => {
                                        const st = (v.status || 'pendente').toLowerCase();
                                        const stLabel = st === 'concluida' ? 'Concluída' : (st === 'cancelada' ? 'Cancelada' : 'Pendente');
                                        const stClass = st === 'concluida' ? 'status-ok' : (st === 'cancelada' ? 'status-cancelada' : 'status-low');
                                        const isCancelled = st === 'cancelada';
                                    %>
                                    <tr>
                                        <td><span class="sale-id">#<%= v.id %></span></td>
                                        <td><span class="sale-hora"><%= _dataHoraRelativa(v.data_venda) %></span></td>
                                        <td><span class="sale-func"><%= (v.Funcionario && v.Funcionario.nome) ? v.Funcionario.nome : '—' %></span></td>
                                        <td class="text-end"><span class="sale-valor <%= isCancelled ? 'is-cancelled' : '' %>"><%= _fmt(v._liq) %> Kz</span></td>
                                        <td class="text-center">
                                            <span class="status-indicator <%= stClass %>">
                                                <span class="dot" aria-hidden="true"></span><%= stLabel %>
                                            </span>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </section>
            </div>

            <aside class="side-panel no-print" aria-label="Estado operacional">
                <section class="card" aria-labelledby="caixa-title">
                    <div class="card-head">
                        <h3 id="caixa-title">
                            <span class="card-icon" aria-hidden="true"><i class="fas fa-cash-register"></i></span>
                            Caixa
                        </h3>
                    </div>
                    <div class="card-body">
                        <% if (_caixaAberto) { %>
                            <div class="caixa-status">
                                <div class="caixa-head">
                                    <span class="caixa-indicator is-open">
                                        <span class="dot" aria-hidden="true"></span> Em operação
                                    </span>
                                    <span class="caixa-numero">#<%= _caixaAberto.id %></span>
                                </div>

                                <div class="caixa-saldo">
                                    <div class="lbl">Saldo actual</div>
                                    <div class="val"><%= _fmt(_saldoCaixa) %> Kz</div>
                                </div>

                                <div class="caixa-meta">
                                    <span>Operador: <strong><%= (_caixaAberto.Funcionario && _caixaAberto.Funcionario.nome) || '—' %></strong></span>
                                    <span><%= _vendasCaixaCount %> <%= _vendasCaixaCount === 1 ? 'venda' : 'vendas' %></span>
                                </div>

                                <div class="caixa-actions">
                                    <a href="/caixa/<%= _caixaAberto.id %>" class="btn btn-outline btn-sm">
                                        <i class="fas fa-eye" aria-hidden="true"></i> Ver
                                    </a>
                                    <a href="/caixa/fechar/<%= _caixaAberto.id %>" class="btn btn-outline btn-sm"
                                       onclick="return confirm('Fechar o caixa #<%= _caixaAberto.id %>?');">
                                        <i class="fas fa-lock" aria-hidden="true"></i> Fechar
                                    </a>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="caixa-status">
                                <div class="caixa-head">
                                    <span class="caixa-indicator is-closed">
                                        <span class="dot" aria-hidden="true"></span> Sem caixa aberto
                                    </span>
                                </div>
                                <p style="font-size: 12px; color: var(--fg-muted); line-height: 1.5;">
                                    Abra um caixa para começar a registar vendas.
                                </p>
                                <a href="/caixa/abrir" class="btn btn-primary btn-block">
                                    <i class="fas fa-lock-open" aria-hidden="true"></i> Abrir caixa
                                </a>
                            </div>
                        <% } %>
                    </div>
                </section>
            </aside>

        </div>
    </div>
</main>

<script>
window.addEventListener('beforeprint', () => {
  const el = document.getElementById('printEmitido');
  if (el) el.textContent = new Date().toLocaleString('pt-AO');
});
</script>

</body>
</html>