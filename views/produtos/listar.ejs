<%
  const operadorNome = (
    (typeof utilizador !== 'undefined' && utilizador) ? utilizador :
    ((typeof usuario !== 'undefined' && usuario) ? usuario :
    ((typeof usuário !== 'undefined' && usuário) ? usuário : 'Operador'))
  );
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gestão de Produtos - Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
    --primary:#E53935;--primary-dark:#c62828;--primary-soft:#FFF5F5;--primary-line:#FFCDD2;
    --dark:#2E2E2E;--dark-2:#3a3a3a;--dark-soft:#F2F4F7;
    --success:#4CAF50;--success-dark:#2E7D32;--success-soft:#E8F5E9;--success-line:#C8E6C9;
    --warning:#FF9800;--warning-dark:#E65100;--warning-soft:#FFF8E1;
    --info:#2196F3;--info-dark:#1565C0;--info-soft:#E3F2FD;
    --bg:#F5F6F8;--card:#fff;--border:#e6e8ec;--border-strong:#d0d4dc;
    --text:#1f2328;--text-soft:#4a5058;--muted:#8b939f;--muted-2:#b0b7c0;
    --shadow-sm:0 1px 3px rgba(0,0,0,.05);
    --shadow:0 4px 12px rgba(0,0,0,.06);
    --shadow-lg:0 12px 32px rgba(0,0,0,.12);
    --radius:10px;--radius-sm:6px;
}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}
body{background:var(--bg);color:var(--text);line-height:1.5;display:flex;min-height:100vh;font-size:14px}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 16px;border-radius:var(--radius-sm);font-weight:600;font-size:13.5px;border:1px solid transparent;transition:all .18s;white-space:nowrap}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover:not(:disabled){background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 10px rgba(229,57,53,.25)}
.btn-success{background:var(--success);color:#fff}
.btn-success:hover:not(:disabled){background:var(--success-dark)}
.btn-dark{background:var(--dark);color:#fff}
.btn-dark:hover:not(:disabled){background:var(--dark-2)}
.btn-outline{background:#fff;color:var(--text);border-color:var(--border-strong)}
.btn-outline:hover:not(:disabled){border-color:var(--primary);color:var(--primary);background:var(--primary-soft)}
.btn-danger{background:var(--primary);color:#fff}
.btn-danger:hover:not(:disabled){background:var(--primary-dark)}
.btn-ghost{background:transparent;color:var(--text-soft)}
.btn-ghost:hover:not(:disabled){background:var(--dark-soft);color:var(--text)}
.btn-sm{padding:6px 11px;font-size:12px}
.btn-block{display:flex;width:100%}
.btn-icon{width:32px;height:32px;padding:0;border-radius:6px}

.sidebar{width:220px;background:var(--dark);color:#fff;padding:18px 0;height:100vh;position:fixed;top:0;left:0;overflow-y:auto;z-index:100}
.logo{font-size:20px;font-weight:800;color:var(--primary);display:flex;align-items:center;gap:9px;padding:0 18px 16px;border-bottom:1px solid #444;margin-bottom:12px;letter-spacing:.5px}
.logo i{font-size:22px}
.nav-menu{list-style:none}
.nav-menu li{margin-bottom:2px}
.nav-menu a{color:#d5d9df;font-weight:500;padding:10px 18px;display:flex;align-items:center;gap:11px;border-left:3px solid transparent;transition:all .18s;font-size:13.5px}
.nav-menu a:hover{background:var(--dark-2);color:#fff}
.nav-menu a.active{background:var(--dark-2);color:#fff;border-left-color:var(--primary);font-weight:600}
.nav-menu a.active i{color:var(--primary)}
.nav-menu i{width:18px;text-align:center;font-size:14px}
.user-info{padding:14px 18px;border-top:1px solid #444;margin-top:16px;display:flex;align-items:center;gap:10px}
.user-avatar{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:12px;flex-shrink:0}
.user-details{min-width:0;flex:1}
.user-name{font-weight:600;font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-role{font-size:11px;color:#9aa1ab}

.main-content{flex:1;margin-left:220px;padding:18px 22px;min-width:0;display:flex;flex-direction:column;gap:14px}

.topbar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.topbar-left h1{font-size:22px;font-weight:700;letter-spacing:-.3px}
.topbar-left .page-subtitle{font-size:12.5px;color:var(--muted);margin-top:2px}
.topbar-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}

.kpi-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.kpi{background:var(--card);border-radius:var(--radius);padding:16px 18px;border:1px solid var(--border);box-shadow:var(--shadow-sm);position:relative;overflow:hidden;transition:all .2s}
.kpi:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.kpi::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--primary)}
.kpi.green::before{background:var(--success)}
.kpi.orange::before{background:var(--warning)}
.kpi.blue::before{background:var(--info)}
.kpi.dark::before{background:var(--dark)}
.kpi-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;gap:10px}
.kpi-label{font-size:11px;text-transform:uppercase;letter-spacing:.9px;color:var(--muted);font-weight:700;line-height:1.3}
.kpi-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:15px;background:var(--dark-soft);color:var(--text-soft);flex-shrink:0}
.kpi.green .kpi-icon{background:var(--success-soft);color:var(--success-dark)}
.kpi.orange .kpi-icon{background:var(--warning-soft);color:var(--warning-dark)}
.kpi.blue .kpi-icon{background:var(--info-soft);color:var(--info-dark)}
.kpi-value{font-size:23px;font-weight:800;color:var(--text);line-height:1.1;letter-spacing:-.5px;margin-bottom:3px}
.kpi-value.green{color:var(--success-dark)}
.kpi-value.small{font-size:17px}
.kpi-sub{font-size:11.5px;color:var(--muted)}

.card{background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow);overflow:hidden}
.card-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:12px;background:#fafbfc;flex-wrap:wrap}
.card-head h3{font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:9px}
.card-head h3 i{color:var(--primary)}

.filter-bar{padding:12px 14px;border-bottom:1px solid var(--border);background:#fafbfc;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.filter-group{display:flex;align-items:center;gap:6px;background:#fff;border:1.5px solid var(--border-strong);border-radius:6px;padding:6px 11px;transition:border .15s}
.filter-group:focus-within{border-color:var(--primary)}
.filter-group i{color:var(--muted);font-size:12px}
.filter-group input,.filter-group select{border:none;outline:none;font-size:12.5px;background:transparent;color:var(--text);min-width:120px}
.filter-bar .spacer{flex:1}

.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:13px}
thead th{background:#f5f6f8;color:var(--text-soft);text-align:left;padding:11px 14px;font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;border-bottom:1.5px solid var(--border);white-space:nowrap}
tbody td{padding:12px 14px;border-bottom:1px solid #f0f2f5;vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:#fafbfc}
.text-end{text-align:right}
.text-center{text-align:center}
.text-danger{color:var(--primary-dark);font-weight:700}
.text-success{color:var(--success-dark);font-weight:700}
.text-muted{color:var(--muted)}

.badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:12px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.badge-success{background:var(--success-soft);color:var(--success-dark)}
.badge-danger{background:#FFEBEE;color:var(--primary-dark)}
.badge-warning{background:var(--warning-soft);color:var(--warning-dark)}
.badge-info{background:var(--info-soft);color:var(--info-dark)}
.badge-neutral{background:var(--dark-soft);color:var(--text-soft)}
.badge i{font-size:10px}

.prod-cell{display:flex;align-items:center;gap:11px}
.prod-thumb{width:36px;height:36px;border-radius:8px;background:var(--primary-soft);border:1px solid var(--primary-line);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:15px;flex-shrink:0}
.prod-nome{font-weight:700;font-size:13px;color:var(--text)}
.prod-codigo{font-size:11px;color:var(--muted);font-family:Consolas,monospace;margin-top:1px}

.margem-positiva{color:var(--success-dark);font-weight:700}
.margem-baixa{color:var(--warning-dark);font-weight:700}
.margem-negativa{color:var(--primary-dark);font-weight:700}

.row-actions{display:inline-flex;gap:5px;align-items:center;justify-content:center}

.empty{padding:60px 20px;text-align:center;color:var(--muted)}
.empty i{font-size:52px;color:var(--muted-2);margin-bottom:14px;display:block}
.empty h4{font-size:16px;color:var(--text-soft);margin-bottom:6px;font-weight:600}
.empty p{font-size:13px;margin-bottom:16px}

.pag-bar{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 16px;border-top:1px solid var(--border);background:#fafbfc;font-size:12.5px;color:var(--muted);flex-wrap:wrap}
.pag-controls{display:flex;gap:4px}
.pag-btn{min-width:32px;height:32px;padding:0 10px;border:1px solid var(--border-strong);background:#fff;border-radius:6px;font-size:12.5px;font-weight:700;color:var(--text-soft);display:inline-flex;align-items:center;justify-content:center;transition:all .15s}
.pag-btn:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
.pag-btn.active{background:var(--primary);border-color:var(--primary);color:#fff}
.pag-btn:disabled{opacity:.4;cursor:not-allowed}

.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:2000;padding:20px;backdrop-filter:blur(3px);overflow-y:auto}
.modal-backdrop.open{display:flex}
.modal{background:#fff;border-radius:12px;width:100%;max-width:560px;box-shadow:0 20px 50px rgba(0,0,0,.3);overflow:hidden;animation:modalPop .22s ease;margin:auto}
.modal.modal-sm{max-width:420px}
@keyframes modalPop{from{transform:scale(.94) translateY(8px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.modal-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:#FAFBFC;border-bottom:1px solid var(--border)}
.modal-header h3{font-size:16px;font-weight:700;display:flex;align-items:center;gap:9px}
.modal-header h3 i{color:var(--primary)}
.modal-close{background:none;border:none;font-size:24px;line-height:1;cursor:pointer;color:var(--muted);padding:0 4px;border-radius:6px;transition:all .15s}
.modal-close:hover{color:var(--primary);background:var(--dark-soft)}
.modal-body{padding:20px;max-height:70vh;overflow-y:auto}
.modal-actions{display:flex;justify-content:flex-end;gap:10px;padding:14px 20px;border-top:1px solid var(--border);background:#FAFBFC}

.form-group{margin-bottom:14px}
.form-group:last-child{margin-bottom:0}
.form-label{display:block;margin-bottom:6px;color:var(--text);font-weight:700;font-size:12.5px;display:flex;align-items:center;gap:6px}
.form-label i{color:var(--muted);font-size:11px}
.form-label .required{color:var(--primary)}
.form-control{width:100%;padding:10px 13px;border:1.5px solid var(--border-strong);border-radius:6px;font-size:13.5px;transition:all .18s;background:#fff;color:var(--text)}
.form-control:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 3px rgba(229,57,53,.08)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
textarea.form-control{resize:vertical;min-height:56px}

#toast-container{position:fixed;top:20px;right:20px;z-index:3000;display:flex;flex-direction:column;gap:10px}
.toast{display:flex;align-items:center;gap:11px;padding:12px 16px;border-radius:8px;color:#fff;font-size:13.5px;font-weight:600;box-shadow:0 8px 22px rgba(0,0,0,.2);animation:toastIn .25s ease;max-width:360px}
.toast.success{background:var(--success)}
.toast.error{background:var(--primary)}
.toast.info{background:var(--info)}
.toast.warning{background:var(--warning)}
@keyframes toastIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:translateX(0)}}

@media(max-width:900px){
    .sidebar{width:60px}
    .sidebar .logo span,.sidebar .nav-menu span,.sidebar .user-details{display:none}
    .sidebar .logo{justify-content:center;padding:0 8px 14px}
    .sidebar .logo i{margin:0}
    .sidebar .nav-menu a{justify-content:center;padding:11px 8px}
    .sidebar .user-info{justify-content:center;padding:12px 8px}
    .main-content{margin-left:60px;padding:14px}
}
@media(max-width:600px){
    .kpi-strip{grid-template-columns:1fr}
    .filter-bar{flex-direction:column;align-items:stretch}
    .filter-group{width:100%}
    .filter-group input,.filter-group select{width:100%}
    .form-row{grid-template-columns:1fr}
}
</style>
</head>
<body>

<aside class="sidebar">
    <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
    <ul class="nav-menu">
        <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i><span>Painel</span></a></li>
        <li><a href="/caixa"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
        <li><a href="/vendas"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
        <li><a href="/produtos" class="active"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
        <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
        <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
        <li><a href="#"><i class="fas fa-cog"></i><span>Config.</span></a></li>
    </ul>
    <div class="user-info">
        <div class="user-avatar"><%= operadorNome.substring(0,2).toUpperCase() %></div>
        <div class="user-details">
            <div class="user-name"><%= operadorNome %></div>
            <div class="user-role">Gerente</div>
        </div>
    </div>
</aside>

<main class="main-content">

    <div class="topbar">
        <div class="topbar-left">
            <h1>Gestão de Produtos</h1>
            <div class="page-subtitle">Catálogo, preços e stock</div>
        </div>
        <div class="topbar-right">
            <a href="/vendas/nova" class="btn btn-outline">
                <i class="fas fa-shopping-cart"></i> Nova Venda
            </a>
            <a href="/produtos/novo" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Produto
            </a>
        </div>
    </div>

    <%
      const listaProdutos = (typeof produtos !== 'undefined' && Array.isArray(produtos)) ? produtos : [];
      const fmt = n => Number(n||0).toLocaleString('pt-AO',{minimumFractionDigits:2,maximumFractionDigits:2});
      const totalProdutos = listaProdutos.length;
      const totalStock = listaProdutos.reduce((s,p) => s + Number(p.quantidade_estoque || 0), 0);
      const stockBaixo = listaProdutos.filter(p => {
          const q = Number(p.quantidade_estoque || 0);
          const min = Number(p.quantidade_minima || 5);
          return q > 0 && q <= min;
      }).length;
      const semStock = listaProdutos.filter(p => Number(p.quantidade_estoque || 0) <= 0).length;
      const valorInventario = listaProdutos.reduce((s,p) => s + (Number(p.preco_venda || 0) * Number(p.quantidade_estoque || 0)), 0);
    %>

    <div class="kpi-strip">
        <div class="kpi blue">
            <div class="kpi-head">
                <span class="kpi-label">Total de Produtos</span>
                <div class="kpi-icon"><i class="fas fa-boxes"></i></div>
            </div>
            <div class="kpi-value"><%= totalProdutos %></div>
            <div class="kpi-sub"><%= totalStock %> unidades em stock</div>
        </div>
        <div class="kpi green">
            <div class="kpi-head">
                <span class="kpi-label">Disponíveis</span>
                <div class="kpi-icon"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="kpi-value green"><%= totalProdutos - semStock %></div>
            <div class="kpi-sub">Com stock ativo</div>
        </div>
        <div class="kpi orange">
            <div class="kpi-head">
                <span class="kpi-label">Stock Baixo</span>
                <div class="kpi-icon"><i class="fas fa-exclamation-triangle"></i></div>
            </div>
            <div class="kpi-value"><%= stockBaixo %></div>
            <div class="kpi-sub">Abaixo do mínimo</div>
        </div>
        <div class="kpi dark">
            <div class="kpi-head">
                <span class="kpi-label">Valor do Inventário</span>
                <div class="kpi-icon"><i class="fas fa-coins"></i></div>
            </div>
            <div class="kpi-value small"><%= fmt(valorInventario) %> Kz</div>
            <div class="kpi-sub">Preço de venda × stock</div>
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <h3><i class="fas fa-list"></i> Catálogo de Produtos</h3>
            <span class="text-muted" style="font-size:12px;" id="contadorLabel"><%= totalProdutos %> registos</span>
        </div>

        <% if (listaProdutos.length === 0) { %>
            <div class="empty">
                <i class="fas fa-box-open"></i>
                <h4>Nenhum produto registado</h4>
                <p>Comece por registar o primeiro produto do catálogo.</p>
                <a href="/produtos/novo" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Registar Primeiro Produto
                </a>
            </div>
        <% } else { %>

            <div class="filter-bar">
                <div class="filter-group" style="flex:1;min-width:220px;">
                    <i class="fas fa-search"></i>
                    <input type="text" id="filtroTexto" placeholder="Pesquisar por nome ou código de barras...">
                </div>
                <div class="filter-group">
                    <i class="fas fa-layer-group"></i>
                    <select id="filtroCategoria">
                        <option value="">Todas as categorias</option>
                        <%
                          const cats = [...new Set(listaProdutos.map(p => p.categoria).filter(Boolean))];
                          cats.forEach(c => {
                        %>
                            <option value="<%= c %>"><%= c %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="filter-group">
                    <i class="fas fa-filter"></i>
                    <select id="filtroStock">
                        <option value="">Todo o stock</option>
                        <option value="ok">Disponível</option>
                        <option value="low">Stock baixo</option>
                        <option value="zero">Sem stock</option>
                    </select>
                </div>
                <div class="spacer"></div>
                <button class="btn btn-outline btn-sm" onclick="limparFiltros()">
                    <i class="fas fa-eraser"></i> Limpar
                </button>
            </div>

            <div class="table-wrap">
                <table id="tabelaProdutos">
                    <thead>
                        <tr>
                            <th style="width:60px;">ID</th>
                            <th>Produto</th>
                            <th style="width:130px;">Categoria</th>
                            <th class="text-end" style="width:110px;">Custo</th>
                            <th class="text-end" style="width:120px;">Preço Venda</th>
                            <th class="text-end" style="width:90px;">Margem</th>
                            <th class="text-center" style="width:110px;">Stock</th>
                            <th class="text-center" style="width:110px;">Estado</th>
                            <th class="text-center" style="width:110px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyProdutos">
                        <%
                          listaProdutos.forEach(p => {
                              const estoque = Number(p.quantidade_estoque || 0);
                              const minimo = Number(p.quantidade_minima || 5);
                              const custo = Number(p.preco_custo || 0);
                              const preco = Number(p.preco_venda || 0);
                              const margem = preco > 0 ? ((preco - custo) / preco) * 100 : 0;
                              const margemClass = margem >= 20 ? 'margem-positiva' : (margem >= 0 ? 'margem-baixa' : 'margem-negativa');
                              const estado = estoque <= 0 ? 'zero' : (estoque <= minimo ? 'low' : 'ok');
                              const estadoLabel = estoque <= 0 ? 'Sem stock' : (estoque <= minimo ? 'Stock baixo' : 'Disponível');
                        %>
                        <tr data-id="<%= p.id %>"
                            data-nome="<%= (p.nome || '').toLowerCase() %>"
                            data-codigo="<%= (p.codigo_barras || '').toLowerCase() %>"
                            data-categoria="<%= p.categoria || '' %>"
                            data-estado="<%= estado %>">
                            <td><span class="badge badge-neutral"><i class="fas fa-hashtag"></i><%= p.id %></span></td>
                            <td>
                                <div class="prod-cell">
                                    <div class="prod-thumb"><i class="fas fa-box"></i></div>
                                    <div>
                                        <div class="prod-nome"><%= p.nome %></div>
                                        <div class="prod-codigo"><%= p.codigo_barras || '— sem código —' %></div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-info"><%= p.categoria || 'Sem cat.' %></span></td>
                            <td class="text-end"><%= fmt(custo) %> Kz</td>
                            <td class="text-end text-success"><strong><%= fmt(preco) %> Kz</strong></td>
                            <td class="text-end"><span class="<%= margemClass %>"><%= margem.toFixed(1) %>%</span></td>
                            <td class="text-center"><strong><%= estoque %></strong> <span style="color:var(--muted);font-size:11px;">/ min <%= minimo %></span></td>
                            <td class="text-center">
                                <span class="badge badge-<%= estado === 'ok' ? 'success' : (estado === 'low' ? 'warning' : 'danger') %>">
                                    <i class="fas fa-circle" style="font-size:7px;"></i> <%= estadoLabel %>
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="row-actions">
                                    <a href="/produtos/editar/<%= p.id %>" class="btn btn-outline btn-sm btn-icon" title="Editar">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline btn-sm btn-icon"
                                            onclick="confirmarEliminar(<%= p.id %>, '<%= (p.nome || '').replace(/'/g, "\\'") %>')"
                                            title="Eliminar"
                                            style="color:var(--primary-dark);border-color:var(--primary-line);">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="empty" id="emptyFiltro" style="display:none;">
                <i class="fas fa-search-minus"></i>
                <h4>Nenhum resultado</h4>
                <p>Ajuste os filtros para encontrar o produto pretendido.</p>
            </div>

            <div class="pag-bar">
                <span id="pagInfo">—</span>
                <div class="pag-controls" id="pagControls"></div>
            </div>
        <% } %>
    </div>
</main>

<!-- MODAL: CONFIRMAR ELIMINAÇÃO -->
<div class="modal-backdrop" id="eliminarModal" onclick="if(event.target===this) fecharModal('eliminarModal')">
    <div class="modal modal-sm">
        <div class="modal-header">
            <h3 style="color:var(--primary-dark);"><i class="fas fa-exclamation-triangle" style="color:var(--warning);"></i> Confirmar Eliminação</h3>
            <button type="button" class="modal-close" onclick="fecharModal('eliminarModal')">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size:13.5px;color:var(--text-soft);line-height:1.6;">
                Tem a certeza que deseja eliminar <strong id="eliminarNome">—</strong>?<br>
                Esta acção <strong style="color:var(--primary-dark);">não pode ser revertida</strong>.
            </p>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline" onclick="fecharModal('eliminarModal')">Cancelar</button>
            <button type="button" class="btn btn-danger" id="btnEliminarReal">
                <i class="fas fa-trash"></i> Eliminar
            </button>
        </div>
    </div>
</div>

<div id="toast-container" aria-live="polite"></div>

<script>
function toast(msg, tipo='info', dur=3000) {
    const c = document.getElementById('toast-container');
    const icons = { success:'fa-check-circle', error:'fa-exclamation-circle', info:'fa-info-circle', warning:'fa-exclamation-triangle' };
    const t = document.createElement('div');
    t.className = 'toast ' + tipo;
    t.innerHTML = '<i class="fas ' + (icons[tipo]||icons.info) + '"></i><span></span>';
    t.querySelector('span').textContent = msg;
    c.appendChild(t);
    setTimeout(() => {
        t.style.transition = 'all .25s ease';
        t.style.opacity = '0';
        t.style.transform = 'translateX(30px)';
        setTimeout(() => t.remove(), 250);
    }, dur);
}
function abrirModal(id) { document.getElementById(id).classList.add('open'); }
function fecharModal(id) { document.getElementById(id).classList.remove('open'); }

let eliminarId = null;
function confirmarEliminar(id, nome) {
    eliminarId = id;
    document.getElementById('eliminarNome').textContent = nome;
    abrirModal('eliminarModal');
}

document.getElementById('btnEliminarReal')?.addEventListener('click', async function() {
    if (!eliminarId) return;
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A eliminar...';

    try {
        const resp = await fetch('/api/produtos/' + eliminarId, { method: 'DELETE' });
        let data = {};
        try { data = await resp.json(); } catch (err) {}
        if (!resp.ok) throw new Error(data.erro || 'Falha ao eliminar.');
        toast('Produto eliminado.', 'success', 2400);
        fecharModal('eliminarModal');
        setTimeout(() => window.location.reload(), 500);
    } catch (err) {
        toast(err.message || 'Erro ao eliminar produto.', 'error', 3600);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-trash"></i> Eliminar';
    }
});

const state = { page: 1, perPage: 12, texto: '', categoria: '', stock: '' };
function getLinhas() { return [...document.querySelectorAll('#tbodyProdutos tr')]; }

function aplicarFiltros() {
    let visiveis = 0;
    getLinhas().forEach(tr => {
        const nome = tr.dataset.nome || '';
        const codigo = tr.dataset.codigo || '';
        const cat = tr.dataset.categoria || '';
        const estado = tr.dataset.estado || '';

        const okTexto = !state.texto || nome.includes(state.texto) || codigo.includes(state.texto);
        const okCat = !state.categoria || cat === state.categoria;
        const okStock = !state.stock || estado === state.stock;

        const match = okTexto && okCat && okStock;
        tr.dataset.visivel = match ? '1' : '0';
        if (match) visiveis++;
    });
    return visiveis;
}

function renderPaginacao(totalVisivel) {
    const totalPag = Math.max(1, Math.ceil(totalVisivel / state.perPage));
    if (state.page > totalPag) state.page = totalPag;

    const visiveis = getLinhas().filter(tr => tr.dataset.visivel === '1');
    visiveis.forEach((tr, i) => {
        const dentro = (i >= (state.page-1)*state.perPage) && (i < state.page*state.perPage);
        tr.style.display = dentro ? '' : 'none';
    });

    const ini = totalVisivel === 0 ? 0 : (state.page-1)*state.perPage + 1;
    const fim = Math.min(state.page*state.perPage, totalVisivel);
    const info = document.getElementById('pagInfo');
    if (info) info.textContent = totalVisivel === 0 ? 'Sem resultados' : `Mostrando ${ini}–${fim} de ${totalVisivel}`;

    const c = document.getElementById('pagControls');
    if (!c) return;
    if (totalPag <= 1) { c.innerHTML = ''; return; }

    const btns = [];
    btns.push(`<button class="pag-btn" ${state.page===1?'disabled':''} data-go="${state.page-1}"><i class="fas fa-chevron-left"></i></button>`);
    for (let p = 1; p <= totalPag; p++) {
        if (p === 1 || p === totalPag || Math.abs(p - state.page) <= 1) {
            btns.push(`<button class="pag-btn ${p===state.page?'active':''}" data-go="${p}">${p}</button>`);
        } else if (Math.abs(p - state.page) === 2) {
            btns.push(`<span style="padding:0 4px;color:#aaa;">…</span>`);
        }
    }
    btns.push(`<button class="pag-btn" ${state.page===totalPag?'disabled':''} data-go="${state.page+1}"><i class="fas fa-chevron-right"></i></button>`);
    c.innerHTML = btns.join('');
    c.querySelectorAll('[data-go]').forEach(b => {
        b.addEventListener('click', () => {
            if (b.disabled) return;
            state.page = parseInt(b.dataset.go, 10);
            renderPaginacao(aplicarFiltros());
        });
    });
}

function limparFiltros() {
    state.texto = ''; state.categoria = ''; state.stock = ''; state.page = 1;
    document.getElementById('filtroTexto').value = '';
    document.getElementById('filtroCategoria').value = '';
    document.getElementById('filtroStock').value = '';
    renderLista();
}

function renderLista() {
    const total = aplicarFiltros();
    renderPaginacao(total);
    const empty = document.getElementById('emptyFiltro');
    const tabela = document.getElementById('tabelaProdutos');
    const pag = document.querySelector('.pag-bar');
    if (empty) empty.style.display = total === 0 ? 'block' : 'none';
    if (tabela) tabela.style.display = total === 0 ? 'none' : '';
    if (pag) pag.style.display = total === 0 ? 'none' : 'flex';
    const cont = document.getElementById('contadorLabel');
    if (cont) cont.textContent = total + ' de ' + getLinhas().length + ' registos';
}

document.getElementById('filtroTexto')?.addEventListener('input', e => {
    state.texto = e.target.value.toLowerCase().trim();
    state.page = 1;
    renderLista();
});
document.getElementById('filtroCategoria')?.addEventListener('change', e => {
    state.categoria = e.target.value;
    state.page = 1;
    renderLista();
});
document.getElementById('filtroStock')?.addEventListener('change', e => {
    state.stock = e.target.value;
    state.page = 1;
    renderLista();
});

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') fecharModal('eliminarModal');
});

if (getLinhas().length) renderLista();
</script>
</body>
</html>