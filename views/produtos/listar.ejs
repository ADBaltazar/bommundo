      categoria: String(p.categoria || ''),
      preco_custo: Number(p.preco_custo || 0),
      preco_venda: Number(p.preco_venda || 0),
      quantidade_estoque: Number(p.quantidade_estoque || 0),
      quantidade_minima: Number(p.quantidade_minima || 5)
