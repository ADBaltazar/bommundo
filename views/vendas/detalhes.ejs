<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Factura — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --bg:             #fafafa;
  --surface:        #ffffff;
  --border:         #e5e5e5;
  --fg:             #1a1a1a;
  --fg-muted:       #666666;
  --primary:        #c62828;
  --primary-hover:  #a01f1f;
  --primary-active: #8b1a1a;
  --success:        #16a34a;
  --warning:        #b45309;
  --info:           #2563eb;
  --danger:         #c62828;
  --focus:          #1a1a1a;

  --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px; --s-7: 48px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg);
  background: var(--bg);
  display: flex;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }

::selection { background: var(--fg); color: var(--bg); }

:focus { outline: none; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ---------- Botões ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border: 1px solid transparent;
  border-radius: 4px;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
  white-space: nowrap;
}
.btn i { font-size: 11px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }

.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-primary:active:not(:disabled) { background: var(--primary-active); }
.btn-primary i { color: #fff; }

.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border); }
.btn-outline:hover:not(:disabled) { border-color: var(--fg-muted); }
.btn-outline:active:not(:disabled) { background: var(--bg); }
.btn-outline i { color: var(--fg-muted); }

/* ---------- Sidebar ---------- */
.sidebar {
  width: 220px;
  background: #1a1a1a;
  color: #d4d4d4;
  position: fixed;
  inset: 0 auto 0 0;
  display: flex;
  flex-direction: column;
  padding: var(--s-5) 0;
  z-index: 100;
  overflow-y: auto;
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: 0 var(--s-5) var(--s-5);
  font-size: 15px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: .5px;
  border-bottom: 1px solid #2a2a2a;
  margin-bottom: var(--s-4);
}
.logo i { color: var(--primary); font-size: 15px; }

.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  padding: var(--s-3) var(--s-5);
  font-size: 13px;
  font-weight: 500;
  color: #d4d4d4;
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover { background: #2a2a2a; color: var(--primary); }
.nav-menu a:hover i { color: var(--primary); }
.nav-menu a.active {
  background: #2a2a2a;
  color: var(--primary);
  border-left-color: var(--primary);
}
.nav-menu a.active i { color: var(--primary); }
.nav-menu a:focus-visible { outline-color: #fff; }
.nav-menu i {
  width: 16px;
  text-align: center;
  font-size: 12px;
  color: #666;
  transition: color .2s ease;
}

.user-info {
  padding: var(--s-4) var(--s-5) 0;
  border-top: 1px solid #2a2a2a;
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-top: var(--s-4);
}
.user-avatar {
  width: 32px; height: 32px;
  background: var(--primary);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600; color: #fff;
  flex-shrink: 0;
}
.user-details { min-width: 0; flex: 1; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

/* ---------- Main ---------- */
.main-content {
  flex: 1;
  margin-left: 220px;
  padding: var(--s-5);
  min-width: 0;
}

/* ---------- Topbar ---------- */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-4);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-5);
  flex-wrap: wrap;
}
.topbar-left { display: flex; align-items: center; gap: var(--s-3); }
.topbar-back {
  width: 36px; height: 36px;
  border-radius: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--fg-muted);
  transition: color .15s, border-color .15s;
  flex-shrink: 0;
}
.topbar-back:hover { color: var(--primary); border-color: var(--primary); }
.topbar-back:active { background: var(--bg); }
.topbar-left h1 {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -.005em;
}
.topbar-left h1 strong { color: var(--primary); font-weight: 600; font-variant-numeric: tabular-nums; }
.topbar-left .page-subtitle {
  font-size: 12px;
  color: var(--fg-muted);
  margin-top: 2px;
  display: flex;
  align-items: center;
  gap: var(--s-2);
  flex-wrap: wrap;
  font-variant-numeric: tabular-nums;
}
.topbar-left .page-subtitle .sep { color: var(--border); }

.topbar-right { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }

/* ---------- Documento ---------- */
.documento {
  padding: var(--s-7) var(--s-6);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  max-width: 900px;
  margin: 0 auto;
}

.doc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--s-5);
  border-bottom: 2px solid var(--primary);
  padding-bottom: var(--s-4);
  margin-bottom: var(--s-5);
  flex-wrap: wrap;
}
.doc-empresa { flex: 1; min-width: 240px; }
.doc-logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: .5px;
  color: var(--primary);
  margin-bottom: var(--s-2);
}
.doc-logo i { color: var(--primary); font-size: 16px; }
.doc-empresa p { font-size: 12px; color: var(--fg-muted); line-height: 1.55; }

.doc-titulo-bloco { text-align: right; min-width: 220px; }
.doc-titulo-bloco h2 {
  font-size: 16px;
  letter-spacing: 2.5px;
  line-height: 1.2;
  margin-bottom: var(--s-3);
  font-weight: 700;
}
.doc-titulo-bloco p {
  font-size: 12px;
  color: var(--fg-muted);
  margin: 2px 0;
  font-variant-numeric: tabular-nums;
}
.doc-titulo-bloco p strong { color: var(--fg); font-weight: 500; }

/* Metadados (cliente + operação) */
.doc-metadados {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--s-5);
  margin-bottom: var(--s-5);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.meta-bloco h4 {
  font-size: 11px;
  color: var(--fg-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-bottom: var(--s-2);
}
.meta-bloco p {
  font-size: 12px;
  margin: 2px 0;
  font-variant-numeric: tabular-nums;
  line-height: 1.55;
}
.meta-bloco p strong { color: var(--fg); font-weight: 500; }
.meta-bloco p span { color: var(--fg-muted); }

/* ---------- Status ---------- */
.status-badge {
  display: inline;
  font-size: 12px;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.status-badge.status-concluida { color: var(--success); }
.status-badge.status-pendente  { color: var(--warning); }
.status-badge.status-cancelada { color: var(--danger); }

/* ---------- Tabela de itens ---------- */
.doc-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
  border: 1px solid var(--border);
}
.doc-table th {
  text-align: left;
  padding: var(--s-2) var(--s-3);
  background: var(--fg);
  color: #fff;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .3px;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.doc-table th.text-end { text-align: right; }
.doc-table th.text-center { text-align: center; }
.doc-table td {
  padding: var(--s-2) var(--s-3);
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  vertical-align: middle;
}
.doc-table td.text-end {
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.doc-table td.text-center {
  text-align: center;
  font-variant-numeric: tabular-nums;
}
.doc-table tbody tr:nth-child(even) { background: var(--bg); }
.doc-table tbody tr:last-child td { border-bottom: 1px solid var(--border); }
.doc-table td strong { font-weight: 600; }

/* ---------- Totais ---------- */
.doc-totais {
  margin-top: var(--s-4);
  display: flex;
  justify-content: flex-end;
}
.doc-totais table {
  width: 300px;
  border-collapse: collapse;
  font-size: 12px;
}
.doc-totais td {
  padding: var(--s-2) var(--s-3);
  font-variant-numeric: tabular-nums;
}
.doc-totais td:last-child { text-align: right; }
.doc-totais tr.grand-total td {
  border-top: 1px solid var(--fg);
  padding-top: var(--s-3);
  font-weight: 700;
  font-size: 13px;
}
.doc-totais tr.grand-total td:last-child { color: var(--primary); }

/* ---------- Rodapé do documento ---------- */
.doc-rodape {
  margin-top: var(--s-6);
  padding-top: var(--s-3);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  gap: var(--s-4);
  font-size: 11px;
  color: var(--fg-muted);
  flex-wrap: wrap;
}

.doc-assinatura {
  margin-top: var(--s-6);
  text-align: center;
  font-size: 12px;
  color: var(--fg-muted);
}
.doc-assinatura .linha {
  width: 200px;
  border-top: 1px solid var(--fg-muted);
  margin: 0 auto var(--s-2);
}
.doc-assinatura strong { color: var(--fg); font-weight: 500; }

/* ---------- Modais ---------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--s-4);
  overflow-y: auto;
}
.modal-backdrop.open { display: flex; animation: fadeIn .15s ease; }
.modal {
  background: var(--surface);
  border-radius: 4px;
  width: 100%;
  max-width: 460px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .15);
  overflow: hidden;
  margin: auto;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.modal-header h3 { font-size: 14px; font-weight: 600; }
.modal-close {
  background: none;
  border: none;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  color: var(--fg-muted);
  padding: 0 var(--s-1);
  transition: color .15s;
}
.modal-close:hover { color: var(--fg); }
.modal-body { padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-3); }
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--s-2);
  padding: var(--s-3) var(--s-4);
  border-top: 1px solid var(--border);
  background: var(--bg);
}

/* ---------- Forms ---------- */
.form-group { display: flex; flex-direction: column; gap: var(--s-1); }
.form-label {
  color: var(--fg);
  font-weight: 500;
  font-size: 12px;
}
.form-label .required { color: var(--primary); margin-left: 2px; }
.form-control {
  width: 100%;
  padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border);
  border-radius: 4px;
  font: inherit;
  font-size: 13px;
  background: var(--surface);
  color: var(--fg);
  caret-color: var(--primary);
  transition: border-color .15s;
}
.form-control::placeholder { color: #999; }
.form-control:focus {
  outline: 2px solid var(--focus);
  outline-offset: 1px;
  border-color: var(--fg);
}
textarea.form-control { resize: vertical; min-height: 80px; }

.checkbox-inline {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: 13px;
  color: var(--fg);
  cursor: pointer;
}
.checkbox-inline input { width: 15px; height: 15px; accent-color: var(--primary); cursor: pointer; }

/* ---------- Toast ---------- */
#toast-container {
  position: fixed;
  top: var(--s-4);
  right: var(--s-4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}
.toast {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border-radius: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-left-width: 3px;
  color: var(--fg);
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
  animation: fadeIn .15s ease;
  max-width: 360px;
}
.toast i { font-size: 12px; flex-shrink: 0; }
.toast.success { border-left-color: var(--success); }
.toast.success i { color: var(--success); }
.toast.error { border-left-color: var(--danger); }
.toast.error i { color: var(--danger); }
.toast.info { border-left-color: var(--info); }
.toast.info i { color: var(--info); }

/* ---------- Responsivo ---------- */
@media (max-width: 900px) {
  .sidebar { width: 60px; }
  .sidebar .logo span,
  .sidebar .nav-menu a span,
  .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { margin-left: 60px; padding: var(--s-3); }
}

@media (max-width: 640px) {
  .documento { padding: var(--s-4) var(--s-3); }
  .doc-top { flex-direction: column; gap: var(--s-3); }
  .doc-titulo-bloco { text-align: left; min-width: 0; }
  .doc-metadados { grid-template-columns: 1fr; gap: var(--s-3); }
  .doc-totais table { width: 100%; }
  .topbar-left h1 { font-size: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ---------- Impressão ---------- */
@media print {
  @page { size: A4 portrait; margin: 12mm 10mm; }
  html, body {
    background: #fff !important;
    display: block !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-size: 10pt;
  }
  .sidebar, .topbar, .no-print, .modal-backdrop, #toast-container { display: none !important; }
  .main-content { margin: 0 !important; padding: 0 !important; }
  .documento {
    padding: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    max-width: 100% !important;
  }
  .doc-table th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .doc-table tr, .doc-metadados, .doc-totais, .doc-rodape, .doc-assinatura { page-break-inside: avoid; }
  .doc-table thead { display: table-header-group; }
}
</style>
</head>
<body>

<aside class="sidebar">
    <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
    <ul class="nav-menu">
        <li><a href="/dashboard" class="<%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"><i class="fas fa-tachometer-alt"></i><span>Painel principal</span></a></li>
        <li><a href="/caixa" class="<%= currentPath.startsWith('/caixa') ? 'active' : '' %>"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
        <li><a href="/vendas" class="<%= currentPath.startsWith('/vendas') ? 'active' : '' %>"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
        <li><a href="/produtos" class="<%= currentPath.startsWith('/produtos') ? 'active' : '' %>"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
        <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
        <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
        <li><a href="#"><i class="fas fa-cog"></i><span>Configurações</span></a></li>
    </ul>
    <div class="user-info">
        <div class="user-avatar">JS</div>
        <div class="user-details">
            <div class="user-name">João Silva</div>
            <div class="user-role">Operador de Caixa</div>
        </div>
    </div>
</aside>

<main class="main-content">

<%
    /* ---------- Helpers de formatação ---------- */
    const formatKz = (valor) => {
        const n = Number(valor || 0);
        return n.toFixed(2)
            .replace('.', ',')
            .replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    };

    const dataVendaObj = new Date(venda.data_venda);
    const dataVenda = dataVendaObj.toLocaleDateString('pt-AO');
    const horaVenda = dataVendaObj.toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit' });

    const subtotalFactura = venda.ItemVendas.reduce(
        (soma, item) => soma + Number(item.subtotal || 0), 0
    );
    const descontoFactura = Number(venda.desconto || 0);
    const totalFactura = Math.max(0, subtotalFactura - descontoFactura);

    const numeroFactura = 'FT ' + dataVendaObj.getFullYear() + '/' +
        String(venda.id).padStart(5, '0');

    const formasPagamento = {
        'dinheiro': 'Dinheiro',
        'Tpa': 'TPA (Multicaixa)',
        'transferencia': 'Transferência Bancária'
    };

    const statusVenda = {
        'pendente': 'Pendente',
        'concluida': 'Concluída',
        'cancelada': 'Cancelada'
    };
%>

    <div class="topbar no-print">
        <div class="topbar-left">
            <a href="/vendas" class="topbar-back" title="Voltar para vendas"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h1>Factura Nº <strong><%= numeroFactura %></strong></h1>
                <div class="page-subtitle">
                    <span>Emitida em <%= dataVenda %> às <%= horaVenda %></span>
                    <span class="sep">·</span>
                    <span>Operador: <%= venda.Funcionario.nome %></span>
                </div>
            </div>
        </div>
        <div class="topbar-right">
            <button type="button" class="btn btn-outline" id="btnImprimir" onclick="imprimirFactura()">
                <i class="fas fa-print"></i> Imprimir
            </button>
            <button type="button" class="btn btn-primary" id="btnBaixarPdf" onclick="baixarPDF()">
                <i class="fas fa-file-pdf"></i> PDF
            </button>
            <button type="button" class="btn btn-outline" id="btnEnviarEmail" onclick="abrirModalEmail()">
                <i class="fas fa-envelope"></i> Email
            </button>
        </div>
    </div>

    <div class="documento" id="factura">

        <div class="doc-top">
            <div class="doc-empresa">
                <div class="doc-logo"><i class="fas fa-globe-americas"></i> BOM MUNDO</div>
                <p>Comércio Geral e Prestação de Serviços</p>
                <p>NIF: 5000000000</p>
                <p>Rua da Liberdade, nº 123 — Luanda, Angola</p>
                <p>Tel: +244 900 000 000 · geral@bomundo.ao</p>
            </div>
            <div class="doc-titulo-bloco">
                <h2>FACTURA</h2>
                <p><span>Nº:</span> <strong><%= numeroFactura %></strong></p>
                <p><span>Data:</span> <strong><%= dataVenda %></strong></p>
                <p><span>Hora:</span> <strong><%= horaVenda %></strong></p>
                <p><span>Caixa:</span> <strong>#00<%= venda.id %></strong></p>
            </div>
        </div>

        <div class="doc-metadados">
            <div class="meta-bloco">
                <h4>Exmo.(a) Senhor(a)</h4>
                <p><strong>Consumidor Final</strong></p>
                <p>NIF: —</p>
                <p>Luanda — Angola</p>
            </div>
            <div class="meta-bloco">
                <h4>Dados da operação</h4>
                <p><span>Funcionário:</span> <strong><%= venda.Funcionario.nome %></strong></p>
                <p><span>Forma de pagamento:</span> <strong><%= formasPagamento[venda.forma_pagamento] || venda.forma_pagamento %></strong></p>
                <p><span>Status:</span>
                    <span class="status-badge status-<%= venda.status %>"><%= statusVenda[venda.status] || venda.status %></span>
                </p>
            </div>
        </div>

        <table class="doc-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Descrição do produto</th>
                    <th class="text-center" style="width:70px;">Qtd.</th>
                    <th class="text-end" style="width:120px;">Preço unit.</th>
                    <th class="text-end" style="width:120px;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <% venda.ItemVendas.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= item.Produto.nome %></td>
                    <td class="text-center"><%= item.quantidade %></td>
                    <td class="text-end"><%= formatKz(item.preco_unitario) %> Kz</td>
                    <td class="text-end"><strong><%= formatKz(item.subtotal) %> Kz</strong></td>
                </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="doc-totais">
            <table>
                <tr>
                    <td>Subtotal</td>
                    <td><%= formatKz(subtotalFactura) %> Kz</td>
                </tr>
                <% if (descontoFactura > 0) { %>
                <tr>
                    <td>Desconto</td>
                    <td style="color: var(--danger);">- <%= formatKz(descontoFactura) %> Kz</td>
                </tr>
                <% } %>
                <tr class="grand-total">
                    <td>TOTAL A PAGAR</td>
                    <td><%= formatKz(totalFactura) %> Kz</td>
                </tr>
            </table>
        </div>

        <div class="doc-rodape">
            <div>
                Documento processado por computador.<br>
                Emitido em <%= dataVenda %> às <%= horaVenda %>.
            </div>
            <div style="text-align: right;">
                Bom Mundo — Comércio Geral
            </div>
        </div>

        <div class="doc-assinatura">
            <div class="linha"></div>
            <strong><%= venda.Funcionario.nome %></strong> — Operador de Caixa
        </div>

    </div>

</main>

<!-- MODAL: ENVIAR POR EMAIL -->
<div class="modal-backdrop no-print" id="emailModal" onclick="if (event.target === this) fecharModalEmail()">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="emailModalTitulo">
        <div class="modal-header">
            <h3 id="emailModalTitulo">Enviar factura por email</h3>
            <button type="button" class="modal-close" onclick="fecharModalEmail()" aria-label="Fechar">&times;</button>
        </div>

        <form id="emailForm" onsubmit="enviarEmailForm(event)">
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label" for="emailDestinatario">Email do destinatário <span class="required">*</span></label>
                    <input type="email" class="form-control" id="emailDestinatario"
                           placeholder="cliente@email.com" required autocomplete="email">
                </div>

                <div class="form-group">
                    <label class="form-label" for="emailMensagem">Mensagem <span style="color: var(--fg-muted); font-weight: 400;">(opcional)</span></label>
                    <textarea class="form-control" id="emailMensagem" placeholder="Mensagem adicional"></textarea>
                </div>

                <div class="form-group" style="margin: 0;">
                    <label class="checkbox-inline" for="emailAnexoPdf">
                        <input type="checkbox" id="emailAnexoPdf" checked>
                        Anexar factura em PDF
                    </label>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-outline" onclick="fecharModalEmail()">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnEnviarEmailConfirmar">
                    <i class="fas fa-paper-plane"></i> Enviar
                </button>
            </div>
        </form>
    </div>
</div>

<div id="toast-container" class="no-print" aria-live="polite"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
const VENDA = {
    id: Number('<%= venda.id %>'),
    numero: '<%= numeroFactura %>',
    total: Number('<%= totalFactura.toFixed(2) %>'),
    totalFormatado: '<%= formatKz(totalFactura) %> Kz',
    funcionario: '<%= venda.Funcionario.nome %>'
};

function mostrarToast(mensagem, tipo = 'info', duracao = 3000) {
    const container = document.getElementById('toast-container');
    if (!container) { alert(mensagem); return; }
    const icones = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle' };
    const toast = document.createElement('div');
    toast.className = 'toast ' + tipo;
    toast.innerHTML = '<i class="fas ' + (icones[tipo] || icones.info) + '"></i><span></span>';
    toast.querySelector('span').textContent = mensagem;
    container.appendChild(toast);
    setTimeout(() => {
        toast.style.transition = 'opacity .2s ease';
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 200);
    }, duracao);
}

function alternarLoading(botao, ativo, texto) {
    if (!botao) return;
    if (ativo) {
        if (!botao.dataset.htmlOriginal) botao.dataset.htmlOriginal = botao.innerHTML;
        botao.disabled = true;
        botao.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + (texto || 'A processar…');
    } else {
        botao.disabled = false;
        if (botao.dataset.htmlOriginal) botao.innerHTML = botao.dataset.htmlOriginal;
    }
}

function nomeFicheiroPdf() {
    return 'Factura_' + VENDA.numero.replace(/[^\w]+/g, '_') + '.pdf';
}

/* ---------- 1) IMPRIMIR ---------- */
function imprimirFactura() {
    fecharModalEmail();
    const tituloOriginal = document.title;
    document.title = 'Factura ' + VENDA.numero + ' - Bom Mundo';
    window.print();
    document.title = tituloOriginal;
}

/* ---------- 2) BAIXAR PDF ---------- */
function construirPdf() {
    const elemento = document.getElementById('factura');
    return html2pdf().set({
        margin: [10, 10, 12, 10],
        filename: nomeFicheiroPdf(),
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', scrollX: 0, scrollY: 0 },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'] }
    }).from(elemento);
}

async function baixarPDF() {
    if (typeof html2pdf === 'undefined') {
        mostrarToast('Gerador de PDF não carregado.', 'error');
        return;
    }
    const btn = document.getElementById('btnBaixarPdf');
    alternarLoading(btn, true, 'A gerar PDF…');
    try {
        await construirPdf().save();
        mostrarToast('PDF gerado com sucesso.', 'success');
    } catch (erro) {
        console.error('Erro ao gerar PDF:', erro);
        mostrarToast('Não foi possível gerar o PDF.', 'error');
    } finally {
        alternarLoading(btn, false);
    }
}

/* ---------- 3) ENVIAR POR EMAIL ---------- */
function abrirModalEmail() {
    document.getElementById('emailModal').classList.add('open');
    setTimeout(() => document.getElementById('emailDestinatario').focus(), 50);
}

function fecharModalEmail() {
    const modal = document.getElementById('emailModal');
    if (!modal) return;
    modal.classList.remove('open');
    const form = document.getElementById('emailForm');
    if (form) form.reset();
    const anexo = document.getElementById('emailAnexoPdf');
    if (anexo) anexo.checked = true;
}

function pdfParaBase64() {
    return construirPdf().outputPdf('datauristring').then((dataUri) => {
        const indice = dataUri.indexOf(',');
        return indice >= 0 ? dataUri.slice(indice + 1) : dataUri;
    });
}

async function enviarEmailForm(evento) {
    evento.preventDefault();

    const destinatario = document.getElementById('emailDestinatario').value.trim();
    const mensagem = document.getElementById('emailMensagem').value.trim();
    const anexarPdf = document.getElementById('emailAnexoPdf').checked;
    const btn = document.getElementById('btnEnviarEmailConfirmar');

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(destinatario)) {
        mostrarToast('Email inválido.', 'error');
        return;
    }

    alternarLoading(btn, true, 'A enviar…');

    try {
        const payload = {
            email: destinatario,
            mensagem: mensagem,
            vendaId: VENDA.id,
            numeroFactura: VENDA.numero,
            anexarPdf: anexarPdf
        };

        if (anexarPdf) {
            payload.pdfNome = nomeFicheiroPdf();
            payload.pdfBase64 = await pdfParaBase64();
        }

        const resposta = await fetch('/vendas/' + VENDA.id + '/enviar-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        let dados = {};
        try { dados = await resposta.json(); } catch (e) {}

        if (!resposta.ok) {
            throw new Error(dados.erro || 'Falha ao enviar (HTTP ' + resposta.status + ').');
        }

        mostrarToast('Factura enviada para ' + destinatario, 'success');
        fecharModalEmail();
    } catch (erro) {
        console.error('Erro ao enviar email:', erro);
        mostrarToast(erro.message || 'Não foi possível enviar.', 'error');
    } finally {
        alternarLoading(btn, false);
    }
}

/* ---------- Atalhos + init ---------- */
document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') fecharModalEmail();
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'p') {
        e.preventDefault();
        imprimirFactura();
    }
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 's') {
        e.preventDefault();
        baixarPDF();
    }
});
</script>
</body>
</html>