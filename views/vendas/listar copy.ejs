                            <a href="/vendas/${v.id}" class="btn btn-sm btn-info" title="Ver detalhes">
                                <i class="fas fa-file-invoice"></i>
                            </a>
                            <a href="/vendas/cancelar/${v.id}"
                               class="btn btn-sm btn-danger"
                               title="Cancelar venda"
                               ${cancelada ? 'style="pointer-events:none;opacity:.5;"' : ''}
                               onclick="return confirm('Tem a certeza que deseja cancelar a venda #${v.id}?');">
                                <i class="fas fa-times"></i>
