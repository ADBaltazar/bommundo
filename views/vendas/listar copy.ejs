    <!-- Biblioteca de geração de PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <!-- ============================================================
         DADOS (injetados pelo servidor)
         ============================================================ -->
    <script>
        window.__VENDAS__ = <%- JSON.stringify(
            (vendas || []).map(function (v) {
                return {
                    id: v.id,
                    data_venda: v.data_venda,
                    valor_total: Number(v.valor_total || 0),
                    desconto: Number(v.desconto || 0),
                    forma_pagamento: v.forma_pagamento,
                    status: v.status,
                    caixa_id: v.caixa_id,
                    funcionario: v.Funcionario ? v.Funcionario.nome : '',
                    itens: (v.ItemVendas || []).map(function (i) {
                        return {
                            nome: i.Produto ? i.Produto.nome : '',
                            quantidade: Number(i.quantidade || 0),
                            preco_unitario: Number(i.preco_unitario || 0),
                            subtotal: Number(i.subtotal || 0)
                        };
                    })
                };
            })
        ) %>;

        window.__CAIXA__ = <%- JSON.stringify(EstadoCaixa || {}) %>;
        window.__UTILIZADOR__ = '<%= utilizador %>';
    </script>

    <!-- ============================================================
         APLICAÇÃO
         ============================================================ -->
    <script>
        /* ============================================================
           CONSTANTES / ESTADO
           ============================================================ */
        const VENDAS = Array.isArray(window.__VENDAS__) ? window.__VENDAS__ : [];
        const CAIXA = window.__CAIXA__ || {};
        const UTILIZADOR = window.__UTILIZADOR__ || 'Operador';

        const FORMAS = {
            'dinheiro': 'Dinheiro',
            'Tpa': 'TPA (Multicaixa)',
            'transferencia': 'Transferência'
        };

        const FORMAS_ICON = {
            'dinheiro': 'fa-money-bill-wave',
            'Tpa': 'fa-credit-card',
            'transferencia': 'fa-university'
        };

        const STATUS = {
            'pendente': 'Pendente',
            'concluida': 'Concluída',
            'cancelada': 'Cancelada'
        };

        let filtros = {
            dataInicio: '',
            dataFim: '',
            forma: '',
            status: ''
        };

        let tabAtiva = 'vendas';
        let canalEnvio = 'relatorio'; // qual relatório está a ser enviado

        /* ============================================================
           UTILITÁRIOS
           ============================================================ */
        function formatKz(valor) {
            const n = Number(valor || 0);
            return n.toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
        }

        function formatDataHora(iso) {
            const d = new Date(iso);
            if (isNaN(d.getTime())) return '—';
            return d.toLocaleString('pt-AO', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });
        }

        function formatDataCurta(iso) {
            const d = new Date(iso);
            if (isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('pt-AO');
        }

        function escaparHtml(txt) {
            const div = document.createElement('div');
            div.textContent = txt == null ? '' : String(txt);
            return div.innerHTML;
        }

        function mostrarToast(mensagem, tipo = 'info', duracao = 3800) {
            const container = document.getElementById('toast-container');
            if (!container) { alert(mensagem); return; }

            const icones = {
                success: 'fa-check-circle',
                error: 'fa-exclamation-circle',
                info: 'fa-info-circle'
            };

            const toast = document.createElement('div');
            toast.className = 'toast ' + tipo;
            toast.innerHTML = '<i class="fas ' + (icones[tipo] || icones.info) + '"></i><span></span>';
            toast.querySelector('span').textContent = mensagem;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.transition = 'all .3s ease';
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(30px)';
                setTimeout(() => toast.remove(), 300);
            }, duracao);
        }

        function alternarLoading(botao, ativo, texto) {
            if (!botao) return;
            if (ativo) {
                if (!botao.dataset.htmlOriginal) botao.dataset.htmlOriginal = botao.innerHTML;
                botao.disabled = true;
                botao.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + (texto || 'A processar...');
            } else {
                botao.disabled = false;
                if (botao.dataset.htmlOriginal) botao.innerHTML = botao.dataset.htmlOriginal;
            }
        }

        function hojeISO() {
            const d = new Date();
            return d.getFullYear() + '-' +
                String(d.getMonth() + 1).padStart(2, '0') + '-' +
                String(d.getDate()).padStart(2, '0');
        }

        /* ============================================================
           FILTRAGEM
           ============================================================ */
        function vendasFiltradas() {
            return VENDAS.filter(v => {
                const d = new Date(v.data_venda);

                if (filtros.dataInicio) {
                    const ini = new Date(filtros.dataInicio + 'T00:00:00');
                    if (d < ini) return false;
                }
                if (filtros.dataFim) {
                    const fim = new Date(filtros.dataFim + 'T23:59:59');
                    if (d > fim) return false;
                }
                if (filtros.forma && v.forma_pagamento !== filtros.forma) return false;
                if (filtros.status && v.status !== filtros.status) return false;

                return true;
            }).sort((a, b) => new Date(b.data_venda) - new Date(a.data_venda));
        }

        function textoPeriodo() {
            const ini = filtros.dataInicio ? formatDataCurta(filtros.dataInicio + 'T00:00:00') : 'Início';
            const fim = filtros.dataFim ? formatDataCurta(filtros.dataFim + 'T00:00:00') : 'Hoje';
            if (!filtros.dataInicio && !filtros.dataFim) return 'Todo o período';
            return ini + ' a ' + fim;
        }

        function aplicarFiltros() {
            filtros.dataInicio = document.getElementById('dataInicio').value;
            filtros.dataFim = document.getElementById('dataFim').value;
            filtros.forma = document.getElementById('filtroForma').value;
            filtros.status = document.getElementById('filtroStatus').value;

            renderTudo();
            mostrarToast('Filtros aplicados.', 'info', 2200);
        }

        function limparFiltros() {
            document.getElementById('dataInicio').value = '';
            document.getElementById('dataFim').value = '';
            document.getElementById('filtroForma').value = '';
            document.getElementById('filtroStatus').value = '';

            filtros = { dataInicio: '', dataFim: '', forma: '', status: '' };
            renderTudo();
            mostrarToast('Filtros limpos.', 'info', 2000);
        }

        function aplicarPreset(preset) {
            const hoje = new Date();
            let ini = null, fim = null;

            const setIni = (d) => {
                ini = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            };
            const setFim = (d) => {
                fim = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            };

            if (preset === 'hoje') {
                setIni(hoje); setFim(hoje);
            } else if (preset === 'ontem') {
                const o = new Date(hoje); o.setDate(o.getDate() - 1);
                setIni(o); setFim(o);
            } else if (preset === 'semana') {
                const d = new Date(hoje);
                const dia = d.getDay(); // 0=Dom
                const diff = (dia === 0 ? 6 : dia - 1);
                const seg = new Date(d); seg.setDate(d.getDate() - diff);
                setIni(seg); setFim(hoje);
            } else if (preset === 'mes') {
                const primeiro = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
                setIni(primeiro); setFim(hoje);
            } else if (preset === 'ano') {
                const primeiro = new Date(hoje.getFullYear(), 0, 1);
                setIni(primeiro); setFim(hoje);
            } else {
                // todos
                document.getElementById('dataInicio').value = '';
                document.getElementById('dataFim').value = '';
                filtros.dataInicio = '';
                filtros.dataFim = '';
                renderTudo();
                return;
            }

            document.getElementById('dataInicio').value = ini;
            document.getElementById('dataFim').value = fim;
            filtros.dataInicio = ini;
            filtros.dataFim = fim;
            renderTudo();
        }

        /* ============================================================
           AGREGAÇÕES
           ============================================================ */
        function calcularResumo(lista) {
            const resumo = {
                total: 0,
                desconto: 0,
                totalLiquido: 0,
                count: 0,
                porForma: {},
                porStatus: { concluida: 0, pendente: 0, cancelada: 0 },
                produtos: {}
            };

            lista.forEach(v => {
                const total = Number(v.valor_total || 0);
                const desc = Number(v.desconto || 0);

                resumo.total += total;
                resumo.desconto += desc;
                resumo.totalLiquido += Math.max(0, total - desc);
                resumo.count += 1;

                const forma = v.forma_pagamento || 'outro';
                if (!resumo.porForma[forma]) {
                    resumo.porForma[forma] = { count: 0, total: 0, liquido: 0 };
                }
                resumo.porForma[forma].count += 1;
                resumo.porForma[forma].total += total;
                resumo.porForma[forma].liquido += Math.max(0, total - desc);

                if (resumo.porStatus[v.status] !== undefined) {
                    resumo.porStatus[v.status] += 1;
                }

                (v.itens || []).forEach(item => {
                    const nome = item.nome || '—';
                    if (!resumo.produtos[nome]) {
                        resumo.produtos[nome] = { qtd: 0, receita: 0 };
                    }
                    resumo.produtos[nome].qtd += Number(item.quantidade || 0);
                    resumo.produtos[nome].receita += Number(item.subtotal || 0);
                });
            });

            resumo.ticketMedio = resumo.count ? resumo.totalLiquido / resumo.count : 0;
            return resumo;
        }

