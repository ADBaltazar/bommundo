        /* ============================================================
           RENDER: MÉTODOS DE PAGAMENTO
           ============================================================ */
        function renderPagamentos() {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);

            document.getElementById('pagPeriodoLabel').textContent = textoPeriodo();
            document.getElementById('phPagPeriodo').textContent = textoPeriodo();
            document.getElementById('phPagEmitido').textContent = new Date().toLocaleString('pt-AO');
            document.getElementById('phPagFooterData').textContent = new Date().toLocaleString('pt-AO');

            // Constrói lista de métodos
            const metodos = Object.entries(resumo.porForma)
                .map(([chave, dados]) => ({
                    chave,
                    nome: FORMAS[chave] || chave,
                    ...dados
                }))
                .sort((a, b) => b.total - a.total);

            const totalGeral = metodos.reduce((s, m) => s + m.total, 0);

            // KPI
            const metodoPrincipal = metodos[0];
            document.getElementById('pagSummary').innerHTML = `
                <div class="summary-card dark">
                    <span class="summary-label"><i class="fas fa-coins"></i> Total Recebido</span>
                    <span class="summary-value">${formatKz(totalGeral)}</span>
                    <span class="summary-sub">${resumo.count} transações</span>
                </div>
                <div class="summary-card blue">
                    <span class="summary-label"><i class="fas fa-star"></i> Método Principal</span>
                    <span class="summary-value" style="font-size:18px;">${metodoPrincipal ? escaparHtml(metodoPrincipal.nome) : '—'}</span>
                    <span class="summary-sub">${metodoPrincipal ? formatKz(metodoPrincipal.total) + ' · ' + ((metodoPrincipal.total / totalGeral) * 100).toFixed(1) + '%' : 'Sem dados'}</span>
                </div>
                <div class="summary-card orange">
                    <span class="summary-label"><i class="fas fa-receipt"></i> Ticket Médio</span>
                    <span class="summary-value">${formatKz(resumo.ticketMedio)}</span>
                    <span class="summary-sub">Por venda</span>
                </div>
                <div class="summary-card green">
                    <span class="summary-label"><i class="fas fa-check-circle"></i> Total Líquido</span>
                    <span class="summary-value">${formatKz(resumo.totalLiquido)}</span>
                    <span class="summary-sub">Após descontos</span>
                </div>
            `;

            // Barras
            if (!metodos.length) {
                document.getElementById('pagList').innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-credit-card"></i>
                        Sem dados de pagamentos no período.
                    </div>`;
            } else {
                document.getElementById('pagList').innerHTML = metodos.map(m => {
                    const pct = totalGeral > 0 ? (m.total / totalGeral) * 100 : 0;
                    const icon = FORMAS_ICON[m.chave] || 'fa-money-bill';
                    const iconClass = ['dinheiro', 'Tpa', 'transferencia'].includes(m.chave) ? m.chave : 'outro';
                    return `
                        <div class="pay-item">
                            <div class="pay-item-label">
                                <span class="pay-icon ${iconClass}"><i class="fas ${icon}"></i></span>
                                ${escaparHtml(m.nome)}
                            </div>
                            <div class="pay-bar">
                                <div class="pay-bar-fill ${iconClass}" style="width:${pct.toFixed(2)}%;"></div>
                            </div>
                            <div class="pay-item-value">
                                ${formatKz(m.total)}
                                <small>${pct.toFixed(1)}% · ${m.count} vendas</small>
                            </div>
                        </div>`;
                }).join('');
            }

            // Tabela detalhada
            const tbody = document.getElementById('pagTbody');
            if (!metodos.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center empty-state"><i class="fas fa-inbox"></i>Sem dados.</td></tr>`;
                document.getElementById('pagTfoot').innerHTML = '';
            } else {
                tbody.innerHTML = metodos.map(m => {
                    const pct = totalGeral > 0 ? (m.total / totalGeral) * 100 : 0;
                    const ticket = m.count > 0 ? m.total / m.count : 0;
                    return `
                        <tr>
                            <td><strong>${escaparHtml(m.nome)}</strong></td>
                            <td class="text-center">${m.count}</td>
                            <td class="text-end">${formatKz(m.total)}</td>
                            <td class="text-end">${pct.toFixed(1)}%</td>
                            <td class="text-end">${formatKz(ticket)}</td>
                        </tr>`;
                }).join('');

                document.getElementById('pagTfoot').innerHTML = `
                    <tr>
                        <td>TOTAL</td>
                        <td class="text-center">${resumo.count}</td>
                        <td class="text-end">${formatKz(totalGeral)}</td>
                        <td class="text-end">100%</td>
                        <td class="text-end">${formatKz(resumo.ticketMedio)}</td>
                    </tr>`;
            }
        }

        /* ============================================================
           RENDER GLOBAL
           ============================================================ */
        function renderTudo() {
            renderVendas();
            renderCaixa();
            renderRelatorio();
            renderPagamentos();
        }

        /* ============================================================
           TABS
           ============================================================ */
        function mudarTab(nome) {
            tabAtiva = nome;
            document.querySelectorAll('.tab').forEach(t => {
                t.classList.toggle('active', t.dataset.tab === nome);
            });
            document.querySelectorAll('.tab-panel').forEach(p => {
                p.classList.toggle('active', p.id === 'panel-' + nome);
            });
        }

        /* ============================================================
           IMPRESSÃO
           ============================================================ */
        function imprimirRelatorio() {
            const titulos = {
                vendas: 'Vendas',
                caixa: 'Relatório de Caixa',
                relatorio: 'Relatório de Vendas',
                pagamentos: 'Métodos de Pagamento'
            };
            const tituloOriginal = document.title;
            document.title = 'Bom Mundo - ' + (titulos[tabAtiva] || 'Relatório');
            window.print();
            document.title = tituloOriginal;
        }

        /* ============================================================
           PDF
           ============================================================ */
        function elementoDoRelatorio(tipo) {
            const mapa = {
                caixa: 'caixaReport',
                relatorio: 'relatorioReport',
                pagamentos: 'pagamentosReport'
            };
            return document.getElementById(mapa[tipo] || 'relatorioReport');
        }

        function construirPdf(tipo) {
            const elemento = elementoDoRelatorio(tipo);
            const nomes = {
                caixa: 'Relatorio_Caixa',
                relatorio: 'Relatorio_Vendas',
                pagamentos: 'Metodos_Pagamento'
            };
            const nomeBase = nomes[tipo] || 'Relatorio';
            const data = new Date().toISOString().slice(0, 10);

            return html2pdf().set({
                margin: [10, 10, 12, 10],
                filename: nomeBase + '_' + data + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                    scale: 2,
                    useCORS: true,
                    backgroundColor: '#ffffff',
                    scrollX: 0,
                    scrollY: 0
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: ['css', 'legacy'] }
            }).from(elemento);
        }

        async function baixarPDF(tipo) {
            if (typeof html2pdf === 'undefined') {
                mostrarToast('Gerador de PDF não carregado. Verifique a ligação à internet.', 'error');
                return;
            }

            const botoes = document.querySelectorAll('[onclick*="baixarPDF"]');
            botoes.forEach(b => alternarLoading(b, true, 'A gerar...'));

            try {
                await construirPdf(tipo).save();
                mostrarToast('PDF gerado com sucesso!', 'success');
            } catch (erro) {
                console.error('Erro ao gerar PDF:', erro);
                mostrarToast('Não foi possível gerar o PDF.', 'error');
            } finally {
                botoes.forEach(b => alternarLoading(b, false));
            }
        }

        /* ============================================================
           CSV
           ============================================================ */
        function baixarCSV(tipo) {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);
            let linhas = [];
            let nome = '';

            const sep = ';';

            if (tipo === 'caixa') {
                nome = 'Relatorio_Caixa';
                linhas.push(['BOM MUNDO - RELATÓRIO DE CAIXA']);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push(['Caixa', CAIXA.id ? ('#00' + CAIXA.id) : '—']);
                linhas.push(['Estado do caixa', CAIXA.status === 'aberto' ? 'Aberto' : 'Fechado']);
                linhas.push([]);
                linhas.push(['Resumo']);
                linhas.push(['Total líquido', resumo.totalLiquido.toFixed(2)]);
                linhas.push(['Total bruto', resumo.total.toFixed(2)]);
                linhas.push(['Descontos', resumo.desconto.toFixed(2)]);
                linhas.push(['Nº vendas', resumo.count]);
                linhas.push(['Ticket médio', resumo.ticketMedio.toFixed(2)]);
                linhas.push([]);
                linhas.push(['#', 'Data/Hora', 'Forma Pagamento', 'Estado', 'Total (Kz)']);
                lista.forEach((v, i) => {
                    linhas.push([
                        i + 1,
                        formatDataHora(v.data_venda),
                        FORMAS[v.forma_pagamento] || v.forma_pagamento || '',
                        STATUS[v.status] || v.status || '',
                        Math.max(0, v.valor_total - v.desconto).toFixed(2)
                    ]);
                });
            } else if (tipo === 'pagamentos') {
                nome = 'Metodos_Pagamento';
                const totalGeral = Object.values(resumo.porForma).reduce((s, m) => s + m.total, 0);

                linhas.push(['BOM MUNDO - MÉTODOS DE PAGAMENTO']);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push([]);
                linhas.push(['Método', 'Nº Transações', 'Total (Kz)', '% do Total', 'Ticket Médio (Kz)']);
                Object.entries(resumo.porForma).forEach(([chave, dados]) => {
                    const pct = totalGeral > 0 ? (dados.total / totalGeral) * 100 : 0;
                    const ticket = dados.count > 0 ? dados.total / dados.count : 0;
                    linhas.push([
                        FORMAS[chave] || chave,
                        dados.count,
                        dados.total.toFixed(2),
                        pct.toFixed(1) + '%',
                        ticket.toFixed(2)
                    ]);
                });
                linhas.push([]);
                linhas.push(['TOTAL', resumo.count, totalGeral.toFixed(2), '100%', resumo.ticketMedio.toFixed(2)]);
            } else {
                nome = 'Relatorio_Vendas';
                linhas.push(['BOM MUNDO - RELATÓRIO DE VENDAS']);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push([]);
                linhas.push(['Resumo']);
                linhas.push(['Total bruto', resumo.total.toFixed(2)]);
                linhas.push(['Total líquido', resumo.totalLiquido.toFixed(2)]);
                linhas.push(['Descontos', resumo.desconto.toFixed(2)]);
                linhas.push(['Nº vendas', resumo.count]);
                linhas.push(['Ticket médio', resumo.ticketMedio.toFixed(2)]);
                linhas.push([]);
                linhas.push(['#', 'Data/Hora', 'Funcionário', 'Forma Pagamento', 'Estado', 'Desconto (Kz)', 'Total (Kz)']);
                lista.forEach((v, i) => {
                    linhas.push([
                        i + 1,
                        formatDataHora(v.data_venda),
                        v.funcionario || '',
                        FORMAS[v.forma_pagamento] || v.forma_pagamento || '',
                        STATUS[v.status] || v.status || '',
                        Number(v.desconto || 0).toFixed(2),
                        Math.max(0, v.valor_total - v.desconto).toFixed(2)
                    ]);
                });
                linhas.push([]);
                linhas.push(['Produtos Vendidos']);
                linhas.push(['Produto', 'Qtd', 'Receita (Kz)']);
                Object.entries(resumo.produtos)
                    .sort((a, b) => b[1].receita - a[1].receita)
                    .forEach(([nomeProd, d]) => {
                        linhas.push([nomeProd, d.qtd, d.receita.toFixed(2)]);
                    });
            }

            const csv = '\uFEFF' + linhas.map(l =>
                l.map(c => {
                    const s = String(c == null ? '' : c);
                    return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
                }).join(sep)
            ).join('\r\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = nome + '_' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            mostrarToast('Ficheiro CSV descarregado.', 'success');
        }

        /* ============================================================
           MENSAGEM DE TEXTO (WhatsApp / Email)
           ============================================================ */
        function construirMensagem(tipo) {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);
            const periodo = textoPeriodo();
            const dataEmissao = new Date().toLocaleString('pt-AO');

            let titulo = '';
            if (tipo === 'caixa') titulo = 'RELATÓRIO DE CAIXA';
            else if (tipo === 'pagamentos') titulo = 'MÉTODOS DE PAGAMENTO';
            else titulo = 'RELATÓRIO DE VENDAS';

            let texto = '';
            texto += '*BOM MUNDO* — ' + titulo + '\n';
            texto += 'Período: ' + periodo + '\n';
            texto += 'Operador: ' + UTILIZADOR + '\n';
            texto += 'Emitido em: ' + dataEmissao + '\n';
            texto += '--------------------------------\n';

            if (tipo === 'caixa') {
                texto += '*Total líquido:* ' + formatKz(resumo.totalLiquido) + '\n';
                texto += '*Total bruto:* ' + formatKz(resumo.total) + '\n';
                texto += '*Descontos:* ' + formatKz(resumo.desconto) + '\n';
                texto += '*Nº de vendas:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                texto += '*Por método de pagamento:*\n';
                Object.entries(resumo.porForma).forEach(([chave, d]) => {
                    texto += '• ' + (FORMAS[chave] || chave) + ': ' + formatKz(d.total) + ' (' + d.count + ')\n';
                });
            } else if (tipo === 'pagamentos') {
                const totalGeral = Object.values(resumo.porForma).reduce((s, m) => s + m.total, 0);
                texto += '*Total recebido:* ' + formatKz(totalGeral) + '\n';
                texto += '*Nº de transações:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                Object.entries(resumo.porForma)
                    .sort((a, b) => b[1].total - a[1].total)
                    .forEach(([chave, d]) => {
                        const pct = totalGeral > 0 ? (d.total / totalGeral) * 100 : 0;
                        texto += '• ' + (FORMAS[chave] || chave) + ': ' + formatKz(d.total) +
                            ' (' + pct.toFixed(1) + '%, ' + d.count + ' vendas)\n';
                    });
            } else {
                texto += '*Total bruto:* ' + formatKz(resumo.total) + '\n';
                texto += '*Total líquido:* ' + formatKz(resumo.totalLiquido) + '\n';
                texto += '*Descontos:* ' + formatKz(resumo.desconto) + '\n';
                texto += '*Nº de vendas:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                texto += '*Top produtos:*\n';
                Object.entries(resumo.produtos)
                    .sort((a, b) => b[1].receita - a[1].receita)
                    .slice(0, 5)
                    .forEach(([nome, d]) => {
                        texto += '• ' + nome + ': ' + d.qtd + ' un · ' + formatKz(d.receita) + '\n';
                    });
            }

            texto += '--------------------------------\n';
            texto += 'Sistema Bom Mundo';
            return texto;
        }

        /* ============================================================
           WHATSAPP
           ============================================================ */
        function abrirModalWhatsApp(tipo) {
            canalEnvio = tipo;
            document.getElementById('whatsappPreview').textContent = construirMensagem(tipo);
            document.getElementById('whatsappNumero').value = '';
            document.getElementById('whatsappModal').classList.add('open');
            setTimeout(() => document.getElementById('whatsappNumero').focus(), 50);
        }

        function fecharModalWhatsApp() {
            document.getElementById('whatsappModal').classList.remove('open');
        }

        function enviarWhatsAppForm(evento) {
            evento.preventDefault();

            const numero = document.getElementById('whatsappNumero').value.replace(/\D/g, '');
            const mensagem = document.getElementById('whatsappPreview').textContent;

            const url = numero
                ? 'https://wa.me/' + numero + '?text=' + encodeURIComponent(mensagem)
                : 'https://wa.me/?text=' + encodeURIComponent(mensagem);

            window.open(url, '_blank');
            fecharModalWhatsApp();
            mostrarToast('WhatsApp aberto com o relatório.', 'success');
        }

        /* ============================================================
           EMAIL
           ============================================================ */
        function abrirModalEmail(tipo) {
            canalEnvio = tipo;

            const assuntos = {
                caixa: 'Relatório de Caixa - Bom Mundo',
                relatorio: 'Relatório de Vendas - Bom Mundo',
                pagamentos: 'Métodos de Pagamento - Bom Mundo'
            };

            document.getElementById('emailAssunto').value = assuntos[tipo] || 'Relatório - Bom Mundo';
            document.getElementById('emailMensagem').value = construirMensagem(tipo);
            document.getElementById('emailDestinatario').value = '';
            document.getElementById('emailAnexoPdf').checked = true;
            document.getElementById('emailModal').classList.add('open');
            setTimeout(() => document.getElementById('emailDestinatario').focus(), 50);
        }

        function fecharModalEmail() {
            document.getElementById('emailModal').classList.remove('open');
            const form = document.getElementById('emailForm');
            if (form) form.reset();
        }

        function pdfParaBase64(tipo) {
            return construirPdf(tipo)
                .outputPdf('datauristring')
                .then((dataUri) => {
                    const i = dataUri.indexOf(',');
                    return i >= 0 ? dataUri.slice(i + 1) : dataUri;
                });
        }

        async function enviarEmailForm(evento) {
            evento.preventDefault();

            const destinatario = document.getElementById('emailDestinatario').value.trim();
            const assunto = document.getElementById('emailAssunto').value.trim();
            const mensagem = document.getElementById('emailMensagem').value.trim();
            const anexarPdf = document.getElementById('emailAnexoPdf').checked;
            const btn = document.getElementById('btnEnviarEmailConfirmar');

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(destinatario)) {
                mostrarToast('Introduza um endereço de email válido.', 'error');
                return;
            }

            alternarLoading(btn, true, 'A enviar...');

            try {
                const payload = {
                    email: destinatario,
                    assunto: assunto,
                    mensagem: mensagem,
                    tipoRelatorio: canalEnvio,
                    periodo: textoPeriodo(),
                    anexarPdf: anexarPdf
                };

                if (anexarPdf) {
                    payload.pdfNome = 'Relatorio_' + canalEnvio + '_' + new Date().toISOString().slice(0, 10) + '.pdf';
                    payload.pdfBase64 = await pdfParaBase64(canalEnvio);
                }

                const resposta = await fetch('/vendas/relatorio/enviar-email', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                let dados = {};
                try { dados = await resposta.json(); } catch (e) { /* resposta sem JSON */ }

                if (!resposta.ok) {
                    throw new Error(dados.erro || 'Falha ao enviar o email (HTTP ' + resposta.status + ').');
                }

                mostrarToast('Relatório enviado para ' + destinatario, 'success');
                fecharModalEmail();

            } catch (erro) {
                console.error('Erro ao enviar email:', erro);
                mostrarToast(erro.message || 'Não foi possível enviar o relatório por email.', 'error');
            } finally {
                alternarLoading(btn, false);
            }
        }

        /* ============================================================
           INICIALIZAÇÃO
           ============================================================ */
        document.addEventListener('DOMContentLoaded', function () {

            // Tabs
            document.querySelectorAll('.tab').forEach(t => {
                t.addEventListener('click', () => mudarTab(t.dataset.tab));
            });

            // Presets
            document.querySelectorAll('.preset-chip').forEach(chip => {
                chip.addEventListener('click', () => aplicarPreset(chip.dataset.preset));
            });

            // Pesquisa livre (filtra a tabela de vendas)
            const searchInput = document.getElementById('searchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function (e) {
                    const termo = e.target.value.toLowerCase().trim();
                    const linhas = document.querySelectorAll('#tbodyVendas tr');

                    linhas.forEach(tr => {
                        if (tr.querySelector('.empty-state')) return;
                        const texto = tr.textContent.toLowerCase();
                        tr.style.display = (!termo || texto.includes(termo)) ? '' : 'none';
                    });
                });
            }

            // Notificações
            const notification = document.getElementById('notificationBtn');
            if (notification) {
                notification.addEventListener('click', () => {
                    mostrarToast('Você tem 3 notificações não lidas.', 'info');
                });
            }

            // Fechar modais com ESC
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    fecharModalEmail();
                    fecharModalWhatsApp();
                }
            });

            // Atalhos: Ctrl+P (imprimir) e Ctrl+Shift+S (guardar PDF do relatório ativo)
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'p') {
                    // deixa o browser tratar, mas garante o título
                }
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    if (tabAtiva !== 'vendas') baixarPDF(tabAtiva);
                }
            });

            // Render inicial
            renderTudo();
        });
    </script>
</body>
</html>