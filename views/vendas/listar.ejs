<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
window.__VENDAS__ = <%- JSON.stringify(
  (vendas || []).map(function (v) {
    return {
      id: v.id,
      data_venda: v.data_venda,
      valor_total: Number(v.valor_total || 0),
      desconto: Number(v.desconto || 0),
      forma_pagamento: v.forma_pagamento,
      status: v.status,
      caixa_id: v.caixa_id,
      funcionario: v.Funcionario ? v.Funcionario.nome : '',
      itens: (v.ItemVendas || []).map(function (i) {
        return {
          nome: i.Produto ? i.Produto.nome : '',
          quantidade: Number(i.quantidade || 0),
          preco_unitario: Number(i.preco_unitario || 0),
          subtotal: Number(i.subtotal || 0)
        };
      })
    };
  })
) %>;
window.__CAIXA__ = <%- JSON.stringify(EstadoCaixa || {}) %>;
window.__UTILIZADOR__ = '<%= utilizador %>';
</script>

<script>
const VENDAS = Array.isArray(window.__VENDAS__) ? window.__VENDAS__ : [];
const CAIXA = window.__CAIXA__ || {};
const UTILIZADOR = window.__UTILIZADOR__ || 'Operador';

const FORMAS = { dinheiro: 'Dinheiro', Tpa: 'TPA (Multicaixa)', transferencia: 'Transferência' };
const STATUS = { pendente: 'Pendente', concluida: 'Concluída', cancelada: 'Cancelada' };

const DOC_CONFIG = {
  caixa:      { panel: 'panel-caixa',      container: 'caixaReport',      placeholder: 'caixaPlaceholder',      btnGerar: 'btnGerarCaixa' },
  relatorio:  { panel: 'panel-relatorio',  container: 'relatorioReport',  placeholder: 'relatorioPlaceholder',  btnGerar: 'btnGerarRelatorio' },
  pagamentos: { panel: 'panel-pagamentos', container: 'pagamentosReport', placeholder: 'pagamentosPlaceholder', btnGerar: 'btnGerarPagamentos' },
  fecho:      { panel: 'panel-fecho',      container: 'fechoReport',      placeholder: 'fechoPlaceholder',      btnGerar: 'btnGerarFecho' }
};

const docVisivel = { caixa: false, relatorio: false, pagamentos: false, fecho: false };
let filtros = { dataInicio: '', dataFim: '', forma: '', status: '' };
let tabAtiva = 'vendas';
let canalEnvio = 'relatorio';
let sortKey = 'data_venda';
let sortDir = 'desc';
let currentPage = 1;
let perPage = 25;
let tableSearch = '';
const expandedRows = new Set();
const selectedRows = new Set();

function formatKz(v) {
  const n = Number(v || 0);
  return n.toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
}
function formatDataHora(iso) {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleString('pt-AO', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function formatDataCurta(iso) {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('pt-AO');
}
function escaparHtml(txt) {
  const div = document.createElement('div');
  div.textContent = txt == null ? '' : String(txt);
  return div.innerHTML;
}
function gerarNumeroDoc(prefixo) {
  const seq = String(Math.floor(Math.random() * 99999)).padStart(5, '0');
  return prefixo + ' ' + new Date().getFullYear() + '/' + seq;
}

// Devolve HTML com ponto colorido + nome do método
function renderPayMethod(chave) {
  const nome = FORMAS[chave] || chave || '—';
  const cls = (chave || '').toLowerCase();
  return `<span class="pay-method pay-${escaparHtml(cls)}">${escaparHtml(nome)}</span>`;
}

function gerarDocumento(tipo) {
  const cfg = DOC_CONFIG[tipo];
  if (!cfg) return;
  if (tabAtiva !== tipo) mudarTab(tipo);
  renderTudo();
  docVisivel[tipo] = true;
  document.getElementById(cfg.container).classList.add('documento-visivel');
  const ph = document.getElementById(cfg.placeholder);
  if (ph) ph.style.display = 'none';
  const panel = document.getElementById(cfg.panel);
  if (panel) panel.querySelectorAll('.export-btn').forEach(b => b.disabled = false);
  const btn = document.getElementById(cfg.btnGerar);
  if (btn) btn.innerHTML = '<i class="fas fa-rotate"></i> Actualizar documento';
  setTimeout(() => {
    const c = document.getElementById(cfg.container);
    if (c) c.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
}

function exigirDocumento(tipo) {
  if (!docVisivel[tipo]) { alert('Gere primeiro o documento.'); return false; }
  return true;
}

function vendasFiltradas() {
  return VENDAS.filter(v => {
    const d = new Date(v.data_venda);
    if (filtros.dataInicio && d < new Date(filtros.dataInicio + 'T00:00:00')) return false;
    if (filtros.dataFim && d > new Date(filtros.dataFim + 'T23:59:59')) return false;
    if (filtros.forma && v.forma_pagamento !== filtros.forma) return false;
    if (filtros.status && v.status !== filtros.status) return false;
    return true;
  });
}

function textoPeriodo() {
  if (!filtros.dataInicio && !filtros.dataFim) return 'Todo o período';
  const ini = filtros.dataInicio ? formatDataCurta(filtros.dataInicio + 'T00:00:00') : 'Início';
  const fim = filtros.dataFim ? formatDataCurta(filtros.dataFim + 'T00:00:00') : 'Hoje';
  return ini + ' a ' + fim;
}

function aplicarFiltros() {
  filtros.dataInicio = document.getElementById('dataInicio').value;
  filtros.dataFim = document.getElementById('dataFim').value;
  filtros.forma = document.getElementById('filtroForma').value;
  filtros.status = document.getElementById('filtroStatus').value;
  currentPage = 1; selectedRows.clear(); renderTudo();
}
function limparFiltros() {
  ['dataInicio','dataFim','filtroForma','filtroStatus'].forEach(id => document.getElementById(id).value = '');
  filtros = { dataInicio: '', dataFim: '', forma: '', status: '' };
  currentPage = 1; selectedRows.clear(); renderTudo();
}
function aplicarPreset(preset) {
  const hoje = new Date();
  let ini = null, fim = null;
  const fmt = (d) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  if (preset === 'hoje') { ini = fmt(hoje); fim = fmt(hoje); }
  else if (preset === 'ontem') { const o = new Date(hoje); o.setDate(o.getDate() - 1); ini = fmt(o); fim = fmt(o); }
  else if (preset === 'semana') {
    const d = new Date(hoje), dia = d.getDay(), diff = (dia === 0 ? 6 : dia - 1);
    const seg = new Date(d); seg.setDate(d.getDate() - diff);
    ini = fmt(seg); fim = fmt(hoje);
  }
  else if (preset === 'mes') { ini = fmt(new Date(hoje.getFullYear(), hoje.getMonth(), 1)); fim = fmt(hoje); }
  else if (preset === 'ano') { ini = fmt(new Date(hoje.getFullYear(), 0, 1)); fim = fmt(hoje); }
  else {
    document.getElementById('dataInicio').value = '';
    document.getElementById('dataFim').value = '';
    filtros.dataInicio = ''; filtros.dataFim = '';
    currentPage = 1; renderTudo(); return;
  }
  document.getElementById('dataInicio').value = ini;
  document.getElementById('dataFim').value = fim;
  filtros.dataInicio = ini; filtros.dataFim = fim;
  currentPage = 1; renderTudo();
}

function calcularResumo(lista) {
  const r = { total: 0, desconto: 0, totalLiquido: 0, count: 0, porForma: {}, porStatus: { concluida: 0, pendente: 0, cancelada: 0 }, produtos: {} };
  lista.forEach(v => {
    const total = Number(v.valor_total || 0);
    const desc = Number(v.desconto || 0);
    r.total += total; r.desconto += desc; r.totalLiquido += Math.max(0, total - desc); r.count += 1;
    const forma = v.forma_pagamento || 'outro';
    if (!r.porForma[forma]) r.porForma[forma] = { count: 0, total: 0, liquido: 0 };
    r.porForma[forma].count += 1;
    r.porForma[forma].total += total;
    r.porForma[forma].liquido += Math.max(0, total - desc);
    if (r.porStatus[v.status] !== undefined) r.porStatus[v.status] += 1;
    (v.itens || []).forEach(item => {
      const nome = item.nome || '—';
      if (!r.produtos[nome]) r.produtos[nome] = { qtd: 0, receita: 0 };
      r.produtos[nome].qtd += Number(item.quantidade || 0);
      r.produtos[nome].receita += Number(item.subtotal || 0);
    });
  });
  r.ticketMedio = r.count ? r.totalLiquido / r.count : 0;
  return r;
}

function renderVendasSummary() {
  const r = calcularResumo(vendasFiltradas());
  const pct = r.count ? ((r.porStatus.concluida / r.count) * 100).toFixed(1) : 0;
  const pendCls = r.porStatus.pendente > 0 ? ' kpi-warning' : '';
  document.getElementById('vendasSummary').innerHTML = `
    <div class="kpi kpi-primary"><span class="kpi-label">Total líquido</span><span class="kpi-value">${formatKz(r.totalLiquido)}</span><span class="kpi-sub">${r.count} vendas · bruto ${formatKz(r.total)}</span></div>
    <div class="kpi"><span class="kpi-label">Ticket médio</span><span class="kpi-value">${formatKz(r.ticketMedio)}</span></div>
    <div class="kpi"><span class="kpi-label">Concluídas</span><span class="kpi-value">${r.porStatus.concluida}</span><span class="kpi-sub">${pct}% do total</span></div>
    <div class="kpi${pendCls}"><span class="kpi-label">Pendentes</span><span class="kpi-value">${r.porStatus.pendente}</span></div>
    <div class="kpi"><span class="kpi-label">Descontos</span><span class="kpi-value">${formatKz(r.desconto)}</span></div>`;
}

function getVendasTabela() {
  let lista = vendasFiltradas();
  if (tableSearch) {
    const t = tableSearch.toLowerCase();
    lista = lista.filter(v =>
      String(v.id).includes(t) ||
      (v.funcionario || '').toLowerCase().includes(t) ||
      (FORMAS[v.forma_pagamento] || '').toLowerCase().includes(t) ||
      (STATUS[v.status] || '').toLowerCase().includes(t)
    );
  }
  lista.sort((a, b) => {
    let va, vb;
    switch (sortKey) {
      case 'id': va = Number(a.id); vb = Number(b.id); break;
      case 'data_venda': va = new Date(a.data_venda).getTime(); vb = new Date(b.data_venda).getTime(); break;
      case 'valor': va = Math.max(0, a.valor_total - a.desconto); vb = Math.max(0, b.valor_total - b.desconto); break;
      case 'itens': va = (a.itens || []).length; vb = (b.itens || []).length; break;
      case 'forma_pagamento': va = FORMAS[a.forma_pagamento] || a.forma_pagamento || ''; vb = FORMAS[b.forma_pagamento] || b.forma_pagamento || ''; break;
      case 'status': va = a.status || ''; vb = b.status || ''; break;
      default: va = a.id; vb = b.id;
    }
    if (typeof va === 'string') { const c = va.localeCompare(vb); return sortDir === 'asc' ? c : -c; }
    return sortDir === 'asc' ? va - vb : vb - va;
  });
  return lista;
}

function renderVendas() {
  renderVendasSummary();
  const tbody = document.getElementById('tbodyVendas');
  const listaCompleta = getVendasTabela();
  const total = listaCompleta.length;
  const totalPaginas = Math.max(1, Math.ceil(total / perPage));
  if (currentPage > totalPaginas) currentPage = totalPaginas;
  const inicio = (currentPage - 1) * perPage;
  const fim = Math.min(inicio + perPage, total);
  const pagina = listaCompleta.slice(inicio, fim);

  document.getElementById('paginationInfo').textContent = total === 0
    ? 'Sem resultados'
    : `Mostrando ${inicio + 1}–${fim} de ${total} vendas`;
  renderPagination(totalPaginas);

  document.querySelectorAll('.data-table th.sortable').forEach(th => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    const icone = th.querySelector('.sort-indicator i');
    if (th.dataset.sort === sortKey) {
      th.classList.add(sortDir === 'asc' ? 'sorted-asc' : 'sorted-desc');
      icone.className = sortDir === 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down';
    } else {
      icone.className = 'fas fa-sort';
    }
  });

  if (!pagina.length) {
    tbody.innerHTML = `<tr><td colspan="10" class="empty-cell"><i class="fas fa-inbox"></i>Sem registos neste período.</td></tr>`;
    atualizarSelectionInfo(); return;
  }

  tbody.innerHTML = pagina.map(v => {
    const liquido = Math.max(0, Number(v.valor_total) - Number(v.desconto));
    const numItens = (v.itens || []).length;
    const expandido = expandedRows.has(v.id);
    const selecionado = selectedRows.has(v.id);
    const cancelada = v.status === 'cancelada';

    const linhaPrincipal = `
      <tr data-id="${v.id}" class="${selecionado ? 'is-selected' : ''}">
        <td class="no-print"><input type="checkbox" class="table-select row-checkbox" data-id="${v.id}" ${selecionado ? 'checked' : ''}></td>
        <td class="no-print"><button type="button" class="row-expand-btn ${expandido ? 'expanded' : ''}" data-expand-id="${v.id}" onclick="toggleExpand(${v.id})"><i class="fas fa-chevron-right"></i></button></td>
        <td><strong>#${v.id}</strong></td>
        <td>${escaparHtml(formatDataHora(v.data_venda))}</td>
        <td>${escaparHtml(v.funcionario || '—')}</td>
        <td class="text-center">${numItens}</td>
        <td>${renderPayMethod(v.forma_pagamento)}</td>
        <td><span class="status-badge status-${escaparHtml(v.status || 'pendente')}">${escaparHtml(STATUS[v.status] || v.status || '—')}</span></td>
        <td class="text-end"><strong>${formatKz(liquido)}</strong></td>
        <td class="no-print">
          <div style="display:flex; gap:4px;">
            <a href="/vendas/${v.id}" class="btn btn-outline btn-sm">Ver</a>
            <a href="/vendas/cancelar/${v.id}" class="btn btn-outline btn-sm ${cancelada ? 'text-muted' : 'text-danger'}" ${cancelada ? 'style="pointer-events:none;"' : ''} onclick="return confirm('Cancelar a venda #${v.id}?');">Cancelar</a>
          </div>
        </td>
      </tr>`;

    const linhaExpandida = `
      <tr class="expanded-row" data-expanded-for="${v.id}" ${expandido ? '' : 'hidden'}>
        <td colspan="10">
          <div class="expanded-content">
            <div class="expanded-title">Itens da venda <strong>#${v.id}</strong> · ${numItens} produto(s)</div>
            ${renderItensVenda(v)}
          </div>
        </td>
      </tr>`;

    return linhaPrincipal + linhaExpandida;
  }).join('');

  const selectAll = document.getElementById('selectAllCheckbox');
  if (selectAll) {
    const ids = pagina.map(v => v.id);
    const todos = ids.length > 0 && ids.every(id => selectedRows.has(id));
    const alguns = ids.some(id => selectedRows.has(id));
    selectAll.checked = todos;
    selectAll.indeterminate = !todos && alguns;
  }
  atualizarSelectionInfo();
}

function renderItensVenda(v) {
  if (!v.itens || !v.itens.length) return `<p class="text-muted" style="font-size:13px;">Sem itens registados.</p>`;
  const sub = v.itens.reduce((s, i) => s + Number(i.subtotal || 0), 0);
  const desc = Number(v.desconto || 0);
  const total = Math.max(0, sub - desc);
  return `
    <table class="expanded-items-table">
      <thead><tr><th>Produto</th><th class="text-center">Qtd.</th><th class="text-end">Preço unit.</th><th class="text-end">Subtotal</th></tr></thead>
      <tbody>${v.itens.map(i => `<tr><td>${escaparHtml(i.nome || '—')}</td><td class="text-center">${i.quantidade}</td><td class="text-end">${formatKz(i.preco_unitario)}</td><td class="text-end">${formatKz(i.subtotal)}</td></tr>`).join('')}</tbody>
      <tfoot>
        <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">${formatKz(sub)}</td></tr>
        ${desc > 0 ? `<tr><td colspan="3" class="text-end text-danger">Desconto</td><td class="text-end text-danger">- ${formatKz(desc)}</td></tr>` : ''}
        <tr><td colspan="3" class="text-end">Total</td><td class="text-end">${formatKz(total)}</td></tr>
      </tfoot>
    </table>`;
}

function renderPagination(totalPaginas) {
  const container = document.getElementById('paginationControls');
  if (totalPaginas <= 1) { container.innerHTML = ''; return; }
  const b = [];
  b.push(`<button class="page-btn" ${currentPage === 1 ? 'disabled' : ''} onclick="irParaPagina(${currentPage - 1})">‹</button>`);
  const paginas = new Set([1, totalPaginas]);
  for (let p = currentPage - 2; p <= currentPage + 2; p++) if (p >= 1 && p <= totalPaginas) paginas.add(p);
  const ord = Array.from(paginas).sort((a, b) => a - b);
  let ant = 0;
  ord.forEach(p => {
    if (ant && p - ant > 1) b.push(`<span style="padding:0 4px;color:var(--fg-muted);">…</span>`);
    b.push(`<button class="page-btn ${p === currentPage ? 'active' : ''}" onclick="irParaPagina(${p})">${p}</button>`);
    ant = p;
  });
  b.push(`<button class="page-btn" ${currentPage === totalPaginas ? 'disabled' : ''} onclick="irParaPagina(${currentPage + 1})">›</button>`);
  container.innerHTML = b.join('');
}

function irParaPagina(p) { currentPage = p; renderVendas(); }

// Toggle sem re-render: mantém animação fluida
function toggleExpand(id) {
  if (expandedRows.has(id)) expandedRows.delete(id);
  else expandedRows.add(id);

  const row = document.querySelector(`tr[data-expanded-for="${id}"]`);
  const btn = document.querySelector(`.row-expand-btn[data-expand-id="${id}"]`);

  if (row) {
    if (expandedRows.has(id)) {
      row.removeAttribute('hidden');
      const content = row.querySelector('.expanded-content');
      if (content) {
        content.style.animation = 'none';
        void content.offsetWidth;
        content.style.animation = '';
      }
    } else {
      row.setAttribute('hidden', '');
    }
  }
  if (btn) btn.classList.toggle('expanded', expandedRows.has(id));
}

function expandirTodas() {
  getVendasTabela().forEach(v => expandedRows.add(v.id));
  document.getElementById('btnExpandAll').style.display = 'none';
  document.getElementById('btnCollapseAll').style.display = '';
  renderVendas();
}
function recolherTodas() {
  expandedRows.clear();
  document.getElementById('btnExpandAll').style.display = '';
  document.getElementById('btnCollapseAll').style.display = 'none';
  renderVendas();
}
function atualizarSelectionInfo() {
  const info = document.getElementById('selectionInfo');
  if (!info) return;
  info.textContent = selectedRows.size === 0 ? '' : selectedRows.size + ' selecionada(s)';
}

function renderResumoTable(id, linhas) {
  const t = document.getElementById(id);
  if (!t) return;
  t.innerHTML = linhas.map(l =>
    `<tr${l.destaque ? ' class="destaque"' : ''}><td class="resumo-key">${escaparHtml(l.label)}</td><td class="resumo-val">${l.valor}</td></tr>`
  ).join('');
}

function renderDocPagamentos(id, r) {
  const t = document.getElementById(id);
  if (!t) return;
  const m = Object.entries(r.porForma).sort((a, b) => b[1].total - a[1].total);
  const total = m.reduce((s, [, x]) => s + x.total, 0);
  if (!m.length) {
    t.innerHTML = `<div style="padding:12px;color:var(--fg-muted);font-size:12px;">Sem movimentos.</div>`;
    return;
  }
  t.innerHTML = m.map(([k, d]) => {
    const pct = total > 0 ? (d.total / total) * 100 : 0;
    return `<div class="pag-linha"><span>${renderPayMethod(k)}</span><span><span class="pag-valor">${formatKz(d.total)}</span><span class="pag-pct">${pct.toFixed(1)}% · ${d.count}</span></span></div>`;
  }).join('');
}

