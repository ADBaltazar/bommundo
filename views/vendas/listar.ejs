        /* Render: Métodos de Pagamento */
        function renderPagamentos() {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);

            document.getElementById('pagPeriodoLabel').textContent = textoPeriodo();
            document.getElementById('phPagDocNum').textContent = gerarNumeroDoc('MP');
            document.getElementById('phPagPeriodo').textContent = textoPeriodo();
            document.getElementById('phPagEmitido').textContent = new Date().toLocaleString('pt-AO');
            document.getElementById('phPagNumTransacoes').textContent = resumo.count;
            document.getElementById('phPagTicketMedio').textContent = formatKz(resumo.ticketMedio);
            document.getElementById('phPagTotalRecebido').textContent = formatKz(resumo.totalLiquido);
            document.getElementById('phPagFooterData').textContent = new Date().toLocaleString('pt-AO');

            const metodos = Object.entries(resumo.porForma).map(([chave, dados]) => ({ chave, nome: FORMAS[chave] || chave, ...dados })).sort((a, b) => b.total - a.total);
            const totalGeral = metodos.reduce((s, m) => s + m.total, 0);

            const linhasResumo = [
                { label: 'Total Recebido', valor: formatKz(totalGeral), destaque: true },
                { label: 'Nº de Transações', valor: resumo.count },
                { label: 'Ticket Médio', valor: formatKz(resumo.ticketMedio) }
            ];
            metodos.forEach(m => {
                const pct = totalGeral > 0 ? (m.total / totalGeral) * 100 : 0;
                linhasResumo.push({
                    label: m.nome + ' (' + m.count + ' vendas · ' + pct.toFixed(1) + '%)',
                    valor: formatKz(m.total)
                });
            });
            renderResumoTable('pagResumoTable', linhasResumo);

            const tbody = document.getElementById('pagTbody');
            if (!metodos.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center empty-state"><i class="fas fa-inbox"></i>Sem dados.</td></tr>`;
                document.getElementById('pagTfoot').innerHTML = '';
            } else {
                tbody.innerHTML = metodos.map(m => {
                    const pct = totalGeral > 0 ? (m.total / totalGeral) * 100 : 0;
                    const ticket = m.count > 0 ? m.total / m.count : 0;
                    return `<tr>
                        <td><strong>${escaparHtml(m.nome)}</strong></td>
                        <td class="text-center">${m.count}</td>
                        <td class="text-end">${formatKz(m.total)}</td>
                        <td class="text-end">${pct.toFixed(1)}%</td>
                        <td class="text-end">${formatKz(ticket)}</td>
                    </tr>`;
                }).join('');
                document.getElementById('pagTfoot').innerHTML = `
                    <tr>
                        <td>TOTAL</td>
                        <td class="text-center">${resumo.count}</td>
                        <td class="text-end">${formatKz(totalGeral)}</td>
                        <td class="text-end">100%</td>
                        <td class="text-end">${formatKz(resumo.ticketMedio)}</td>
                    </tr>`;
            }
        }

        /* Render: Fecho de Caixa */
        function renderFecho() {
            const lista = vendasFiltradas().sort((a, b) => new Date(b.data_venda) - new Date(a.data_venda));
            const resumo = calcularResumo(lista);

            document.getElementById('fechoPeriodoLabel').textContent = textoPeriodo();
            document.getElementById('phFechoDocNum').textContent = gerarNumeroDoc('FC');
            document.getElementById('phFechoPeriodo').textContent = textoPeriodo();
            document.getElementById('phFechoEmitido').textContent = new Date().toLocaleString('pt-AO');
            document.getElementById('phFechoNumero').textContent = CAIXA.id ? ('#00' + CAIXA.id) : '—';
            document.getElementById('phFechoEstadoInline').innerHTML = CAIXA.status === 'aberto'
                ? '<span class="doc-status-box aberto">Aberto</span>'
                : '<span class="doc-status-box fechado">Fechado</span>';
            document.getElementById('phFechoAbertura').textContent = CAIXA.data_abertura ? formatDataHora(CAIXA.data_abertura) : '—';
            document.getElementById('phFechoFecho').textContent = CAIXA.data_fecho ? formatDataHora(CAIXA.data_fecho) : (CAIXA.status === 'aberto' ? 'Em curso' : '—');
            document.getElementById('phFechoNumVendas').textContent = resumo.count;
            document.getElementById('phFechoTicketMedio').textContent = formatKz(resumo.ticketMedio);
            document.getElementById('phFechoFooterData').textContent = new Date().toLocaleString('pt-AO');

            const dinheiro = resumo.porForma['dinheiro'] || { total: 0, count: 0 };
            const tpa = resumo.porForma['Tpa'] || { total: 0, count: 0 };
            const transf = resumo.porForma['transferencia'] || { total: 0, count: 0 };

            renderResumoTable('fechoResumoTable', [
                { label: 'Total Bruto', valor: formatKz(resumo.total) },
                { label: 'Descontos Concedidos', valor: '<span class="text-danger">- ' + formatKz(resumo.desconto) + '</span>' },
                { label: 'Total Líquido', valor: formatKz(resumo.totalLiquido), destaque: true },
                { label: 'Nº de Vendas Registadas', valor: resumo.count },
                { label: 'Ticket Médio por Venda', valor: formatKz(resumo.ticketMedio) },
                { label: 'Dinheiro (' + dinheiro.count + ' vendas)', valor: formatKz(dinheiro.total) },
                { label: 'TPA / Multicaixa (' + tpa.count + ' vendas)', valor: formatKz(tpa.total) },
                { label: 'Transferência (' + transf.count + ' vendas)', valor: formatKz(transf.total) }
            ]);

            document.getElementById('phFechoVendasCount').textContent =
                lista.length + (lista.length === 1 ? ' venda' : ' vendas');

            const tbody = document.getElementById('fechoTbody');
            if (!lista.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center empty-state"><i class="fas fa-inbox"></i>Sem vendas no período.</td></tr>`;
                document.getElementById('fechoTfoot').innerHTML = '';
            } else {
                tbody.innerHTML = lista.map((v, i) => {
                    const liquido = Math.max(0, Number(v.valor_total) - Number(v.desconto));
                    return `<tr>
                        <td>${i + 1}</td>
                        <td>${escaparHtml(formatDataHora(v.data_venda))}</td>
                        <td>${escaparHtml(FORMAS[v.forma_pagamento] || v.forma_pagamento || '—')}</td>
                        <td><span class="status-badge status-${escaparHtml(v.status || 'pendente')}">${escaparHtml(STATUS[v.status] || v.status || '—')}</span></td>
                        <td class="text-end">${formatKz(liquido)}</td>
                    </tr>`;
                }).join('');
                document.getElementById('fechoTfoot').innerHTML = `
                    <tr>
                        <td colspan="4" class="text-end">TOTAL GERAL</td>
                        <td class="text-end">${formatKz(resumo.totalLiquido)}</td>
                    </tr>`;
            }

            renderDocPagamentos('fechoPagamentosPrint', resumo);
            document.getElementById('phFechoTotalBruto').textContent = formatKz(resumo.total);
            document.getElementById('phFechoDescontos').textContent = '- ' + formatKz(resumo.desconto);
            document.getElementById('phFechoTotalLiquido').textContent = formatKz(resumo.totalLiquido);
            document.getElementById('phFechoSaldoDeclaracao').textContent = formatKz(resumo.totalLiquido);
        }

        function renderTudo() {
            renderVendas();
            renderCaixa();
            renderRelatorio();
            renderPagamentos();
            renderFecho();
        }

        function mudarTab(nome) {
            tabAtiva = nome;
            document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === nome));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + nome));
        }

        function imprimirRelatorio() {
            if (!exigirDocumento(tabAtiva)) return;
            const titulos = {
                caixa: 'Relatório de Caixa',
                relatorio: 'Relatório de Vendas',
                pagamentos: 'Métodos de Pagamento',
                fecho: 'Fecho de Caixa'
            };
            const tituloOriginal = document.title;
            document.title = 'Bom Mundo - ' + (titulos[tabAtiva] || 'Documento');
            window.print();
            document.title = tituloOriginal;
        }

        function elementoDoRelatorio(tipo) {
            const mapa = { caixa: 'caixaReport', relatorio: 'relatorioReport', pagamentos: 'pagamentosReport', fecho: 'fechoReport' };
            const container = document.getElementById(mapa[tipo]);
            return container ? container.querySelector('.documento') : null;
        }

        function construirPdf(tipo) {
            const elemento = elementoDoRelatorio(tipo);
            if (!elemento) throw new Error('Documento não encontrado.');
            const nomes = { caixa: 'Relatorio_Caixa', relatorio: 'Relatorio_Vendas', pagamentos: 'Metodos_Pagamento', fecho: 'Fecho_Caixa' };
            const nomeBase = nomes[tipo] || 'Documento';
            const data = new Date().toISOString().slice(0, 10);
            return html2pdf().set({
                margin: [12, 10, 14, 10],
                filename: nomeBase + '_' + data + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', scrollX: 0, scrollY: 0 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: ['css', 'legacy'] }
            }).from(elemento);
        }

        async function baixarPDF(tipo) {
            if (!exigirDocumento(tipo)) return;
            if (typeof html2pdf === 'undefined') { mostrarToast('Gerador de PDF não carregado.', 'error'); return; }
            const panel = document.getElementById(DOC_CONFIG[tipo].panel);
            const botoes = panel ? panel.querySelectorAll('.export-btn') : [];
            botoes.forEach(b => alternarLoading(b, true, 'A gerar...'));
            try {
                await construirPdf(tipo).save();
                mostrarToast('PDF gerado com sucesso!', 'success');
            } catch (erro) {
                console.error('Erro ao gerar PDF:', erro);
                mostrarToast('Não foi possível gerar o PDF.', 'error');
            } finally {
                botoes.forEach(b => alternarLoading(b, false));
            }
        }

        function baixarCSV(tipo) {
            if (!exigirDocumento(tipo)) return;
            const lista = vendasFiltradas().sort((a, b) => new Date(b.data_venda) - new Date(a.data_venda));
            const resumo = calcularResumo(lista);
            let linhas = [];
            let nome = '';
            const sep = ';';

            if (tipo === 'caixa' || tipo === 'fecho') {
                nome = tipo === 'fecho' ? 'Fecho_Caixa' : 'Relatorio_Caixa';
                linhas.push(['BOM MUNDO - ' + (tipo === 'fecho' ? 'FECHO DE CAIXA' : 'RELATÓRIO DE CAIXA')]);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push(['Caixa', CAIXA.id ? ('#00' + CAIXA.id) : '—']);
                linhas.push(['Estado do caixa', CAIXA.status === 'aberto' ? 'Aberto' : 'Fechado']);
                linhas.push([]);
                linhas.push(['Resumo']);
                linhas.push(['Total líquido', resumo.totalLiquido.toFixed(2)]);
                linhas.push(['Total bruto', resumo.total.toFixed(2)]);
                linhas.push(['Descontos', resumo.desconto.toFixed(2)]);
                linhas.push(['Nº vendas', resumo.count]);
                linhas.push(['Ticket médio', resumo.ticketMedio.toFixed(2)]);
                linhas.push([]);
                linhas.push(['#', 'Data/Hora', 'Forma Pagamento', 'Estado', 'Total (Kz)']);
                lista.forEach((v, i) => {
                    linhas.push([i + 1, formatDataHora(v.data_venda),
                        FORMAS[v.forma_pagamento] || v.forma_pagamento || '',
                        STATUS[v.status] || v.status || '',
                        Math.max(0, v.valor_total - v.desconto).toFixed(2)]);
                });
            } else if (tipo === 'pagamentos') {
                nome = 'Metodos_Pagamento';
                const totalGeral = Object.values(resumo.porForma).reduce((s, m) => s + m.total, 0);
                linhas.push(['BOM MUNDO - MÉTODOS DE PAGAMENTO']);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push([]);
                linhas.push(['Método', 'Nº Transações', 'Total (Kz)', '% do Total', 'Ticket Médio (Kz)']);
                Object.entries(resumo.porForma).forEach(([chave, dados]) => {
                    const pct = totalGeral > 0 ? (dados.total / totalGeral) * 100 : 0;
                    const ticket = dados.count > 0 ? dados.total / dados.count : 0;
                    linhas.push([FORMAS[chave] || chave, dados.count, dados.total.toFixed(2), pct.toFixed(1) + '%', ticket.toFixed(2)]);
                });
                linhas.push([]);
                linhas.push(['TOTAL', resumo.count, totalGeral.toFixed(2), '100%', resumo.ticketMedio.toFixed(2)]);
            } else {
                nome = 'Relatorio_Vendas';
                linhas.push(['BOM MUNDO - RELATÓRIO DE VENDAS']);
                linhas.push(['Período', textoPeriodo()]);
                linhas.push(['Operador', UTILIZADOR]);
                linhas.push([]);
                linhas.push(['Resumo']);
                linhas.push(['Total bruto', resumo.total.toFixed(2)]);
                linhas.push(['Total líquido', resumo.totalLiquido.toFixed(2)]);
                linhas.push(['Descontos', resumo.desconto.toFixed(2)]);
                linhas.push(['Nº vendas', resumo.count]);
                linhas.push(['Ticket médio', resumo.ticketMedio.toFixed(2)]);
                linhas.push([]);
                linhas.push(['#', 'Data/Hora', 'Funcionário', 'Forma Pagamento', 'Estado', 'Desconto (Kz)', 'Total (Kz)']);
                lista.forEach((v, i) => {
                    linhas.push([i + 1, formatDataHora(v.data_venda), v.funcionario || '',
                        FORMAS[v.forma_pagamento] || v.forma_pagamento || '',
                        STATUS[v.status] || v.status || '',
                        Number(v.desconto || 0).toFixed(2),
                        Math.max(0, v.valor_total - v.desconto).toFixed(2)]);
                });
                linhas.push([]);
                linhas.push(['Produtos Vendidos']);
                linhas.push(['Produto', 'Qtd', 'Receita (Kz)']);
                Object.entries(resumo.produtos).sort((a, b) => b[1].receita - a[1].receita)
                    .forEach(([nomeProd, d]) => linhas.push([nomeProd, d.qtd, d.receita.toFixed(2)]));
            }

            const csv = '\uFEFF' + linhas.map(l =>
                l.map(c => {
                    const s = String(c == null ? '' : c);
                    return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
                }).join(sep)
            ).join('\r\n');

            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = nome + '_' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            mostrarToast('Ficheiro CSV descarregado.', 'success');
        }

        function construirMensagem(tipo) {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);
            const periodo = textoPeriodo();
            const dataEmissao = new Date().toLocaleString('pt-AO');
            let titulo = tipo === 'caixa' ? 'RELATÓRIO DE CAIXA'
                       : tipo === 'pagamentos' ? 'MÉTODOS DE PAGAMENTO'
                       : tipo === 'fecho' ? 'FECHO DE CAIXA'
                       : 'RELATÓRIO DE VENDAS';
            let texto = '';
            texto += '*BOM MUNDO* — ' + titulo + '\n';
            texto += 'Período: ' + periodo + '\n';
            texto += 'Operador: ' + UTILIZADOR + '\n';
            texto += 'Emitido em: ' + dataEmissao + '\n';
            texto += '--------------------------------\n';
            if (tipo === 'caixa' || tipo === 'fecho') {
                texto += '*Total líquido:* ' + formatKz(resumo.totalLiquido) + '\n';
                texto += '*Total bruto:* ' + formatKz(resumo.total) + '\n';
                texto += '*Descontos:* ' + formatKz(resumo.desconto) + '\n';
                texto += '*Nº de vendas:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                texto += '*Por método de pagamento:*\n';
                Object.entries(resumo.porForma).forEach(([chave, d]) => {
                    texto += '• ' + (FORMAS[chave] || chave) + ': ' + formatKz(d.total) + ' (' + d.count + ')\n';
                });
            } else if (tipo === 'pagamentos') {
                const totalGeral = Object.values(resumo.porForma).reduce((s, m) => s + m.total, 0);
                texto += '*Total recebido:* ' + formatKz(totalGeral) + '\n';
                texto += '*Nº de transações:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                Object.entries(resumo.porForma).sort((a, b) => b[1].total - a[1].total)
                    .forEach(([chave, d]) => {
                        const pct = totalGeral > 0 ? (d.total / totalGeral) * 100 : 0;
                        texto += '• ' + (FORMAS[chave] || chave) + ': ' + formatKz(d.total) + ' (' + pct.toFixed(1) + '%, ' + d.count + ' vendas)\n';
                    });
            } else {
                texto += '*Total bruto:* ' + formatKz(resumo.total) + '\n';
                texto += '*Total líquido:* ' + formatKz(resumo.totalLiquido) + '\n';
                texto += '*Descontos:* ' + formatKz(resumo.desconto) + '\n';
                texto += '*Nº de vendas:* ' + resumo.count + '\n';
                texto += '*Ticket médio:* ' + formatKz(resumo.ticketMedio) + '\n';
                texto += '--------------------------------\n';
                texto += '*Top produtos:*\n';
                Object.entries(resumo.produtos).sort((a, b) => b[1].receita - a[1].receita).slice(0, 5)
                    .forEach(([nome, d]) => {
                        texto += '• ' + nome + ': ' + d.qtd + ' un · ' + formatKz(d.receita) + '\n';
                    });
            }
            texto += '--------------------------------\n';
            texto += 'Sistema Bom Mundo';
            return texto;
        }

        function abrirModalWhatsApp(tipo) {
            if (!exigirDocumento(tipo)) return;
            canalEnvio = tipo;
            document.getElementById('whatsappPreview').textContent = construirMensagem(tipo);
            document.getElementById('whatsappNumero').value = '';
            document.getElementById('whatsappModal').classList.add('open');
            setTimeout(() => document.getElementById('whatsappNumero').focus(), 50);
        }

        function fecharModalWhatsApp() { document.getElementById('whatsappModal').classList.remove('open'); }

        function enviarWhatsAppForm(evento) {
            evento.preventDefault();
            const numero = document.getElementById('whatsappNumero').value.replace(/\D/g, '');
            const mensagem = document.getElementById('whatsappPreview').textContent;
            const url = numero
                ? 'https://wa.me/' + numero + '?text=' + encodeURIComponent(mensagem)
                : 'https://wa.me/?text=' + encodeURIComponent(mensagem);
            window.open(url, '_blank');
            fecharModalWhatsApp();
            mostrarToast('WhatsApp aberto com o relatório.', 'success');
        }

        function abrirModalEmail(tipo) {
            if (!exigirDocumento(tipo)) return;
            canalEnvio = tipo;
            const assuntos = {
                caixa: 'Relatório de Caixa - Bom Mundo',
                relatorio: 'Relatório de Vendas - Bom Mundo',
                pagamentos: 'Métodos de Pagamento - Bom Mundo',
                fecho: 'Fecho de Caixa - Bom Mundo'
            };
            document.getElementById('emailAssunto').value = assuntos[tipo] || 'Documento - Bom Mundo';
            document.getElementById('emailMensagem').value = construirMensagem(tipo);
            document.getElementById('emailDestinatario').value = '';
            document.getElementById('emailAnexoPdf').checked = true;
            document.getElementById('emailModal').classList.add('open');
            setTimeout(() => document.getElementById('emailDestinatario').focus(), 50);
        }

        function fecharModalEmail() {
            document.getElementById('emailModal').classList.remove('open');
            const form = document.getElementById('emailForm');
            if (form) form.reset();
        }

        function pdfParaBase64(tipo) {
            return construirPdf(tipo).outputPdf('datauristring').then((dataUri) => {
                const i = dataUri.indexOf(',');
                return i >= 0 ? dataUri.slice(i + 1) : dataUri;
            });
        }

        async function enviarEmailForm(evento) {
            evento.preventDefault();
            const destinatario = document.getElementById('emailDestinatario').value.trim();
            const assunto = document.getElementById('emailAssunto').value.trim();
            const mensagem = document.getElementById('emailMensagem').value.trim();
            const anexarPdf = document.getElementById('emailAnexoPdf').checked;
            const btn = document.getElementById('btnEnviarEmailConfirmar');

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(destinatario)) {
                mostrarToast('Introduza um endereço de email válido.', 'error');
                return;
            }

            alternarLoading(btn, true, 'A enviar...');
            try {
                const payload = { email: destinatario, assunto, mensagem, tipoRelatorio: canalEnvio, periodo: textoPeriodo(), anexarPdf };
                if (anexarPdf) {
                    payload.pdfNome = 'Documento_' + canalEnvio + '_' + new Date().toISOString().slice(0, 10) + '.pdf';
                    payload.pdfBase64 = await pdfParaBase64(canalEnvio);
                }
                const resposta = await fetch('/vendas/relatorio/enviar-email', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                let dados = {};
                try { dados = await resposta.json(); } catch (e) {}
                if (!resposta.ok) throw new Error(dados.erro || 'Falha ao enviar o email (HTTP ' + resposta.status + ').');
                mostrarToast('Documento enviado para ' + destinatario, 'success');
                fecharModalEmail();
            } catch (erro) {
                console.error('Erro ao enviar email:', erro);
                mostrarToast(erro.message || 'Não foi possível enviar o documento por email.', 'error');
            } finally {
                alternarLoading(btn, false);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => mudarTab(t.dataset.tab)));
            document.querySelectorAll('.preset-chip').forEach(chip => chip.addEventListener('click', () => aplicarPreset(chip.dataset.preset)));

            const globalSearch = document.getElementById('globalSearch');
            if (globalSearch) {
                globalSearch.addEventListener('input', function (e) {
                    document.getElementById('tableSearch').value = e.target.value;
                    tableSearch = e.target.value.toLowerCase().trim();
                    currentPage = 1;
                    renderVendas();
                });
            }

            const tableSearchEl = document.getElementById('tableSearch');
            if (tableSearchEl) {
                tableSearchEl.addEventListener('input', function (e) {
                    tableSearch = e.target.value.toLowerCase().trim();
                    currentPage = 1;
                    renderVendas();
                });
            }

            const perPageEl = document.getElementById('perPageSelect');
            if (perPageEl) {
                perPageEl.addEventListener('change', function () {
                    perPage = parseInt(this.value, 10) || 25;
                    currentPage = 1;
                    renderVendas();
                });
            }

            document.querySelectorAll('.data-table th.sortable').forEach(th => {
                th.addEventListener('click', () => {
                    const key = th.dataset.sort;
                    if (sortKey === key) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
                    else { sortKey = key; sortDir = 'asc'; }
                    currentPage = 1;
                    renderVendas();
                });
            });

            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    const lista = getVendasTabela();
                    const totalPaginas = Math.max(1, Math.ceil(lista.length / perPage));
                    if (currentPage > totalPaginas) currentPage = totalPaginas;
                    const inicio = (currentPage - 1) * perPage;
                    const fim = Math.min(inicio + perPage, lista.length);
                    const pagina = lista.slice(inicio, fim);
                    pagina.forEach(v => { if (this.checked) selectedRows.add(v.id); else selectedRows.delete(v.id); });
                    renderVendas();
                });
            }

            document.getElementById('tbodyVendas').addEventListener('change', function (e) {
                if (e.target.classList.contains('row-checkbox')) {
                    const id = parseInt(e.target.dataset.id, 10);
                    if (e.target.checked) selectedRows.add(id);
                    else selectedRows.delete(id);
                    renderVendas();
                }
            });

            const notification = document.getElementById('notificationBtn');
            if (notification) notification.addEventListener('click', () => mostrarToast('Você tem 3 notificações não lidas.', 'info'));

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { fecharModalEmail(); fecharModalWhatsApp(); }
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    if (tabAtiva !== 'vendas' && docVisivel[tabAtiva]) baixarPDF(tabAtiva);
                }
            });

            renderTudo();
        });
    </script>
</body>
</html>