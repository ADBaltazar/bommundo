        <td><span class="status-badge status-${escaparHtml(v.status || 'pendente')}">${escaparHtml(STATUS[v.status] || v.status || '—')}</span></td>
        <td class="text-end">${formatKz(liq)}</td>
      </tr>`;
    }).join('');
    document.getElementById('fechoTfoot').innerHTML = `<tr><td colspan="4" class="text-end">Total</td><td class="text-end">${formatKz(r.totalLiquido)}</td></tr>`;
  }
  renderDocPagamentos('fechoPagamentosPrint', r);
  document.getElementById('phFechoTotalBruto').textContent = formatKz(r.total);
  document.getElementById('phFechoDescontos').textContent = '- ' + formatKz(r.desconto);
  document.getElementById('phFechoTotalLiquido').textContent = formatKz(r.totalLiquido);
  document.getElementById('phFechoSaldoDeclaracao').textContent = formatKz(r.totalLiquido);
}

function renderTudo() { renderVendas(); renderCaixa(); renderRelatorio(); renderPagamentos(); renderFecho(); }

function mudarTab(nome) {
  tabAtiva = nome;
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.tab === nome));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + nome));
}

function imprimirRelatorio() { if (!exigirDocumento(tabAtiva)) return; window.print(); }

function elementoDoRelatorio(tipo) {
  const mapa = { caixa: 'caixaReport', relatorio: 'relatorioReport', pagamentos: 'pagamentosReport', fecho: 'fechoReport' };
  const c = document.getElementById(mapa[tipo]);
  return c ? c.querySelector('.documento') : null;
}

function construirPdf(tipo) {
  const el = elementoDoRelatorio(tipo);
  if (!el) throw new Error('Documento não encontrado.');
  const nomes = { caixa: 'Relatorio_Caixa', relatorio: 'Relatorio_Vendas', pagamentos: 'Metodos_Pagamento', fecho: 'Fecho_Caixa' };
  return html2pdf().set({
    margin: [12, 10, 14, 10],
    filename: (nomes[tipo] || 'Documento') + '_' + new Date().toISOString().slice(0, 10) + '.pdf',
    image: { type: 'jpeg', quality: 0.98 },
    html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', scrollX: 0, scrollY: 0 },
    jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
    pagebreak: { mode: ['css', 'legacy'] }
  }).from(el);
}

async function baixarPDF(tipo) {
  if (!exigirDocumento(tipo)) return;
  if (typeof html2pdf === 'undefined') { alert('Gerador de PDF não carregado.'); return; }
  const panel = document.getElementById(DOC_CONFIG[tipo].panel);
  const btns = panel.querySelectorAll('.export-btn');
  const orig = new Map();
  btns.forEach(b => { orig.set(b, b.innerHTML); b.disabled = true; });
  const pdfBtn = panel.querySelector('.export-btn[data-export="pdf"]');
  if (pdfBtn) pdfBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A gerar…';
  try {
    await construirPdf(tipo).save();
  } catch (e) {
    console.error(e);
    alert('Não foi possível gerar o PDF.');
  } finally {
    btns.forEach(b => { b.disabled = false; b.innerHTML = orig.get(b); });
  }
}

function baixarCSV(tipo) {
  if (!exigirDocumento(tipo)) return;
  const lista = vendasFiltradas().sort((a, b) => new Date(b.data_venda) - new Date(a.data_venda));
  const r = calcularResumo(lista);
  let linhas = [], nome = '';
  const sep = ';';

  if (tipo === 'caixa' || tipo === 'fecho') {
    nome = tipo === 'fecho' ? 'Fecho_Caixa' : 'Relatorio_Caixa';
    linhas.push(['BOM MUNDO - ' + (tipo === 'fecho' ? 'FECHO DE CAIXA' : 'RELATÓRIO DE CAIXA')]);
    linhas.push(['Período', textoPeriodo()]);
    linhas.push(['Operador', UTILIZADOR]);
    linhas.push(['Caixa', CAIXA.id ? ('#00' + CAIXA.id) : '—']);
    linhas.push([]);
    linhas.push(['Total líquido', r.totalLiquido.toFixed(2)]);
    linhas.push(['Total bruto', r.total.toFixed(2)]);
    linhas.push(['Descontos', r.desconto.toFixed(2)]);
    linhas.push(['Nº vendas', r.count]);
    linhas.push(['Ticket médio', r.ticketMedio.toFixed(2)]);
    linhas.push([]);
    linhas.push(['#', 'Data/Hora', 'Forma Pagamento', 'Estado', 'Total (Kz)']);
    lista.forEach((v, i) => linhas.push([i + 1, formatDataHora(v.data_venda), FORMAS[v.forma_pagamento] || v.forma_pagamento || '', STATUS[v.status] || v.status || '', Math.max(0, v.valor_total - v.desconto).toFixed(2)]));
  } else if (tipo === 'pagamentos') {
    nome = 'Metodos_Pagamento';
    const total = Object.values(r.porForma).reduce((s, x) => s + x.total, 0);
    linhas.push(['BOM MUNDO - MÉTODOS DE PAGAMENTO']);
    linhas.push(['Período', textoPeriodo()]);
    linhas.push(['Operador', UTILIZADOR]);
    linhas.push([]);
    linhas.push(['Método', 'Nº Transações', 'Total (Kz)', '% do Total', 'Ticket Médio (Kz)']);
    Object.entries(r.porForma).forEach(([k, d]) => {
      const pct = total > 0 ? (d.total / total) * 100 : 0;
      const tk = d.count > 0 ? d.total / d.count : 0;
      linhas.push([FORMAS[k] || k, d.count, d.total.toFixed(2), pct.toFixed(1) + '%', tk.toFixed(2)]);
    });
    linhas.push([]);
    linhas.push(['TOTAL', r.count, total.toFixed(2), '100%', r.ticketMedio.toFixed(2)]);
  } else {
    nome = 'Relatorio_Vendas';
    linhas.push(['BOM MUNDO - RELATÓRIO DE VENDAS']);
    linhas.push(['Período', textoPeriodo()]);
    linhas.push(['Operador', UTILIZADOR]);
    linhas.push([]);
    linhas.push(['Total bruto', r.total.toFixed(2)]);
    linhas.push(['Total líquido', r.totalLiquido.toFixed(2)]);
    linhas.push(['Descontos', r.desconto.toFixed(2)]);
    linhas.push(['Nº vendas', r.count]);
    linhas.push(['Ticket médio', r.ticketMedio.toFixed(2)]);
    linhas.push([]);
    linhas.push(['#', 'Data/Hora', 'Funcionário', 'Forma Pagamento', 'Estado', 'Desconto (Kz)', 'Total (Kz)']);
    lista.forEach((v, i) => linhas.push([i + 1, formatDataHora(v.data_venda), v.funcionario || '', FORMAS[v.forma_pagamento] || v.forma_pagamento || '', STATUS[v.status] || v.status || '', Number(v.desconto || 0).toFixed(2), Math.max(0, v.valor_total - v.desconto).toFixed(2)]));
    linhas.push([]);
    linhas.push(['Produtos Vendidos']);
    linhas.push(['Produto', 'Qtd', 'Receita (Kz)']);
    Object.entries(r.produtos).sort((a, b) => b[1].receita - a[1].receita).forEach(([n, d]) => linhas.push([n, d.qtd, d.receita.toFixed(2)]));
  }

  const csv = '\uFEFF' + linhas.map(l => l.map(c => {
    const s = String(c == null ? '' : c);
    return /[";\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }).join(sep)).join('\r\n');

  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = nome + '_' + new Date().toISOString().slice(0, 10) + '.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function construirMensagem(tipo) {
  const r = calcularResumo(vendasFiltradas());
  let titulo = tipo === 'caixa' ? 'RELATÓRIO DE CAIXA' : tipo === 'pagamentos' ? 'MÉTODOS DE PAGAMENTO' : tipo === 'fecho' ? 'FECHO DE CAIXA' : 'RELATÓRIO DE VENDAS';
  let txt = '*BOM MUNDO* — ' + titulo + '\n';
  txt += 'Período: ' + textoPeriodo() + '\n';
  txt += 'Operador: ' + UTILIZADOR + '\n';
  txt += 'Emitido em: ' + new Date().toLocaleString('pt-AO') + '\n';
  txt += '--------------------------------\n';
  if (tipo === 'caixa' || tipo === 'fecho') {
    txt += 'Total líquido: ' + formatKz(r.totalLiquido) + '\n';
    txt += 'Total bruto: ' + formatKz(r.total) + '\n';
    txt += 'Descontos: ' + formatKz(r.desconto) + '\n';
    txt += 'Nº vendas: ' + r.count + '\n';
    txt += 'Ticket médio: ' + formatKz(r.ticketMedio) + '\n';
    txt += '--------------------------------\n';
    Object.entries(r.porForma).forEach(([k, d]) => { txt += '• ' + (FORMAS[k] || k) + ': ' + formatKz(d.total) + ' (' + d.count + ')\n'; });
  } else if (tipo === 'pagamentos') {
    const total = Object.values(r.porForma).reduce((s, x) => s + x.total, 0);
    txt += 'Total recebido: ' + formatKz(total) + '\n';
    txt += 'Nº transações: ' + r.count + '\n';
    txt += 'Ticket médio: ' + formatKz(r.ticketMedio) + '\n';
    txt += '--------------------------------\n';
    Object.entries(r.porForma).sort((a, b) => b[1].total - a[1].total).forEach(([k, d]) => {
      const pct = total > 0 ? (d.total / total) * 100 : 0;
      txt += '• ' + (FORMAS[k] || k) + ': ' + formatKz(d.total) + ' (' + pct.toFixed(1) + '%, ' + d.count + ')\n';
    });
  } else {
    txt += 'Total bruto: ' + formatKz(r.total) + '\n';
    txt += 'Total líquido: ' + formatKz(r.totalLiquido) + '\n';
    txt += 'Descontos: ' + formatKz(r.desconto) + '\n';
    txt += 'Nº vendas: ' + r.count + '\n';
    txt += 'Ticket médio: ' + formatKz(r.ticketMedio) + '\n';
    txt += '--------------------------------\n';
    Object.entries(r.produtos).sort((a, b) => b[1].receita - a[1].receita).slice(0, 5).forEach(([n, d]) => { txt += '• ' + n + ': ' + d.qtd + ' un · ' + formatKz(d.receita) + '\n'; });
  }
  txt += '--------------------------------\nSistema Bom Mundo';
  return txt;
}

function abrirModalWhatsApp(tipo) {
  if (!exigirDocumento(tipo)) return;
  canalEnvio = tipo;
  document.getElementById('whatsappPreview').textContent = construirMensagem(tipo);
  document.getElementById('whatsappNumero').value = '';
  document.getElementById('whatsappModal').classList.add('open');
}
function fecharModalWhatsApp() { document.getElementById('whatsappModal').classList.remove('open'); }
function enviarWhatsAppForm(e) {
  e.preventDefault();
  const num = document.getElementById('whatsappNumero').value.replace(/\D/g, '');
  const msg = document.getElementById('whatsappPreview').textContent;
  const url = num ? 'https://wa.me/' + num + '?text=' + encodeURIComponent(msg) : 'https://wa.me/?text=' + encodeURIComponent(msg);
  window.open(url, '_blank');
  fecharModalWhatsApp();
}

function abrirModalEmail(tipo) {
  if (!exigirDocumento(tipo)) return;
  canalEnvio = tipo;
  const ass = { caixa: 'Relatório de Caixa — Bom Mundo', relatorio: 'Relatório de Vendas — Bom Mundo', pagamentos: 'Métodos de Pagamento — Bom Mundo', fecho: 'Fecho de Caixa — Bom Mundo' };
  document.getElementById('emailAssunto').value = ass[tipo] || 'Documento — Bom Mundo';
  document.getElementById('emailMensagem').value = construirMensagem(tipo);
  document.getElementById('emailDestinatario').value = '';
  document.getElementById('emailAnexoPdf').checked = true;
  document.getElementById('emailModal').classList.add('open');
}
function fecharModalEmail() {
  document.getElementById('emailModal').classList.remove('open');
  const f = document.getElementById('emailForm');
  if (f) f.reset();
}

function pdfParaBase64(tipo) {
  return construirPdf(tipo).outputPdf('datauristring').then(uri => {
    const i = uri.indexOf(',');
    return i >= 0 ? uri.slice(i + 1) : uri;
  });
}

async function enviarEmailForm(e) {
  e.preventDefault();
  const dest = document.getElementById('emailDestinatario').value.trim();
  const assunto = document.getElementById('emailAssunto').value.trim();
  const msg = document.getElementById('emailMensagem').value.trim();
  const anexar = document.getElementById('emailAnexoPdf').checked;
  const btn = document.getElementById('btnEnviarEmailConfirmar');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(dest)) { alert('Email inválido.'); return; }
  btn.disabled = true; btn.textContent = 'A enviar…';
  try {
    const payload = { email: dest, assunto, mensagem: msg, tipoRelatorio: canalEnvio, periodo: textoPeriodo(), anexarPdf: anexar };
    if (anexar) {
      payload.pdfNome = 'Documento_' + canalEnvio + '_' + new Date().toISOString().slice(0, 10) + '.pdf';
      payload.pdfBase64 = await pdfParaBase64(canalEnvio);
    }
    const resp = await fetch('/vendas/relatorio/enviar-email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    let dados = {};
    try { dados = await resp.json(); } catch (err) {}
    if (!resp.ok) throw new Error(dados.erro || 'Falha ao enviar.');
    fecharModalEmail();
  } catch (err) {
    console.error(err); alert(err.message || 'Não foi possível enviar.');
  } finally {
    btn.disabled = false; btn.textContent = 'Enviar';
  }
}

document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => mudarTab(t.dataset.tab)));
  document.querySelectorAll('.preset-chip').forEach(c => c.addEventListener('click', () => aplicarPreset(c.dataset.preset)));

  const gs = document.getElementById('globalSearch');
  if (gs) gs.addEventListener('input', e => {
    document.getElementById('tableSearch').value = e.target.value;
    tableSearch = e.target.value.toLowerCase().trim();
    currentPage = 1; renderVendas();
  });

  const ts = document.getElementById('tableSearch');
  if (ts) ts.addEventListener('input', e => {
    tableSearch = e.target.value.toLowerCase().trim();
    currentPage = 1; renderVendas();
  });

  const pp = document.getElementById('perPageSelect');
  if (pp) pp.addEventListener('change', function () {
    perPage = parseInt(this.value, 10) || 25;
    currentPage = 1; renderVendas();
  });

  document.querySelectorAll('.data-table th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const k = th.dataset.sort;
      if (sortKey === k) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      else { sortKey = k; sortDir = 'asc'; }
      currentPage = 1; renderVendas();
    });
  });

  const sa = document.getElementById('selectAllCheckbox');
  if (sa) sa.addEventListener('change', function () {
    const lista = getVendasTabela();
    const tp = Math.max(1, Math.ceil(lista.length / perPage));
    if (currentPage > tp) currentPage = tp;
    const ini = (currentPage - 1) * perPage;
    const fim = Math.min(ini + perPage, lista.length);
    lista.slice(ini, fim).forEach(v => { this.checked ? selectedRows.add(v.id) : selectedRows.delete(v.id); });
    renderVendas();
  });

  document.getElementById('tbodyVendas').addEventListener('change', function (e) {
    if (e.target.classList.contains('row-checkbox')) {
      const id = parseInt(e.target.dataset.id, 10);
      const checked = e.target.checked;
      checked ? selectedRows.add(id) : selectedRows.delete(id);
      const tr = e.target.closest('tr[data-id]');
      if (tr) tr.classList.toggle('is-selected', checked);
      atualizarSelectionInfo();
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { fecharModalEmail(); fecharModalWhatsApp(); }
  });
  document.addEventListener('keydown', function (e) {
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 's') {
      e.preventDefault();
      if (tabAtiva !== 'vendas' && docVisivel[tabAtiva]) baixarPDF(tabAtiva);
    }
  });

  renderTudo();
});
</script>
