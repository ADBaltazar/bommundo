    <script>
        window.__VENDAS__ = <%- JSON.stringify(
            (vendas || []).map(function (v) {
                return {
                    id: v.id,
                    data_venda: v.data_venda,
                    valor_total: Number(v.valor_total || 0),
                    desconto: Number(v.desconto || 0),
                    forma_pagamento: v.forma_pagamento,
                    status: v.status,
                    caixa_id: v.caixa_id,
                    funcionario: v.Funcionario ? v.Funcionario.nome : '',
                    itens: (v.ItemVendas || []).map(function (i) {
                        return {
                            nome: i.Produto ? i.Produto.nome : '',
                            quantidade: Number(i.quantidade || 0),
                            preco_unitario: Number(i.preco_unitario || 0),
                            subtotal: Number(i.subtotal || 0)
                        };
                    })
                };
            })
        ) %>;

        window.__CAIXA__ = <%- JSON.stringify(EstadoCaixa || {}) %>;
        window.__UTILIZADOR__ = '<%= utilizador %>';
    </script>

    <!-- ============================================================
         APLICAÇÃO
         ============================================================ -->
    <script>
        const VENDAS = Array.isArray(window.__VENDAS__) ? window.__VENDAS__ : [];
        const CAIXA = window.__CAIXA__ || {};
        const UTILIZADOR = window.__UTILIZADOR__ || 'Operador';

        const FORMAS = {
            'dinheiro': 'Dinheiro',
            'Tpa': 'TPA (Multicaixa)',
            'transferencia': 'Transferência'
        };

        const FORMAS_ICON = {
            'dinheiro': 'fa-money-bill-wave',
            'Tpa': 'fa-credit-card',
            'transferencia': 'fa-university'
        };

        const STATUS = {
            'pendente': 'Pendente',
            'concluida': 'Concluída',
            'cancelada': 'Cancelada'
        };

        const DOC_CONFIG = {
            caixa:      { panel: 'panel-caixa',      container: 'caixaReport',      placeholder: 'caixaPlaceholder',      btnGerar: 'btnGerarCaixa' },
            relatorio:  { panel: 'panel-relatorio',  container: 'relatorioReport',  placeholder: 'relatorioPlaceholder',  btnGerar: 'btnGerarRelatorio' },
            pagamentos: { panel: 'panel-pagamentos', container: 'pagamentosReport', placeholder: 'pagamentosPlaceholder', btnGerar: 'btnGerarPagamentos' },
            fecho:      { panel: 'panel-fecho',      container: 'fechoReport',      placeholder: 'fechoPlaceholder',      btnGerar: 'btnGerarFecho' }
        };

        const docVisivel = { caixa: false, relatorio: false, pagamentos: false, fecho: false };

        let filtros = { dataInicio: '', dataFim: '', forma: '', status: '' };
        let tabAtiva = 'vendas';
        let canalEnvio = 'relatorio';

        let sortKey = 'data_venda';
        let sortDir = 'desc';
        let currentPage = 1;
        let perPage = 25;
        let tableSearch = '';
        const expandedRows = new Set();
        const selectedRows = new Set();

        /* Utilitários */
        function formatKz(valor) {
            const n = Number(valor || 0);
            return n.toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
        }

        function formatDataHora(iso) {
            const d = new Date(iso);
            if (isNaN(d.getTime())) return '—';
            return d.toLocaleString('pt-AO', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        }

        function formatDataCurta(iso) {
            const d = new Date(iso);
            if (isNaN(d.getTime())) return '—';
            return d.toLocaleDateString('pt-AO');
        }

        function escaparHtml(txt) {
            const div = document.createElement('div');
            div.textContent = txt == null ? '' : String(txt);
            return div.innerHTML;
        }

        function gerarNumeroDoc(prefixo) {
            const agora = new Date();
            const ano = agora.getFullYear();
            const seq = String(Math.floor(Math.random() * 99999)).padStart(5, '0');
            return prefixo + ' ' + ano + '/' + seq;
        }

        function mostrarToast(mensagem, tipo = 'info', duracao = 3800) {
            const container = document.getElementById('toast-container');
            if (!container) { alert(mensagem); return; }
            const icones = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle' };
            const toast = document.createElement('div');
            toast.className = 'toast ' + tipo;
            toast.innerHTML = '<i class="fas ' + (icones[tipo] || icones.info) + '"></i><span></span>';
            toast.querySelector('span').textContent = mensagem;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.transition = 'all .3s ease';
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(30px)';
                setTimeout(() => toast.remove(), 300);
            }, duracao);
        }

        function alternarLoading(botao, ativo, texto) {
            if (!botao) return;
            if (ativo) {
                if (!botao.dataset.htmlOriginal) botao.dataset.htmlOriginal = botao.innerHTML;
                botao.disabled = true;
                botao.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + (texto || 'A processar...');
            } else {
                botao.disabled = false;
                if (botao.dataset.htmlOriginal) botao.innerHTML = botao.dataset.htmlOriginal;
            }
        }

        /* Visibilidade dos documentos */
        function gerarDocumento(tipo) {
            const cfg = DOC_CONFIG[tipo];
            if (!cfg) return;
            if (tabAtiva !== tipo) mudarTab(tipo);
            renderTudo();
            docVisivel[tipo] = true;
            const container = document.getElementById(cfg.container);
            const placeholder = document.getElementById(cfg.placeholder);
            if (container) container.classList.add('documento-visivel');
            if (placeholder) placeholder.style.display = 'none';
            const panel = document.getElementById(cfg.panel);
            if (panel) panel.querySelectorAll('.export-btn').forEach(b => b.disabled = false);
            const btnGerar = document.getElementById(cfg.btnGerar);
            if (btnGerar) {
                btnGerar.innerHTML = '<i class="fas fa-rotate"></i> Actualizar Documento';
                btnGerar.classList.remove('btn-primary');
                btnGerar.classList.add('btn-outline');
            }
            mostrarToast('Documento gerado com sucesso.', 'success', 2400);
            setTimeout(() => {
                if (container) container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }

        function exigirDocumento(tipo) {
            if (!docVisivel[tipo]) {
                mostrarToast('Gere primeiro o documento para poder exportar.', 'info', 2600);
                return false;
            }
            return true;
        }

        /* Filtragem */
        function vendasFiltradas() {
            return VENDAS.filter(v => {
                const d = new Date(v.data_venda);
                if (filtros.dataInicio && d < new Date(filtros.dataInicio + 'T00:00:00')) return false;
                if (filtros.dataFim && d > new Date(filtros.dataFim + 'T23:59:59')) return false;
                if (filtros.forma && v.forma_pagamento !== filtros.forma) return false;
                if (filtros.status && v.status !== filtros.status) return false;
                return true;
            });
        }

        function textoPeriodo() {
            const ini = filtros.dataInicio ? formatDataCurta(filtros.dataInicio + 'T00:00:00') : 'Início';
            const fim = filtros.dataFim ? formatDataCurta(filtros.dataFim + 'T00:00:00') : 'Hoje';
            if (!filtros.dataInicio && !filtros.dataFim) return 'Todo o período';
            return ini + ' a ' + fim;
        }

        function aplicarFiltros() {
            filtros.dataInicio = document.getElementById('dataInicio').value;
            filtros.dataFim = document.getElementById('dataFim').value;
            filtros.forma = document.getElementById('filtroForma').value;
            filtros.status = document.getElementById('filtroStatus').value;
            currentPage = 1;
            selectedRows.clear();
            renderTudo();
            mostrarToast('Filtros aplicados.', 'info', 2200);
        }

        function limparFiltros() {
            document.getElementById('dataInicio').value = '';
            document.getElementById('dataFim').value = '';
            document.getElementById('filtroForma').value = '';
            document.getElementById('filtroStatus').value = '';
            filtros = { dataInicio: '', dataFim: '', forma: '', status: '' };
            currentPage = 1;
            selectedRows.clear();
            renderTudo();
            mostrarToast('Filtros limpos.', 'info', 2000);
        }

        function aplicarPreset(preset) {
            const hoje = new Date();
            let ini = null, fim = null;
            const setIni = (d) => { ini = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };
            const setFim = (d) => { fim = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };

            if (preset === 'hoje') { setIni(hoje); setFim(hoje); }
            else if (preset === 'ontem') { const o = new Date(hoje); o.setDate(o.getDate()-1); setIni(o); setFim(o); }
            else if (preset === 'semana') {
                const d = new Date(hoje); const dia = d.getDay();
                const diff = (dia === 0 ? 6 : dia - 1);
                const seg = new Date(d); seg.setDate(d.getDate() - diff);
                setIni(seg); setFim(hoje);
            }
            else if (preset === 'mes') { setIni(new Date(hoje.getFullYear(), hoje.getMonth(), 1)); setFim(hoje); }
            else if (preset === 'ano') { setIni(new Date(hoje.getFullYear(), 0, 1)); setFim(hoje); }
            else {
                document.getElementById('dataInicio').value = '';
                document.getElementById('dataFim').value = '';
                filtros.dataInicio = '';
                filtros.dataFim = '';
                currentPage = 1;
                renderTudo();
                return;
            }
            document.getElementById('dataInicio').value = ini;
            document.getElementById('dataFim').value = fim;
            filtros.dataInicio = ini;
            filtros.dataFim = fim;
            currentPage = 1;
            renderTudo();
        }

        /* Agregações */
        function calcularResumo(lista) {
            const resumo = {
                total: 0, desconto: 0, totalLiquido: 0, count: 0,
                porForma: {}, porStatus: { concluida: 0, pendente: 0, cancelada: 0 }, produtos: {}
            };
            lista.forEach(v => {
                const total = Number(v.valor_total || 0);
                const desc = Number(v.desconto || 0);
                resumo.total += total;
                resumo.desconto += desc;
                resumo.totalLiquido += Math.max(0, total - desc);
                resumo.count += 1;
                const forma = v.forma_pagamento || 'outro';
                if (!resumo.porForma[forma]) resumo.porForma[forma] = { count: 0, total: 0, liquido: 0 };
                resumo.porForma[forma].count += 1;
                resumo.porForma[forma].total += total;
                resumo.porForma[forma].liquido += Math.max(0, total - desc);
                if (resumo.porStatus[v.status] !== undefined) resumo.porStatus[v.status] += 1;
                (v.itens || []).forEach(item => {
                    const nome = item.nome || '—';
                    if (!resumo.produtos[nome]) resumo.produtos[nome] = { qtd: 0, receita: 0 };
                    resumo.produtos[nome].qtd += Number(item.quantidade || 0);
                    resumo.produtos[nome].receita += Number(item.subtotal || 0);
                });
            });
            resumo.ticketMedio = resumo.count ? resumo.totalLiquido / resumo.count : 0;
            return resumo;
        }

        /* Inventário de Vendas (vista interactiva) */
        function renderVendasSummary() {
            const lista = vendasFiltradas();
            const resumo = calcularResumo(lista);
            document.getElementById('vendasSummary').innerHTML = `
                <div class="summary-card dark">
                    <span class="summary-label"><i class="fas fa-coins"></i> Total do Período</span>
                    <span class="summary-value">${formatKz(resumo.totalLiquido)}</span>
                    <span class="summary-sub">${resumo.count} vendas · bruto ${formatKz(resumo.total)}</span>
                </div>
                <div class="summary-card green">
                    <span class="summary-label"><i class="fas fa-circle-check"></i> Concluídas</span>
                    <span class="summary-value">${resumo.porStatus.concluida}</span>
                    <span class="summary-sub">${resumo.count ? ((resumo.porStatus.concluida / resumo.count) * 100).toFixed(1) : 0}% do total</span>
                </div>
                <div class="summary-card orange">
                    <span class="summary-label"><i class="fas fa-hourglass-half"></i> Pendentes</span>
                    <span class="summary-value">${resumo.porStatus.pendente}</span>
                    <span class="summary-sub">A aguardar conclusão</span>
                </div>
                <div class="summary-card red">
                    <span class="summary-label"><i class="fas fa-tags"></i> Descontos</span>
                    <span class="summary-value">${formatKz(resumo.desconto)}</span>
                    <span class="summary-sub">Total concedido</span>
                </div>
                <div class="summary-card blue">
                    <span class="summary-label"><i class="fas fa-receipt"></i> Ticket Médio</span>
                    <span class="summary-value">${formatKz(resumo.ticketMedio)}</span>
                    <span class="summary-sub">Por venda</span>
                </div>
            `;
        }

        function getVendasTabela() {
            let lista = vendasFiltradas();
            if (tableSearch) {
                const termo = tableSearch.toLowerCase();
                lista = lista.filter(v =>
                    String(v.id).includes(termo) ||
                    (v.funcionario || '').toLowerCase().includes(termo) ||
                    (FORMAS[v.forma_pagamento] || '').toLowerCase().includes(termo) ||
                    (STATUS[v.status] || '').toLowerCase().includes(termo)
                );
            }
            lista.sort((a, b) => {
                let va, vb;
                switch (sortKey) {
                    case 'id': va = Number(a.id); vb = Number(b.id); break;
                    case 'data_venda': va = new Date(a.data_venda).getTime(); vb = new Date(b.data_venda).getTime(); break;
                    case 'valor': va = Math.max(0, a.valor_total - a.desconto); vb = Math.max(0, b.valor_total - b.desconto); break;
                    case 'itens': va = (a.itens || []).length; vb = (b.itens || []).length; break;
                    case 'forma_pagamento': va = FORMAS[a.forma_pagamento] || a.forma_pagamento || ''; vb = FORMAS[b.forma_pagamento] || b.forma_pagamento || ''; break;
                    case 'status': va = a.status || ''; vb = b.status || ''; break;
                    default: va = a.id; vb = b.id;
                }
                if (typeof va === 'string') {
                    const cmp = va.localeCompare(vb);
                    return sortDir === 'asc' ? cmp : -cmp;
                }
                return sortDir === 'asc' ? va - vb : vb - va;
            });
            return lista;
        }

        function renderVendas() {
            renderVendasSummary();
            const tbody = document.getElementById('tbodyVendas');
            const listaCompleta = getVendasTabela();
            const total = listaCompleta.length;
            const totalPaginas = Math.max(1, Math.ceil(total / perPage));
            if (currentPage > totalPaginas) currentPage = totalPaginas;
            const inicio = (currentPage - 1) * perPage;
            const fim = Math.min(inicio + perPage, total);
            const pagina = listaCompleta.slice(inicio, fim);
            document.getElementById('paginationInfo').textContent = total === 0
                ? 'Sem resultados'
                : `Mostrando ${inicio + 1}–${fim} de ${total} vendas`;
            renderPagination(totalPaginas);

            document.querySelectorAll('.data-table th.sortable').forEach(th => {
                th.classList.remove('sorted-asc', 'sorted-desc');
                const icone = th.querySelector('.sort-indicator i');
                if (th.dataset.sort === sortKey) {
                    th.classList.add(sortDir === 'asc' ? 'sorted-asc' : 'sorted-desc');
                    icone.className = sortDir === 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down';
                } else {
                    icone.className = 'fas fa-sort';
                }
            });

            if (!pagina.length) {
                tbody.innerHTML = `<tr><td colspan="10" class="text-center empty-state"><i class="fas fa-inbox"></i>Nenhuma venda encontrada para os filtros aplicados.</td></tr>`;
                atualizarSelectionInfo();
                return;
            }

            tbody.innerHTML = pagina.map(v => {
                const cancelada = v.status === 'cancelada';
                const liquido = Math.max(0, Number(v.valor_total) - Number(v.desconto));
                const numItens = (v.itens || []).length;
                const expandido = expandedRows.has(v.id);
                const selecionado = selectedRows.has(v.id);

                const linhaPrincipal = `
                    <tr data-id="${v.id}">
                        <td class="no-print">
                            <input type="checkbox" class="table-select row-checkbox" data-id="${v.id}" ${selecionado ? 'checked' : ''}>
                        </td>
                        <td class="no-print">
                            <button type="button" class="row-expand-btn ${expandido ? 'expanded' : ''}"
                                    onclick="toggleExpand(${v.id})" title="${expandido ? 'Recolher' : 'Ver itens'}">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </td>
                        <td><strong>#${v.id}</strong></td>
                        <td>${escaparHtml(formatDataHora(v.data_venda))}</td>
                        <td>${escaparHtml(v.funcionario || '—')}</td>
                        <td class="text-center"><span class="item-count-badge"><i class="fas fa-box"></i> ${numItens}</span></td>
                        <td>${escaparHtml(FORMAS[v.forma_pagamento] || v.forma_pagamento || '—')}</td>
                        <td><span class="status-badge status-${escaparHtml(v.status || 'pendente')}">${escaparHtml(STATUS[v.status] || v.status || '—')}</span></td>
                        <td class="text-end"><strong>${formatKz(liquido)}</strong></td>
                        <td class="no-print">
                            <div style="display:flex; gap:4px;">
                                <a href="/vendas/${v.id}" class="btn btn-sm btn-info icon-btn" title="Ver factura"><i class="fas fa-file-invoice"></i></a>
                                <a href="/vendas/cancelar/${v.id}" class="btn btn-sm btn-danger icon-btn" title="Cancelar venda" ${cancelada ? 'style="pointer-events:none;opacity:.5;"' : ''} onclick="return confirm('Cancelar a venda #${v.id}?');"><i class="fas fa-times"></i></a>
                            </div>
                        </td>
                    </tr>`;

                const linhaExpandida = expandido ? `
                    <tr class="expanded-row" data-expanded-for="${v.id}">
                        <td colspan="10">
                            <div class="expanded-content">
                                <div class="expanded-title"><i class="fas fa-box-open"></i> Itens da Venda #${v.id}</div>
                                ${renderItensVenda(v)}
                            </div>
                        </td>
                    </tr>` : '';

                return linhaPrincipal + linhaExpandida;
            }).join('');

            const selectAll = document.getElementById('selectAllCheckbox');
            if (selectAll) {
                const idsPagina = pagina.map(v => v.id);
                const todosSelecionados = idsPagina.length > 0 && idsPagina.every(id => selectedRows.has(id));
                const algunsSelecionados = idsPagina.some(id => selectedRows.has(id));
                selectAll.checked = todosSelecionados;
                selectAll.indeterminate = !todosSelecionados && algunsSelecionados;
            }
            atualizarSelectionInfo();
        }

        function renderItensVenda(v) {
            if (!v.itens || !v.itens.length) return `<p class="text-muted" style="font-size:13px;">Esta venda não possui itens registados.</p>`;
            const subtotal = v.itens.reduce((s, i) => s + Number(i.subtotal || 0), 0);
            const desconto = Number(v.desconto || 0);
            const total = Math.max(0, subtotal - desconto);
            return `
                <table class="expanded-items-table">
                    <thead><tr><th>Produto</th><th class="text-center">Qtd.</th><th class="text-end">Preço Unit.</th><th class="text-end">Subtotal</th></tr></thead>
                    <tbody>${v.itens.map(i => `<tr><td>${escaparHtml(i.nome || '—')}</td><td class="text-center">${i.quantidade}</td><td class="text-end">${formatKz(i.preco_unitario)}</td><td class="text-end">${formatKz(i.subtotal)}</td></tr>`).join('')}</tbody>
                    <tfoot>
                        <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">${formatKz(subtotal)}</td></tr>
                        ${desconto > 0 ? `<tr><td colspan="3" class="text-end text-danger">Desconto</td><td class="text-end text-danger">- ${formatKz(desconto)}</td></tr>` : ''}
                        <tr><td colspan="3" class="text-end">TOTAL</td><td class="text-end" style="color:#E53935;">${formatKz(total)}</td></tr>
                    </tfoot>
                </table>`;
        }

        function renderPagination(totalPaginas) {
            const container = document.getElementById('paginationControls');
            if (totalPaginas <= 1) { container.innerHTML = ''; return; }
            const botoes = [];
            botoes.push(`<button class="page-btn" ${currentPage === 1 ? 'disabled' : ''} onclick="irParaPagina(${currentPage - 1})"><i class="fas fa-chevron-left"></i></button>`);
            const janela = 2;
            const paginasVisiveis = new Set([1, totalPaginas]);
            for (let p = currentPage - janela; p <= currentPage + janela; p++) if (p >= 1 && p <= totalPaginas) paginasVisiveis.add(p);
            const paginasOrd = Array.from(paginasVisiveis).sort((a, b) => a - b);
            let anterior = 0;
            paginasOrd.forEach(p => {
                if (anterior && p - anterior > 1) botoes.push(`<span style="padding:0 4px;color:#aaa;">…</span>`);
                botoes.push(`<button class="page-btn ${p === currentPage ? 'active' : ''}" onclick="irParaPagina(${p})">${p}</button>`);
                anterior = p;
            });
            botoes.push(`<button class="page-btn" ${currentPage === totalPaginas ? 'disabled' : ''} onclick="irParaPagina(${currentPage + 1})"><i class="fas fa-chevron-right"></i></button>`);
            container.innerHTML = botoes.join('');
        }

        function irParaPagina(p) { currentPage = p; renderVendas(); }
        function toggleExpand(id) { if (expandedRows.has(id)) expandedRows.delete(id); else expandedRows.add(id); renderVendas(); }
        function expandirTodas() {
            getVendasTabela().forEach(v => expandedRows.add(v.id));
            document.getElementById('btnExpandAll').style.display = 'none';
            document.getElementById('btnCollapseAll').style.display = '';
            renderVendas();
        }
        function recolherTodas() {
            expandedRows.clear();
            document.getElementById('btnExpandAll').style.display = '';
            document.getElementById('btnCollapseAll').style.display = 'none';
            renderVendas();
        }
        function atualizarSelectionInfo() {
            const info = document.getElementById('selectionInfo');
            if (!info) return;
            const n = selectedRows.size;
            if (n === 0) info.textContent = '';
            else info.innerHTML = `<strong style="color:#E53935;">${n}</strong> venda(s) selecionada(s)`;
        }

        /* Helpers de documento */
        function renderResumoTable(targetId, linhas) {
            const target = document.getElementById(targetId);
            if (!target) return;
            target.innerHTML = linhas.map(l => {
                const cls = l.destaque ? ' class="destaque"' : '';
                return `<tr${cls}><td class="resumo-key">${escaparHtml(l.label)}</td><td class="resumo-val">${l.valor}</td></tr>`;
            }).join('');
        }

        function renderDocPagamentos(targetId, resumo) {
            const target = document.getElementById(targetId);
            if (!target) return;
            const metodos = Object.entries(resumo.porForma).sort((a, b) => b[1].total - a[1].total);
            const totalGeral = metodos.reduce((s, [, m]) => s + m.total, 0);
            if (!metodos.length) {
                target.innerHTML = `<div style="padding:12px 14px; color:#888; font-size:11.5px;">Sem movimentos por forma de pagamento.</div>`;
                return;
            }
            target.innerHTML = metodos.map(([chave, dados]) => {
                const pct = totalGeral > 0 ? (dados.total / totalGeral) * 100 : 0;
                return `
                    <div class="pag-linha">
                        <span class="pag-nome">
                            <i class="fas ${FORMAS_ICON[chave] || 'fa-money-bill'}"></i>
                            ${escaparHtml(FORMAS[chave] || chave)}
                        </span>
                        <span>
                            <span class="pag-valor">${formatKz(dados.total)}</span>
                            <span class="pag-pct">(${pct.toFixed(1)}% · ${dados.count})</span>
                        </span>
                    </div>`;
            }).join('');
        }

        /* Render: Relatório de Caixa */
        function renderCaixa() {
            const lista = vendasFiltradas().sort((a, b) => new Date(b.data_venda) - new Date(a.data_venda));
            const resumo = calcularResumo(lista);

            document.getElementById('caixaPeriodoLabel').textContent = textoPeriodo();
            document.getElementById('phCaixaDocNum').textContent = gerarNumeroDoc('RC');
            document.getElementById('phCaixaPeriodo').textContent = textoPeriodo();
            document.getElementById('phCaixaEmitido').textContent = new Date().toLocaleString('pt-AO');
            document.getElementById('phCaixaNumero').textContent = CAIXA.id ? ('#00' + CAIXA.id) : '—';
            document.getElementById('phCaixaEstadoInline').innerHTML = CAIXA.status === 'aberto'
                ? '<span class="doc-status-box aberto">Aberto</span>'
                : '<span class="doc-status-box fechado">Fechado</span>';
            document.getElementById('phCaixaNumVendas').textContent = resumo.count;
            document.getElementById('phCaixaTicketMedio').textContent = formatKz(resumo.ticketMedio);
            document.getElementById('phCaixaFooterData').textContent = new Date().toLocaleString('pt-AO');

            const dinheiro = resumo.porForma['dinheiro'] || { total: 0, count: 0 };
            const tpa = resumo.porForma['Tpa'] || { total: 0, count: 0 };
            const transf = resumo.porForma['transferencia'] || { total: 0, count: 0 };

            renderResumoTable('caixaResumoTable', [
                { label: 'Total Bruto', valor: formatKz(resumo.total) },
                { label: 'Descontos Concedidos', valor: '<span class="text-danger">- ' + formatKz(resumo.desconto) + '</span>' },
                { label: 'Total Líquido', valor: formatKz(resumo.totalLiquido), destaque: true },
                { label: 'Nº de Vendas Registadas', valor: resumo.count },
                { label: 'Ticket Médio por Venda', valor: formatKz(resumo.ticketMedio) },
                { label: 'Dinheiro (' + dinheiro.count + ' vendas)', valor: formatKz(dinheiro.total) },
                { label: 'TPA / Multicaixa (' + tpa.count + ' vendas)', valor: formatKz(tpa.total) },
                { label: 'Transferência (' + transf.count + ' vendas)', valor: formatKz(transf.total) }
            ]);

            document.getElementById('phCaixaVendasCount').textContent =
                lista.length + (lista.length === 1 ? ' venda' : ' vendas');

            const tbody = document.getElementById('caixaTbody');
            if (!lista.length) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center empty-state"><i class="fas fa-inbox"></i>Sem vendas no período.</td></tr>`;
                document.getElementById('caixaTfoot').innerHTML = '';
            } else {
                tbody.innerHTML = lista.map((v, i) => {
                    const liquido = Math.max(0, Number(v.valor_total) - Number(v.desconto));
                    return `<tr>
                        <td>${i + 1}</td>
                        <td>${escaparHtml(formatDataHora(v.data_venda))}</td>
                        <td>${escaparHtml(FORMAS[v.forma_pagamento] || v.forma_pagamento || '—')}</td>
                        <td><span class="status-badge status-${escaparHtml(v.status || 'pendente')}">${escaparHtml(STATUS[v.status] || v.status || '—')}</span></td>
                        <td class="text-end">${formatKz(liquido)}</td>
                    </tr>`;
                }).join('');
                document.getElementById('caixaTfoot').innerHTML = `
                    <tr>
                        <td colspan="4" class="text-end">TOTAL GERAL</td>
                        <td class="text-end">${formatKz(resumo.totalLiquido)}</td>
                    </tr>`;
            }

            renderDocPagamentos('caixaPagamentosPrint', resumo);
            document.getElementById('phCaixaTotalBruto').textContent = formatKz(resumo.total);
            document.getElementById('phCaixaDescontos').textContent = '- ' + formatKz(resumo.desconto);
            document.getElementById('phCaixaTotalLiquido').textContent = formatKz(resumo.totalLiquido);
        }

