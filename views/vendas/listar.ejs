<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vendas — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --bg:             #fafafa;
  --surface:        #ffffff;
  --border:         #e5e5e5;
  --fg:             #1a1a1a;
  --fg-muted:       #666666;
  --primary:        #c62828;
  --primary-hover:  #a01f1f;
  --primary-active: #8b1a1a;
  --success:        #16a34a;
  --warning:        #b45309;
  --info:           #2563eb;
  --danger:         #c62828;
  --focus:          #1a1a1a;

  --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px; --s-7: 48px;
}

/* Copiar para o topo de qualquer página */
:root { --success: #16a34a; --warning: #b45309; --info: #2563eb; }

.status-concluida { color: var(--success); }
.status-pendente  { color: var(--warning); }
.status-cancelada { color: var(--danger); }

.pay-method { display: inline-flex; align-items: center; gap: 6px; }
.pay-method::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.pay-dinheiro::before { background: var(--success); }
.pay-tpa::before      { background: var(--info); }
.pay-transferencia::before { background: var(--warning); }

* { margin: 0; padding: 0; box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg);
  background: var(--bg);
  display: flex;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }

::selection { background: var(--fg); color: var(--bg); }

:focus { outline: none; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* ---------- Animações reutilizáveis ---------- */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes expandIn {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- Botões ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border: 1px solid transparent;
  border-radius: 4px;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
  white-space: nowrap;
}
.btn i { font-size: 11px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-primary:active:not(:disabled) { background: var(--primary-active); }
.btn-primary i { color: #fff; }
.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border); }
.btn-outline:hover:not(:disabled) { border-color: var(--fg-muted); }
.btn-outline:active:not(:disabled) { background: var(--bg); }
.btn-outline i { color: var(--fg-muted); }
.btn-sm { padding: var(--s-1) var(--s-2); font-size: 12px; }

/* Acção destrutiva em outline — feedback vermelho no hover */
.btn-outline.text-danger:hover:not(:disabled) {
  border-color: var(--danger);
  background: rgba(198, 40, 40, .04);
}

/* ---------- Sidebar — efeito original ---------- */
.sidebar {
  width: 220px;
  background: #1a1a1a;
  color: #d4d4d4;
  position: fixed;
  inset: 0 auto 0 0;
  display: flex;
  flex-direction: column;
  padding: var(--s-5) 0;
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: 0 var(--s-5) var(--s-5);
  font-size: 16px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: .5px;
  border-bottom: 1px solid #2a2a2a;
  margin-bottom: var(--s-4);
}
.logo i { font-size: 16px; color: var(--primary); }

.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  padding: var(--s-3) var(--s-5);
  font-size: 13px;
  font-weight: 500;
  color: #d4d4d4;
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover {
  background: #2a2a2a;
  color: var(--primary);
}
.nav-menu a:hover i { color: var(--primary); }
.nav-menu a.active {
  background: #2a2a2a;
  color: var(--primary);
  border-left-color: var(--primary);
}
.nav-menu a.active i { color: var(--primary); }
.nav-menu a:focus-visible { outline-color: #fff; }
.nav-menu i {
  width: 16px;
  text-align: center;
  font-size: 12px;
  color: #666;
  transition: color .2s ease;
}

.user-info {
  padding: var(--s-4) var(--s-5) 0;
  border-top: 1px solid #2a2a2a;
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-top: var(--s-4);
}
.user-avatar {
  width: 32px; height: 32px;
  background: var(--primary);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600; color: #fff;
  flex-shrink: 0;
}
.user-details { min-width: 0; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

/* ---------- Main ---------- */
.main-content { flex: 1; margin-left: 220px; padding: var(--s-5); min-width: 0; }

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-4);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-5);
}
.page-title { font-size: 20px; font-weight: 600; letter-spacing: -0.005em; }

.search-box {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: var(--s-1) var(--s-3);
  transition: border-color .15s;
}
.search-box:focus-within { border-color: var(--fg); }
.search-box i { color: var(--fg-muted); font-size: 12px; transition: color .15s; }
.search-box:focus-within i { color: var(--primary); }
.search-box input { border: none; outline: none; padding: var(--s-1); width: 200px; font: inherit; font-size: 13px; background: transparent; }

/* ---------- Tabs ---------- */
.tabs {
  display: flex;
  gap: var(--s-5);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-5);
  overflow-x: auto;
}
.tab {
  background: transparent;
  border: none;
  padding: var(--s-3) 0;
  font: inherit;
  font-size: 13px;
  color: var(--fg-muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  transition: color .15s, border-color .15s;
}
.tab i { font-size: 11px; transition: color .15s; }
.tab:hover { color: var(--fg); }
.tab:hover i { color: var(--fg); }
.tab:active { color: var(--fg); }
.tab.active { color: var(--fg); border-bottom-color: var(--primary); font-weight: 500; }
.tab.active i { color: var(--primary); }

.tab-panel { display: none; }
.tab-panel.active { display: block; animation: fadeIn .2s ease; }

/* ---------- Filtros ---------- */
.filters {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: var(--s-4);
  margin-bottom: var(--s-5);
}
.presets { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-bottom: var(--s-4); }
.preset-chip {
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: var(--s-1) var(--s-3);
  font: inherit; font-size: 12px;
  color: var(--fg-muted);
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
}
.preset-chip:hover { border-color: var(--fg-muted); color: var(--fg); background: var(--bg); }
.preset-chip:active { background: var(--border); }

.filter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: var(--s-3);
}
.form-group { display: flex; flex-direction: column; gap: var(--s-1); min-width: 0; }
.form-label { font-size: 12px; color: var(--fg-muted); font-weight: 500; }
.form-control {
  width: 100%;
  padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--fg);
  font: inherit; font-size: 13px;
  caret-color: var(--primary);
  transition: border-color .15s;
}
.form-control::placeholder { color: #999; }
.form-control:focus {
  outline: 2px solid var(--focus);
  outline-offset: 1px;
  border-color: var(--fg);
}
textarea.form-control { resize: vertical; min-height: 90px; }

.filter-buttons {
  display: flex;
  gap: var(--s-2);
  flex-wrap: wrap;
  margin-top: var(--s-4);
  padding-top: var(--s-4);
  border-top: 1px solid var(--border);
}

/* ---------- KPIs ---------- */
.summary-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: var(--s-6);
  padding: var(--s-4) 0 var(--s-5);
  border-bottom: 1px solid var(--border);
  margin-bottom: var(--s-5);
}
.summary-bar .kpi { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.summary-bar .kpi-label { font-size: 12px; color: var(--fg-muted); }
.summary-bar .kpi-value {
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
}
.summary-bar .kpi-primary .kpi-value { color: var(--primary); }
.summary-bar .kpi-warning .kpi-value { color: var(--warning); }
.summary-bar .kpi-sub { font-size: 12px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }

/* ---------- Card ---------- */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  margin-bottom: var(--s-5);
  overflow: hidden;
}
.card-header {
  padding: var(--s-4);
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
}
.card-header h3 {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: var(--s-2);
}
.card-header h3 i { color: var(--primary); font-size: 13px; }

/* ---------- Toolbar ---------- */
.report-toolbar,
.sales-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-4);
}
.report-toolbar-info { font-size: 13px; color: var(--fg-muted); }
.report-toolbar-info strong { color: var(--fg); font-weight: 500; }
.report-toolbar-actions { display: flex; gap: var(--s-2); flex-wrap: wrap; }

.sales-toolbar {
  background: transparent; border: none; border-bottom: 1px solid var(--border);
  border-radius: 0; padding: var(--s-3) var(--s-4); margin: 0;
}
.sales-toolbar-left { display: flex; align-items: center; gap: var(--s-3); font-size: 13px; color: var(--fg-muted); flex-wrap: wrap; }
.sales-toolbar-right { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
#selectionInfo:not(:empty) { color: var(--primary); font-weight: 500; font-variant-numeric: tabular-nums; }

.toolbar-search {
  display: flex; align-items: center; gap: var(--s-2);
  border: 1px solid var(--border); border-radius: 4px;
  padding: var(--s-1) var(--s-3); background: var(--surface);
  transition: border-color .15s;
}
.toolbar-search:focus-within { border-color: var(--fg); }
.toolbar-search i { color: var(--fg-muted); font-size: 12px; }
.toolbar-search input { border: none; outline: none; padding: var(--s-1); font: inherit; font-size: 13px; width: 200px; background: transparent; }

.per-page-select { padding: var(--s-1) var(--s-2); border: 1px solid var(--border); border-radius: 4px; font: inherit; font-size: 12px; background: var(--surface); }

/* ---------- Tabela ---------- */
.table-responsive { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; background: var(--surface); }
.data-table th {
  text-align: left;
  padding: var(--s-3);
  font-size: 12px;
  font-weight: 500;
  color: var(--fg-muted);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
}
.data-table th.sortable { cursor: pointer; user-select: none; transition: color .15s; }
.data-table th.sortable:hover { color: var(--fg); }
.data-table th .sort-indicator { display: inline-block; margin-left: var(--s-1); color: var(--border); font-size: 10px; transition: color .15s; }
.data-table th.sorted-asc .sort-indicator,
.data-table th.sorted-desc .sort-indicator { color: var(--fg); }

.data-table td { padding: var(--s-3); border-bottom: 1px solid var(--border); font-size: 13px; vertical-align: middle; }
.data-table tbody tr[data-id] { transition: background-color .15s; }
.data-table tbody tr[data-id]:hover td { background: var(--bg); }
.data-table tbody tr[data-id].is-selected td { background: rgba(198, 40, 40, .04); }
.data-table tbody tr[data-id].is-selected:hover td { background: rgba(198, 40, 40, .06); }
.data-table tfoot td { background: var(--bg); font-weight: 600; border-top: 1px solid var(--border); font-size: 13px; }

.data-table td.text-end,
.data-table tfoot td.text-end,
.data-table td.text-center { font-variant-numeric: tabular-nums; }

.text-center { text-align: center; }
.text-end { text-align: right; }
.text-muted { color: var(--fg-muted); }
.text-danger { color: var(--danger); }

/* ---------- Status semântico ---------- */
.status-badge { font-size: 12px; font-weight: 500; }
.status-badge.status-concluida { color: var(--success); }
.status-badge.status-pendente  { color: var(--warning); }
.status-badge.status-cancelada { color: var(--danger); }

/* ---------- Ponto de método de pagamento ---------- */
.pay-method {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.pay-method::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--fg-muted);
  opacity: .8;
}
.pay-dinheiro::before { background: var(--success); }
.pay-tpa::before      { background: var(--info); }
.pay-transferencia::before { background: var(--warning); }

.empty-cell {
  padding: var(--s-6) var(--s-4);
  text-align: center;
  color: var(--fg-muted);
  font-size: 13px;
}
.empty-cell i { color: var(--fg-muted); margin-right: var(--s-2); font-size: 12px; opacity: .6; }

.table-select { width: 14px; height: 14px; accent-color: var(--primary); cursor: pointer; }

.row-expand-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--fg-muted);
  width: 24px; height: 24px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background-color .15s, color .15s;
}
.row-expand-btn:hover { background: var(--bg); color: var(--fg); }
.row-expand-btn:active { background: var(--border); }
.row-expand-btn i {
  font-size: 10px;
  transition: transform .2s cubic-bezier(.4, 0, .2, 1);
}
.row-expand-btn.expanded i { transform: rotate(90deg); }

/* ---------- Linha expandida ---------- */
.expanded-row td { background: var(--bg); padding: 0 !important; border-bottom: 1px solid var(--border) !important; }
.expanded-row[hidden] { display: none; }

.expanded-content {
  padding: var(--s-4);
  animation: expandIn .22s ease-out;
}
.expanded-title {
  font-size: 12px;
  color: var(--fg-muted);
  margin-bottom: var(--s-3);
  font-variant-numeric: tabular-nums;
}
.expanded-title strong { color: var(--fg); font-weight: 500; }

.expanded-items-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--surface);
  border: 1px solid var(--border);
  font-size: 13px;
}
.expanded-items-table th {
  padding: var(--s-2) var(--s-3);
  font-size: 12px;
  color: var(--fg-muted);
  font-weight: 500;
  text-align: left;
  border-bottom: 1px solid var(--border);
}
.expanded-items-table td {
  padding: var(--s-2) var(--s-3);
  border-top: 1px solid var(--border);
}
.expanded-items-table td.text-end { font-variant-numeric: tabular-nums; }
.expanded-items-table tfoot td {
  font-weight: 600;
  border-top: 1px solid var(--border);
  background: var(--bg);
  font-variant-numeric: tabular-nums;
}

/* ---------- Paginação ---------- */
.pagination-bar {
  display: flex; justify-content: space-between; align-items: center;
  gap: var(--s-3); flex-wrap: wrap;
  padding: var(--s-3) var(--s-4);
  border-top: 1px solid var(--border);
  font-size: 13px; color: var(--fg-muted);
  font-variant-numeric: tabular-nums;
}
.pagination-controls { display: flex; align-items: center; gap: var(--s-1); }
.page-btn {
  min-width: 28px; height: 28px;
  padding: 0 var(--s-2);
  border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 4px;
  cursor: pointer;
  font: inherit; font-size: 12px;
  color: var(--fg-muted);
  transition: background-color .15s, border-color .15s, color .15s;
}
.page-btn:hover:not(:disabled) { border-color: var(--fg-muted); color: var(--fg); }
.page-btn:active:not(:disabled) { background: var(--bg); }
.page-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }
.page-btn:disabled { opacity: .4; cursor: not-allowed; }

/* ---------- Documento ---------- */
.report-doc { display: none; }
.report-doc.documento-visivel { display: block; animation: fadeIn .2s ease; }

.doc-empty {
  padding: var(--s-5) var(--s-4);
  text-align: center;
  color: var(--fg-muted);
  font-size: 13px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  margin-bottom: var(--s-4);
}
.doc-empty i { color: var(--fg-muted); margin-right: var(--s-2); font-size: 12px; opacity: .6; }

.documento { padding: var(--s-7) var(--s-6); background: var(--surface); border: 1px solid var(--border); border-radius: 4px; }

.doc-top {
  display: flex; justify-content: space-between; align-items: flex-start;
  gap: var(--s-5);
  border-bottom: 2px solid var(--primary);
  padding-bottom: var(--s-4);
  margin-bottom: var(--s-5);
}
.doc-logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  font-size: 18px; font-weight: 700; letter-spacing: .5px;
  color: var(--primary);
  margin-bottom: var(--s-2);
}
.doc-logo i { color: var(--primary); font-size: 16px; }
.doc-empresa p { font-size: 12px; color: var(--fg-muted); line-height: 1.55; }
.doc-titulo-bloco { text-align: right; min-width: 220px; }
.doc-titulo-bloco h2 { font-size: 16px; letter-spacing: 2.5px; line-height: 1.2; margin-bottom: var(--s-3); font-weight: 700; }
.doc-titulo-bloco p { font-size: 12px; color: var(--fg-muted); margin: 2px 0; font-variant-numeric: tabular-nums; }
.doc-titulo-bloco p strong { color: var(--fg); font-weight: 500; }

.doc-metadados {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: var(--s-5);
  margin-bottom: var(--s-5);
  padding-bottom: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.meta-bloco h4 { font-size: 11px; color: var(--fg-muted); font-weight: 500; text-transform: uppercase; letter-spacing: .5px; margin-bottom: var(--s-2); }
.meta-bloco p { font-size: 12px; margin: 2px 0; font-variant-numeric: tabular-nums; }
.meta-bloco p span { color: var(--fg-muted); }

.doc-status-box { font-size: 12px; font-weight: 500; }
.doc-status-box.aberto { color: var(--success); }
.doc-status-box.fechado { color: var(--fg-muted); }

.doc-secao {
  display: flex; align-items: baseline; gap: var(--s-3);
  margin: var(--s-5) 0 var(--s-3);
  padding-bottom: var(--s-2);
  border-bottom: 1px solid var(--border);
}
.doc-secao-num { font-size: 12px; font-weight: 600; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
.doc-secao h3 { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
.doc-secao-sub { font-size: 12px; color: var(--fg-muted); margin-left: auto; font-variant-numeric: tabular-nums; }

.doc-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.doc-table th {
  text-align: left; padding: var(--s-2) var(--s-3);
  background: var(--fg); color: #fff;
  font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: .3px;
}
.doc-table td { padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--border); vertical-align: middle; }
.doc-table td.text-end, .doc-table td.text-center { font-variant-numeric: tabular-nums; }
.doc-table tbody tr:nth-child(even) { background: var(--bg); }
.doc-table tfoot td { background: var(--bg); font-weight: 600; border-top: 1px solid var(--fg); font-variant-numeric: tabular-nums; }

.doc-resumo-grid { width: 100%; border-collapse: collapse; border: 1px solid var(--border); font-size: 12px; }
.doc-resumo-grid td { padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--border); }
.doc-resumo-grid tr:last-child td { border-bottom: none; }
.doc-resumo-grid .resumo-key { color: var(--fg-muted); width: 65%; background: var(--bg); }
.doc-resumo-grid .resumo-val { text-align: right; font-weight: 600; width: 35%; font-variant-numeric: tabular-nums; }
.doc-resumo-grid tr.destaque td { font-weight: 700; border-top: 1px solid var(--fg); }
.doc-resumo-grid tr.destaque .resumo-val { color: var(--primary); }

.doc-totais { margin-top: var(--s-4); display: flex; justify-content: flex-end; }
.doc-totais table { width: 300px; border-collapse: collapse; font-size: 12px; }
.doc-totais td { padding: var(--s-2) var(--s-3); font-variant-numeric: tabular-nums; }
.doc-totais td:last-child { text-align: right; }
.doc-totais tr.grand-total td { border-top: 1px solid var(--fg); padding-top: var(--s-3); font-weight: 700; font-size: 13px; }
.doc-totais tr.grand-total td:last-child { color: var(--primary); }

.doc-pagamento-bloco { border: 1px solid var(--border); border-radius: 4px; overflow: hidden; font-size: 12px; }
.pag-header { padding: var(--s-2) var(--s-3); background: var(--bg); font-size: 11px; color: var(--fg-muted); text-transform: uppercase; letter-spacing: .5px; border-bottom: 1px solid var(--border); }
.pag-linha { display: flex; justify-content: space-between; align-items: center; padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
.pag-linha:last-child { border-bottom: none; }
.pag-valor { font-weight: 600; }
.pag-pct { color: var(--fg-muted); font-size: 11px; margin-left: var(--s-2); }

.doc-assinaturas { display: flex; justify-content: space-around; gap: var(--s-5); margin-top: var(--s-6); flex-wrap: wrap; }
.doc-assinatura { text-align: center; flex: 1; max-width: 220px; min-width: 140px; }
.assinatura-linha { border-top: 1px solid var(--fg-muted); margin-bottom: var(--s-2); }
.assinatura-nome { font-size: 12px; font-weight: 500; }
.assinatura-cargo { font-size: 11px; color: var(--fg-muted); }

.doc-rodape { margin-top: var(--s-5); padding-top: var(--s-3); border-top: 1px solid var(--border); display: flex; justify-content: space-between; gap: var(--s-4); font-size: 11px; color: var(--fg-muted); flex-wrap: wrap; }

/* ---------- Modais ---------- */
.modal-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: none; align-items: center; justify-content: center; z-index: 100; padding: var(--s-5); overflow-y: auto; }
.modal-backdrop.open { display: flex; animation: fadeIn .15s ease; }
.modal { background: var(--surface); border-radius: 4px; width: 100%; max-width: 460px; }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: var(--s-4); border-bottom: 1px solid var(--border); }
.modal-header h3 { font-size: 14px; font-weight: 600; }
.modal-close { background: none; border: none; font-size: 20px; line-height: 1; cursor: pointer; color: var(--fg-muted); padding: 0 var(--s-1); transition: color .15s; }
.modal-close:hover { color: var(--fg); }
.modal-body { padding: var(--s-4); display: flex; flex-direction: column; gap: var(--s-3); }
.modal-actions { display: flex; justify-content: flex-end; gap: var(--s-2); padding: 0 var(--s-4) var(--s-4); }
.checkbox-inline { display: flex; align-items: center; gap: var(--s-2); font-size: 13px; cursor: pointer; }
.checkbox-inline input { width: 14px; height: 14px; accent-color: var(--primary); }
.modal-preview { background: var(--bg); border: 1px solid var(--border); border-radius: 4px; padding: var(--s-3); font-size: 12px; font-family: ui-monospace, monospace; color: var(--fg-muted); max-height: 140px; overflow-y: auto; white-space: pre-wrap; }

/* ---------- Responsivo ---------- */
@media (max-width: 768px) {
  .sidebar { width: 60px; }
  .sidebar .logo span, .sidebar .nav-menu a span, .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); border-left-width: 3px; }
  .sidebar .nav-menu i { margin: 0; }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { margin-left: 60px; padding: var(--s-4); }
  .search-box input { width: 140px; }
  .summary-bar { gap: var(--s-4); }
  .summary-bar .kpi-value { font-size: 18px; }
  .doc-top { flex-direction: column; }
  .doc-titulo-bloco { text-align: left; }
  .doc-metadados { grid-template-columns: 1fr; gap: var(--s-3); }
  .doc-totais table { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ---------- Impressão ---------- */
@media print {
  @page { size: A4 portrait; margin: 14mm 12mm 16mm 12mm; }
  html, body { background: #fff !important; display: block !important; font-size: 10pt; }
  .sidebar, .header, .tabs, .filters, .report-toolbar, .sales-toolbar,
  .no-print, .modal-backdrop, .pagination-bar, .btn, .doc-empty, .summary-bar { display: none !important; }
  .main-content { margin: 0 !important; padding: 0 !important; }
  .tab-panel { display: none !important; }
  .tab-panel.active { display: block !important; animation: none !important; }
  .report-doc { display: none !important; }
  .report-doc.documento-visivel { display: block !important; }
  .documento { padding: 0 !important; border: none !important; border-radius: 0 !important; }
  .doc-table thead { display: table-header-group; }
  .doc-table tr { page-break-inside: avoid; }
  .doc-metadados, .doc-assinaturas, .doc-rodape, .doc-pagamento-bloco { page-break-inside: avoid; }
}
</style>
</head>
<body>

<aside class="sidebar no-print">
  <div class="logo"><i class="fas fa-globe-americas"></i> <span>BOM MUNDO</span></div>
  <ul class="nav-menu">
    <li><a href="/dashboard" class="<%= currentPath.startsWith('/dashboard') ? 'active' : '' %>"><i class="fas fa-tachometer-alt"></i> <span>Painel principal</span></a></li>
    <li><a href="/caixa" class="<%= currentPath.startsWith('/caixa') ? 'active' : '' %>"><i class="fas fa-cash-register"></i> <span>Caixas</span></a></li>
    <li><a href="/vendas" class="<%= currentPath.startsWith('/vendas') ? 'active' : '' %>"><i class="fas fa-shopping-cart"></i> <span>Vendas</span></a></li>
    <li><a href="/produtos" class="<%= currentPath.startsWith('/produtos') ? 'active' : '' %>"><i class="fas fa-boxes"></i> <span>Estoque</span></a></li>
    <li><a href="#"><i class="fas fa-users"></i> <span>Clientes</span></a></li>
    <li><a href="#"><i class="fas fa-chart-bar"></i> <span>Relatórios</span></a></li>
    <li><a href="#"><i class="fas fa-cog"></i> <span>Configurações</span></a></li>
  </ul>
  <div class="user-info">
    <div class="user-avatar">JS</div>
    <div class="user-details">
      <div class="user-name"><%= utilizador %></div>
      <div class="user-role">Operador de Caixa</div>
    </div>
  </div>
</aside>

<main class="main-content">

  <header class="header no-print">
    <h1 class="page-title" id="page-title">Painel de vendas</h1>
    <div class="search-box">
      <i class="fas fa-search"></i>
      <input type="text" id="globalSearch" placeholder="Pesquisar vendas">
    </div>
  </header>

  <nav class="tabs no-print" role="tablist">
    <button class="tab active" data-tab="vendas" role="tab"><i class="fas fa-list"></i> Inventário</button>
    <button class="tab" data-tab="caixa" role="tab"><i class="fas fa-cash-register"></i> Caixa</button>
    <button class="tab" data-tab="relatorio" role="tab"><i class="fas fa-chart-line"></i> Vendas</button>
    <button class="tab" data-tab="pagamentos" role="tab"><i class="fas fa-credit-card"></i> Pagamentos</button>
    <button class="tab" data-tab="fecho" role="tab"><i class="fas fa-lock"></i> Fecho</button>
  </nav>

  <section class="filters no-print">
    <div class="presets">
      <button class="preset-chip" data-preset="hoje">Hoje</button>
      <button class="preset-chip" data-preset="ontem">Ontem</button>
      <button class="preset-chip" data-preset="semana">Esta semana</button>
      <button class="preset-chip" data-preset="mes">Este mês</button>
      <button class="preset-chip" data-preset="ano">Este ano</button>
      <button class="preset-chip" data-preset="todos">Todo o período</button>
    </div>

    <div class="filter-grid">
      <div class="form-group">
        <label class="form-label" for="dataInicio">Data início</label>
        <input type="date" id="dataInicio" class="form-control">
      </div>
      <div class="form-group">
        <label class="form-label" for="dataFim">Data fim</label>
        <input type="date" id="dataFim" class="form-control">
      </div>
      <div class="form-group">
        <label class="form-label" for="filtroForma">Forma de pagamento</label>
        <select id="filtroForma" class="form-control">
          <option value="">Todas</option>
          <option value="dinheiro">Dinheiro</option>
          <option value="Tpa">TPA (Multicaixa)</option>
          <option value="transferencia">Transferência</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="filtroStatus">Estado</label>
        <select id="filtroStatus" class="form-control">
          <option value="">Todos</option>
          <option value="concluida">Concluída</option>
          <option value="pendente">Pendente</option>
          <option value="cancelada">Cancelada</option>
        </select>
      </div>
    </div>

    <div class="filter-buttons">
      <button class="btn btn-primary" onclick="aplicarFiltros()">Aplicar filtros</button>
      <button class="btn btn-outline" onclick="limparFiltros()">Limpar</button>
    </div>
  </section>

  <!-- PAINEL: INVENTÁRIO -->
  <div class="tab-panel active" id="panel-vendas">
    <div class="summary-bar" id="vendasSummary"></div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-receipt"></i> Inventário de Vendas</h3>
        <a class="btn btn-primary no-print" href="/vendas/nova"><i class="fas fa-plus"></i> Nova venda</a>
      </div>

      <div class="sales-toolbar no-print">
        <div class="sales-toolbar-left">
          <div class="toolbar-search">
            <i class="fas fa-search"></i>
            <input type="text" id="tableSearch" placeholder="Código, funcionário, forma…">
          </div>
          <span id="selectionInfo"></span>
        </div>
        <div class="sales-toolbar-right">
          <label class="text-muted" style="font-size:12px;">
            Mostrar
            <select id="perPageSelect" class="per-page-select">
              <option value="10">10</option>
              <option value="25" selected>25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
          </label>
          <button class="btn btn-outline btn-sm" onclick="expandirTodas()" id="btnExpandAll"><i class="fas fa-angles-down"></i> Expandir</button>
          <button class="btn btn-outline btn-sm" onclick="recolherTodas()" id="btnCollapseAll" style="display:none;"><i class="fas fa-angles-up"></i> Recolher</button>
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table" id="tabelaVendas">
          <thead>
            <tr>
              <th style="width:36px;" class="no-print"><input type="checkbox" class="table-select" id="selectAllCheckbox"></th>
              <th style="width:36px;"></th>
              <th class="sortable" data-sort="id">Código <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th class="sortable" data-sort="data_venda">Data / Hora <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th>Funcionário</th>
              <th class="text-center sortable" data-sort="itens">Itens <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th class="sortable" data-sort="forma_pagamento">Pagamento <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th class="sortable" data-sort="status">Estado <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th class="text-end sortable" data-sort="valor">Valor líquido <span class="sort-indicator"><i class="fas fa-sort"></i></span></th>
              <th class="no-print" style="width:100px;">Ações</th>
            </tr>
          </thead>
          <tbody id="tbodyVendas"></tbody>
        </table>
      </div>

      <div class="pagination-bar no-print">
        <span id="paginationInfo">—</span>
        <div class="pagination-controls" id="paginationControls"></div>
      </div>
    </div>
  </div>

  <!-- PAINEL: CAIXA -->
  <div class="tab-panel" id="panel-caixa">
    <div class="report-toolbar no-print">
      <div class="report-toolbar-info">Período: <strong id="caixaPeriodoLabel">—</strong></div>
      <div class="report-toolbar-actions">
        <button class="btn btn-primary btn-sm" id="btnGerarCaixa" onclick="gerarDocumento('caixa')"><i class="fas fa-file-lines"></i> Gerar documento</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="imprimirRelatorio()" disabled><i class="fas fa-print"></i> Imprimir</button>
        <button class="btn btn-outline btn-sm export-btn" data-export="pdf" onclick="baixarPDF('caixa')" disabled><i class="fas fa-file-pdf"></i> PDF</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="baixarCSV('caixa')" disabled><i class="fas fa-file-csv"></i> CSV</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="abrirModalWhatsApp('caixa')" disabled><i class="fab fa-whatsapp"></i> WhatsApp</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="abrirModalEmail('caixa')" disabled><i class="fas fa-envelope"></i> Email</button>
      </div>
    </div>

    <div class="doc-empty" id="caixaPlaceholder"><i class="fas fa-file-invoice"></i> Documento não gerado.</div>

    <div class="report-doc" id="caixaReport">
      <div class="documento">
        <div class="doc-top">
          <div class="doc-empresa">
            <div class="doc-logo"><i class="fas fa-globe-americas"></i> BOM MUNDO</div>
            <p>Comércio Geral e Prestação de Serviços</p>
            <p>NIF: 5000000000</p>
            <p>Rua da Liberdade, nº 123 — Luanda, Angola</p>
            <p>Tel: +244 900 000 000 · geral@bomundo.ao</p>
          </div>
          <div class="doc-titulo-bloco">
            <h2>RELATÓRIO DE CAIXA</h2>
            <p>Documento: <strong id="phCaixaDocNum">—</strong></p>
            <p>Período: <strong id="phCaixaPeriodo">—</strong></p>
            <p>Emitido: <strong id="phCaixaEmitido">—</strong></p>
            <p>Operador: <strong><%= utilizador %></strong></p>
          </div>
        </div>

        <div class="doc-metadados">
          <div class="meta-bloco"><h4>Caixa</h4><p>Nº: <strong id="phCaixaNumero">—</strong></p><p>Estado: <span id="phCaixaEstadoInline">—</span></p></div>
          <div class="meta-bloco"><h4>Responsável</h4><p><strong><%= utilizador %></strong></p><p>Operador de Caixa</p></div>
          <div class="meta-bloco"><h4>Totalização</h4><p>Vendas: <strong id="phCaixaNumVendas">—</strong></p><p>Ticket médio: <strong id="phCaixaTicketMedio">—</strong></p></div>
        </div>

        <div class="doc-secao"><span class="doc-secao-num">1</span><h3>Resumo do período</h3></div>
        <table class="doc-resumo-grid"><tbody id="caixaResumoTable"></tbody></table>

        <div class="doc-secao"><span class="doc-secao-num">2</span><h3>Movimentos</h3><span class="doc-secao-sub" id="phCaixaVendasCount">—</span></div>
        <table class="doc-table">
          <colgroup><col style="width:8%"><col style="width:32%"><col style="width:28%"><col style="width:18%"><col style="width:14%"></colgroup>
          <thead><tr><th>#</th><th>Data / Hora</th><th>Pagamento</th><th>Estado</th><th class="text-end">Total</th></tr></thead>
          <tbody id="caixaTbody"></tbody>
          <tfoot id="caixaTfoot"></tfoot>
        </table>

        <div class="doc-secao"><span class="doc-secao-num">3</span><h3>Totais por forma de pagamento</h3></div>
        <div class="doc-pagamento-bloco">
          <div class="pag-header">Distribuição</div>
          <div id="caixaPagamentosPrint"></div>
        </div>

        <div class="doc-totais">
          <table>
            <tr><td>Total bruto</td><td id="phCaixaTotalBruto">—</td></tr>
            <tr><td>Descontos</td><td id="phCaixaDescontos" class="text-danger">—</td></tr>
            <tr class="grand-total"><td>TOTAL LÍQUIDO</td><td id="phCaixaTotalLiquido">—</td></tr>
          </table>
        </div>

        <div class="doc-assinaturas">
          <div class="doc-assinatura"><div class="assinatura-linha"></div><div class="assinatura-nome"><%= utilizador %></div><div class="assinatura-cargo">Operador de Caixa</div></div>
          <div class="doc-assinatura"><div class="assinatura-linha"></div><div class="assinatura-nome">Supervisor / Responsável</div><div class="assinatura-cargo">Conferência e Visto</div></div>
        </div>

        <div class="doc-rodape">
          <div>Emitido em <span id="phCaixaFooterData">—</span>.</div>
          <div>Bom Mundo — Sistema de Gestão de Vendas</div>
        </div>
      </div>
    </div>
  </div>

  <!-- PAINEL: RELATÓRIO DE VENDAS -->
  <div class="tab-panel" id="panel-relatorio">
    <div class="report-toolbar no-print">
      <div class="report-toolbar-info">Período: <strong id="relPeriodoLabel">—</strong></div>
      <div class="report-toolbar-actions">
        <button class="btn btn-primary btn-sm" id="btnGerarRelatorio" onclick="gerarDocumento('relatorio')"><i class="fas fa-file-lines"></i> Gerar documento</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="imprimirRelatorio()" disabled><i class="fas fa-print"></i> Imprimir</button>
        <button class="btn btn-outline btn-sm export-btn" data-export="pdf" onclick="baixarPDF('relatorio')" disabled><i class="fas fa-file-pdf"></i> PDF</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="baixarCSV('relatorio')" disabled><i class="fas fa-file-csv"></i> CSV</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="abrirModalWhatsApp('relatorio')" disabled><i class="fab fa-whatsapp"></i> WhatsApp</button>
        <button class="btn btn-outline btn-sm export-btn" onclick="abrirModalEmail('relatorio')" disabled><i class="fas fa-envelope"></i> Email</button>
      </div>
    </div>

    <div class="doc-empty" id="relatorioPlaceholder"><i class="fas fa-chart-line"></i> Documento não gerado.</div>

    <div class="report-doc" id="relatorioReport">
      <div class="documento">
        <div class="doc-top">
          <div class="doc-empresa">
            <div class="doc-logo"><i class="fas fa-globe-americas"></i> BOM MUNDO</div>
            <p>Comércio Geral e Prestação de Serviços</p>
            <p>NIF: 5000000000</p>
            <p>Rua da Liberdade, nº 123 — Luanda, Angola</p>
            <p>Tel: +244 900 000 000 · geral@bomundo.ao</p>
          </div>
          <div class="doc-titulo-bloco">
            <h2>RELATÓRIO DE VENDAS</h2>
            <p>Documento: <strong id="phRelDocNum">—</strong></p>
            <p>Período: <strong id="phRelPeriodo">—</strong></p>
            <p>Emitido: <strong id="phRelEmitido">—</strong></p>
            <p>Operador: <strong><%= utilizador %></strong></p>
          </div>
        </div>

        <div class="doc-metadados">
          <div class="meta-bloco"><h4>Resumo</h4><p>Vendas: <strong id="phRelNumVendas">—</strong></p><p>Ticket médio: <strong id="phRelTicketMedio">—</strong></p></div>
          <div class="meta-bloco"><h4>Estados</h4><p>Concluídas: <strong id="phRelConcluidas">—</strong></p><p>Pendentes: <strong id="phRelPendentes">—</strong></p></div>
          <div class="meta-bloco"><h4>Totalização</h4><p>Bruto: <strong id="phRelBruto">—</strong></p><p>Líquido: <strong id="phRelLiquido">—</strong></p></div>
        </div>

        <div class="doc-secao"><span class="doc-secao-num">1</span><h3>Resumo do período</h3></div>
        <table class="doc-resumo-grid"><tbody id="relResumoTable"></tbody></table>

        <div class="doc-secao"><span class="doc-secao-num">2</span><h3>Detalhe das vendas</h3><span class="doc-secao-sub" id="phRelVendasCount">—</span></div>
        <table class="doc-table">
          <colgroup><col style="width:6%"><col style="width:16%"><col style="width:18%"><col style="width:20%"><col style="width:14%"><col style="width:12%"><col style="width:14%"></colgroup>
          <thead><tr><th>#</th><th>Data / Hora</th><th>Funcionário</th><th>Pagamento</th><th>Estado</th><th class="text-end">Desconto</th><th class="text-end">Total</th></tr></thead>
          <tbody id="relTbody"></tbody>
          <tfoot id="relTfoot"></tfoot>
        </table>

