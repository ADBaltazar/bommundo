function renderClientes(termo) {
    const list = document.getElementById('clientesList');
    const t = (termo || '').toLowerCase().trim();
    const filtrados = CLIENTES.filter(c => !t || (c.nome || '').toLowerCase().includes(t) || (c.nif || '').toLowerCase().includes(t));
    if (!filtrados.length) {
        list.innerHTML = `<div class="resultados-empty" style="padding: var(--s-5) var(--s-3);"><i class="fas fa-user-slash"></i><span>Nenhum cliente.</span></div>`;
        return;
    }
    list.innerHTML = filtrados.map((c, idx) => {
        const iniciais = (c.nome || '??').split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();
        return `
            <div class="cliente-resultado" data-cliente-idx="${idx}">
                <div class="avatar">${iniciais}</div>
                <div class="info">
                    <div class="nome">${escapeHtml(c.nome)}</div>
                    <div class="meta">
                        <span><i class="fas fa-id-card"></i>${escapeHtml(c.nif || '—')}</span>
                        <span><i class="fas fa-phone"></i>${escapeHtml(c.telefone || '—')}</span>
                    </div>
                </div>
                <i class="fas fa-chevron-right"></i>
            </div>`;
    }).join('');
    list.querySelectorAll('[data-cliente-idx]').forEach(el => {
        el.addEventListener('click', () => {
            const idx = parseInt(el.dataset.clienteIdx, 10);
            selecionarCliente(filtrados[idx]);
        });
    });
}
document.getElementById('clienteSearch')?.addEventListener('input', e => renderClientes(e.target.value));

function selecionarCliente(c) {
    clienteSelecionado = c;
    atualizarClientePill();
    renderPreFactura();
    fecharModal('clienteModal');
}
function selecionarConsumidorFinal() {
    clienteSelecionado = null;
    atualizarClientePill();
    renderPreFactura();
    fecharModal('clienteModal');
}

document.getElementById('novoClienteForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const dados = {
        nome: document.getElementById('ncNome').value.trim(),
        nif: document.getElementById('ncNif').value.trim(),
        telefone: document.getElementById('ncTelefone').value.trim(),
        email: document.getElementById('ncEmail').value.trim(),
        endereco: document.getElementById('ncEndereco').value.trim()
    };
    if (!dados.nome) { toast('Introduza o nome.', 'error'); return; }
    const btnSubmit = document.getElementById('btnGuardarCliente');
    if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.dataset.original = btnSubmit.innerHTML; btnSubmit.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A guardar…'; }
    try {
        const resp = await fetch('/clientes/novo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dados) });
        let data = {};
        try { data = await resp.json(); } catch(err) {}
        if (!resp.ok) throw new Error(data.erro || 'Falha ao registar.');
        const novoCliente = data.cliente || Object.assign({ id: data.id || 'novo-' + Date.now() }, dados);
        CLIENTES.push(novoCliente);
        selecionarCliente(novoCliente);
        this.reset();
    } catch (err) {
        const novoCliente = Object.assign({ id: 'local-' + Date.now() }, dados);
        CLIENTES.push(novoCliente);
        selecionarCliente(novoCliente);
        this.reset();
    } finally {
        if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.innerHTML = btnSubmit.dataset.original || 'Guardar'; }
    }
});

/* ---------- FACTURA ---------- */
function obterPagamentosParaFactura() {
    if (modoPagamento === 'simples') return [{ metodo: metodoSimples, valor: getTotal() }];
    return pagamentos.map(p => ({ metodo: p.metodo, valor: Number(p.valor) || 0 }));
}

function construirFacturaDocHTML() {
    const agora = new Date();
    const numero = document.getElementById('pfNumero').textContent;
    const subtotal = getSubtotal();
    const desconto = getDesconto();
    const total = getTotal();
    const pagamentosFinal = obterPagamentosParaFactura();
    const distribuido = pagamentosFinal.reduce((s, p) => s + p.valor, 0);
    const troco = Math.max(0, distribuido - total);

    const clienteInfo = clienteSelecionado
        ? `<p><strong>${escapeHtml(clienteSelecionado.nome)}</strong></p>
           <p><span>NIF:</span> ${escapeHtml(clienteSelecionado.nif || '—')}</p>
           <p><span>Tel:</span> ${escapeHtml(clienteSelecionado.telefone || '—')}</p>
           ${clienteSelecionado.endereco ? `<p><span>Endereço:</span> ${escapeHtml(clienteSelecionado.endereco)}</p>` : ''}`
        : `<p><strong>Consumidor Final</strong></p>
           <p><span>NIF:</span> —</p>`;

    const itensHTML = carrinho.map((item, idx) => `
        <tr>
            <td>${idx + 1}</td>
            <td>${escapeHtml(item.nome)}</td>
            <td class="text-center">${item.quantidade}</td>
            <td class="text-end">${fmtKz(item.preco)}</td>
            <td class="text-end"><strong>${fmtKz(item.subtotal)}</strong></td>
        </tr>`).join('');

    const totalItens = carrinho.reduce((s, i) => s + i.quantidade, 0);

    const pagamentosHTML = pagamentosFinal.map(p => `
        <div class="fp-pgto-linha">
            <span class="metodo">${renderPayMethod(p.metodo)}</span>
            <span class="valor">${fmtKz(p.valor)}</span>
        </div>`).join('');

    const trocoHTML = troco > 0.01
        ? `<div class="fp-pgto-linha troco"><span class="metodo">Troco a devolver</span><span class="valor">${fmtKz(troco)}</span></div>`
        : '';

    return `
        <div class="fp-header">
            <div class="fp-brand">
                <div class="fp-brand-logo"><i class="fas fa-globe-americas"></i> BOM MUNDO</div>
                <p>Comércio Geral e Prestação de Serviços</p>
                <p>NIF: 5000000000</p>
                <p>Rua da Liberdade, nº 123 — Luanda, Angola</p>
                <p>Tel: +244 900 000 000</p>
            </div>
            <div class="fp-doc">
                <h3>FACTURA</h3>
                <p><span>Nº:</span> <strong>${escapeHtml(numero)}</strong></p>
                <p><span>Data:</span> <strong>${agora.toLocaleDateString('pt-AO')}</strong></p>
                <p><span>Hora:</span> <strong>${agora.toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit' })}</strong></p>
                <p><span>Operador:</span> <strong>${escapeHtml(OPERADOR)}</strong></p>
                ${CAIXA_ID ? `<p><span>Caixa:</span> <strong>#${escapeHtml(String(CAIXA_ID))}</strong></p>` : ''}
            </div>
        </div>

        <div class="fp-cliente">
            <div class="bloco">
                <h4>Exmo.(a) Senhor(a)</h4>
                ${clienteInfo}
            </div>
            <div class="bloco">
                <h4>Resumo</h4>
                <p><span>Nº de itens:</span> <strong>${totalItens}</strong></p>
                <p><span>Refs. distintas:</span> <strong>${carrinho.length}</strong></p>
                <p><span>Estado:</span> <strong>Pré-venda</strong></p>
            </div>
        </div>

        <table class="fp-table">
            <thead>
                <tr>
                    <th style="width:32px;">#</th>
                    <th>Descrição</th>
                    <th class="text-center" style="width:60px;">Qtd.</th>
                    <th class="text-end" style="width:100px;">Preço unit.</th>
                    <th class="text-end" style="width:110px;">Subtotal</th>
                </tr>
            </thead>
            <tbody>${itensHTML}</tbody>
        </table>

        <div class="fp-totais">
            <table>
                <tr><td>Subtotal</td><td>${fmtKz(subtotal)}</td></tr>
                ${desconto > 0 ? `<tr><td>Desconto</td><td>- ${fmtKz(desconto)}</td></tr>` : ''}
                <tr class="grand-total"><td>TOTAL A PAGAR</td><td>${fmtKz(total)}</td></tr>
            </table>
        </div>

        <div class="fp-pgto-bloco">
            <h4>Pagamento</h4>
            ${pagamentosHTML}
            ${trocoHTML}
            <div class="fp-pgto-linha total-pago">
                <span class="metodo">Total pago</span>
                <span class="valor">${fmtKz(distribuido)}</span>
            </div>
        </div>

        <div class="fp-aviso">
            Documento de <strong>pré-venda</strong> para conferência. Será gerado o documento fiscal definitivo após confirmação.
        </div>

        <div class="fp-assinatura">
            <div class="linha"></div>
            <div class="lbl">Assinatura do cliente</div>
        </div>

        <div class="fp-footer">
            <div>Documento processado por computador.<br>Emitido em ${agora.toLocaleString('pt-AO')}.</div>
            <div style="text-align:right;">Bom Mundo — Comércio Geral</div>
        </div>
    `;
}

/* ---------- FINALIZAR ---------- */
function abrirConfirmacao() {
    if (carrinho.length === 0) { toast('Adicione pelo menos um produto.', 'error'); searchInput?.focus(); return; }

    const total = getTotal();
    const distribuido = getDistribuido();
    const diff = total - distribuido;
    if (modoPagamento === 'split' && diff > 0.01) {
        toast('Falta distribuir ' + fmtKz(diff) + '.', 'error', 4000);
        return;
    }
    document.getElementById('facturaDoc').innerHTML = construirFacturaDocHTML();
    abrirModal('confirmarModal');
}

document.getElementById('btnFinalizar')?.addEventListener('click', abrirConfirmacao);

document.getElementById('btnConfirmarReal')?.addEventListener('click', function() {
    const form = document.getElementById('vendaForm');
    document.getElementById('produtosData').value = JSON.stringify(carrinho.map(i => i.id));
    document.getElementById('quantidadesData').value = JSON.stringify(carrinho.map(i => i.quantidade));

    const pagamentosPayload = obterPagamentosParaFactura();
    document.getElementById('pagamentosData').value = JSON.stringify(pagamentosPayload);

    const formaPrincipal = pagamentosPayload.length === 1 ? pagamentosPayload[0].metodo : 'multiplo';
    document.getElementById('formaPagamentoPrincipal').value = formaPrincipal;

    this.disabled = true;
    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A gravar…';
    form.submit();
});

/* ---------- ATALHOS ---------- */
document.addEventListener('keydown', e => {
    if (e.key === 'F2') { e.preventDefault(); abrirConfirmacao(); return; }

    if (e.key === 'Escape') {
        if (document.getElementById('novoProdutoModal').classList.contains('open')) {
            tentarFecharNovoProduto();
            return;
        }
        if (document.getElementById('clienteModal').classList.contains('open')) {
            fecharModal('clienteModal');
            return;
        }
        if (document.getElementById('confirmarModal').classList.contains('open')) {
            fecharModal('confirmarModal');
            return;
        }
        if (searchInput && document.activeElement !== searchInput) {
            searchInput.value = '';
            filtroTermo = '';
            mostrarProdutosIniciais();
            searchInput.focus();
        }
        return;
    }

    if (e.key === '/' &&
        document.activeElement.tagName !== 'INPUT' &&
        document.activeElement.tagName !== 'TEXTAREA' &&
        !document.getElementById('clienteModal').classList.contains('open') &&
        !document.getElementById('novoProdutoModal').classList.contains('open')) {
        e.preventDefault();
        searchInput?.focus();
    }
});

/* ---------- INIT ---------- */
atualizarClientePill();
renderPreFactura();
mostrarProdutosIniciais();
setTimeout(() => searchInput?.focus(), 100);
</script>

</body>
</html>