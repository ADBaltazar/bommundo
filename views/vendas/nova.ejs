<%
  const operadorNome = (
    (typeof utilizador !== 'undefined' && utilizador) ? utilizador :
    ((typeof usuario !== 'undefined' && usuario) ? usuario :
    ((typeof usuário !== 'undefined' && usuário) ? usuário : 'Operador'))
  );
  const listaClientes = (typeof clientes !== 'undefined' && Array.isArray(clientes)) ? clientes : [];
  const caixaId = (typeof caixa !== 'undefined' && caixa && caixa.id) ? caixa.id : '';
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nova Venda — Bom Mundo</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
  --bg:             #fafafa;
  --surface:        #ffffff;
  --border:         #e5e5e5;
  --fg:             #1a1a1a;
  --fg-muted:       #666666;
  --primary:        #c62828;
  --primary-hover:  #a01f1f;
  --primary-active: #8b1a1a;
  --success:        #16a34a;
  --warning:        #b45309;
  --info:           #2563eb;
  --danger:         #c62828;
  --focus:          #1a1a1a;

  --s-1: 4px;  --s-2: 8px;  --s-3: 12px; --s-4: 16px;
  --s-5: 24px; --s-6: 32px; --s-7: 48px;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg);
  background: var(--bg);
  display: flex;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }

::selection { background: var(--fg); color: var(--bg); }

:focus { outline: none; }
:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

/* ---------- Animações ---------- */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- Botões ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border: 1px solid transparent;
  border-radius: 4px;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.4;
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
  white-space: nowrap;
}
.btn i { font-size: 11px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }

.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-hover); }
.btn-primary:active:not(:disabled) { background: var(--primary-active); }
.btn-primary i { color: #fff; }

.btn-outline { background: var(--surface); color: var(--fg); border-color: var(--border); }
.btn-outline:hover:not(:disabled) { border-color: var(--fg-muted); }
.btn-outline:active:not(:disabled) { background: var(--bg); }
.btn-outline i { color: var(--fg-muted); }

.btn-ghost { background: transparent; color: var(--fg-muted); }
.btn-ghost:hover:not(:disabled) { background: var(--bg); color: var(--fg); }

.btn-sm { padding: var(--s-1) var(--s-2); font-size: 12px; }
.btn-block { display: flex; width: 100%; justify-content: center; }

/* ---------- Sidebar ---------- */
.sidebar {
  width: 220px;
  background: #1a1a1a;
  color: #d4d4d4;
  height: 100vh;
  position: fixed;
  inset: 0 auto 0 0;
  display: flex;
  flex-direction: column;
  padding: var(--s-5) 0;
  z-index: 100;
  overflow-y: auto;
}
.logo {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: 0 var(--s-5) var(--s-5);
  font-size: 15px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: .5px;
  border-bottom: 1px solid #2a2a2a;
  margin-bottom: var(--s-4);
}
.logo i { color: var(--primary); font-size: 15px; }

.nav-menu { list-style: none; flex: 1; }
.nav-menu a {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  padding: var(--s-3) var(--s-5);
  font-size: 13px;
  font-weight: 500;
  color: #d4d4d4;
  border-left: 3px solid transparent;
  transition: background-color .2s ease, color .2s ease, border-color .2s ease;
}
.nav-menu a:hover { background: #2a2a2a; color: var(--primary); }
.nav-menu a:hover i { color: var(--primary); }
.nav-menu a.active {
  background: #2a2a2a;
  color: var(--primary);
  border-left-color: var(--primary);
}
.nav-menu a.active i { color: var(--primary); }
.nav-menu a:focus-visible { outline-color: #fff; }
.nav-menu i {
  width: 16px;
  text-align: center;
  font-size: 12px;
  color: #666;
  transition: color .2s ease;
}

.user-info {
  padding: var(--s-4) var(--s-5) 0;
  border-top: 1px solid #2a2a2a;
  display: flex;
  align-items: center;
  gap: var(--s-3);
  margin-top: var(--s-4);
}
.user-avatar {
  width: 32px; height: 32px;
  background: var(--primary);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 600; color: #fff;
  flex-shrink: 0;
}
.user-details { min-width: 0; flex: 1; }
.user-name { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-role { font-size: 12px; color: #888; }

/* ---------- Main ---------- */
.main-content {
  flex: 1;
  margin-left: 220px;
  padding: var(--s-4);
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--s-3);
  height: 100vh;
  overflow: hidden;
}

/* ---------- Topbar ---------- */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--s-3);
  flex-wrap: wrap;
  flex-shrink: 0;
}
.topbar-left { display: flex; align-items: center; gap: var(--s-3); }
.topbar-back {
  width: 36px; height: 36px;
  border-radius: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--fg-muted);
  transition: color .15s, border-color .15s;
}
.topbar-back:hover { color: var(--primary); border-color: var(--primary); }
.topbar-left h1 { font-size: 18px; font-weight: 600; letter-spacing: -.005em; }
.topbar-left .page-subtitle {
  font-size: 12px;
  color: var(--fg-muted);
  margin-top: 2px;
  display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap;
}
.topbar-left .page-subtitle kbd {
  background: var(--surface);
  border: 1px solid var(--border);
  border-bottom-width: 2px;
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 10px;
  font-family: ui-monospace, Consolas, monospace;
  color: var(--fg-muted);
  font-weight: 600;
}
.topbar-left .page-subtitle .caixa-open {
  color: var(--success);
  font-weight: 500;
  display: flex; align-items: center; gap: var(--s-1);
}
.topbar-left .page-subtitle .caixa-open::before {
  content: '';
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--success);
}

.topbar-right { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }

/* ---------- Cliente pill ---------- */
.cliente-pill {
  display: inline-flex;
  align-items: center;
  gap: var(--s-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: var(--s-1) var(--s-3) var(--s-1) var(--s-1);
  cursor: pointer;
  transition: border-color .15s;
}
.cliente-pill:hover { border-color: var(--fg-muted); }
.cliente-pill:active { background: var(--bg); }
.cliente-pill .avatar {
  width: 26px; height: 26px;
  border-radius: 50%;
  background: var(--fg-muted);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
  font-size: 11px;
  flex-shrink: 0;
}
.cliente-pill.has-cliente .avatar { background: var(--success); }
.cliente-pill .text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}
.cliente-pill .text .lbl { font-size: 10px; color: var(--fg-muted); font-weight: 500; }
.cliente-pill .text .nome {
  font-size: 13px;
  font-weight: 500;
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 160px;
}
.cliente-pill .caret { color: var(--fg-muted); font-size: 10px; padding-right: var(--s-1); }

/* ---------- Banner de aviso ---------- */
.warning-banner {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--warning);
  border-radius: 4px;
  padding: var(--s-3) var(--s-4);
  color: var(--warning);
  font-size: 13px;
  display: flex;
  gap: var(--s-3);
  align-items: center;
}
.warning-banner i { font-size: 14px; }
.warning-banner strong { color: var(--fg); font-weight: 500; }
.warning-banner a { color: var(--primary); font-weight: 500; text-decoration: underline; }

/* ---------- Layout grid ---------- */
.main-grid {
  display: grid;
  grid-template-columns: 1fr 440px;
  gap: var(--s-3);
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.col-pesquisa { display: flex; flex-direction: column; gap: var(--s-3); min-height: 0; }
.col-prefactura { display: flex; flex-direction: column; min-height: 0; }

/* ---------- Search card ---------- */
.search-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: var(--s-3);
  flex-shrink: 0;
}
.search-wrapper { position: relative; }
.search-wrapper input {
  width: 100%;
  padding: var(--s-3) 100px var(--s-3) 40px;
  font-size: 15px;
  font-weight: 500;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  color: var(--fg);
  caret-color: var(--primary);
  transition: border-color .15s;
}
.search-wrapper input::placeholder { color: #999; font-weight: 400; }
.search-wrapper input:focus {
  outline: 2px solid var(--focus);
  outline-offset: 1px;
  border-color: var(--fg);
}
.search-wrapper .search-icon {
  position: absolute;
  left: var(--s-3);
  top: 50%;
  transform: translateY(-50%);
  color: var(--fg-muted);
  font-size: 14px;
  pointer-events: none;
  transition: color .15s;
}
.search-wrapper:focus-within .search-icon { color: var(--primary); }
.search-wrapper .search-hint {
  position: absolute;
  right: var(--s-2);
  top: 50%;
  transform: translateY(-50%);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 1px 6px;
  font-size: 10px;
  font-weight: 500;
  color: var(--fg-muted);
  font-family: ui-monospace, Consolas, monospace;
  pointer-events: none;
}
.search-wrapper .search-status {
  position: absolute;
  right: var(--s-3);
  top: 50%;
  transform: translateY(-50%);
  font-size: 12px;
  color: var(--fg-muted);
  display: none;
  align-items: center;
  gap: var(--s-2);
}
.search-wrapper.loading .search-status { display: flex; }
.search-wrapper.loading .search-hint { display: none; }
.search-wrapper .spinner {
  width: 12px;
  height: 12px;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin .7s linear infinite;
  display: inline-block;
}

/* ---------- Filtros rápidos ---------- */
.filtros-rapidos { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-top: var(--s-3); }
.chip {
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: var(--s-1) var(--s-3);
  font: inherit;
  font-size: 12px;
  color: var(--fg-muted);
  cursor: pointer;
  transition: background-color .15s, border-color .15s, color .15s;
}
.chip:hover { border-color: var(--fg-muted); color: var(--fg); background: var(--bg); }
.chip:active { background: var(--border); }
.chip.active { background: var(--fg); border-color: var(--fg); color: #fff; }
.chip i { font-size: 10px; }
.chip .chip-add {
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: var(--s-1) var(--s-3);
  font: inherit;
  font-size: 12px;
  color: var(--primary);
  cursor: pointer;
  transition: background-color .15s, border-color .15s;
  margin-left: auto;
}
.chip .chip-add:hover { border-color: var(--primary); background: rgba(198,40,40,.04); }

/* ---------- Resultados ---------- */
.resultados-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}
.resultados-head {
  padding: var(--s-2) var(--s-4);
  border-bottom: 1px solid var(--border);
  background: var(--bg);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  font-size: 12px;
  color: var(--fg-muted);
}
.resultados-head .info { display: flex; align-items: center; gap: var(--s-2); }
.resultados-head .info strong { color: var(--fg); font-weight: 500; }
.resultados-head .modo { font-size: 11px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }

.resultados-list { flex: 1; overflow-y: auto; padding: var(--s-1); min-height: 0; }

.resultado-item {
  display: grid;
  grid-template-columns: 40px 1fr auto auto;
  gap: var(--s-3);
  align-items: center;
  padding: var(--s-2) var(--s-3);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color .12s;
  border: 1px solid transparent;
}
.resultado-item:hover { background: var(--bg); }
.resultado-item:active { background: var(--border); }
.resultado-item.out-of-stock { opacity: .45; cursor: not-allowed; }
.resultado-item.out-of-stock:hover { background: transparent; }

.resultado-thumb {
  width: 40px; height: 40px;
  border-radius: 4px;
  background: var(--bg);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  color: var(--fg-muted);
  font-size: 14px;
  flex-shrink: 0;
}
.resultado-info { min-width: 0; }
.resultado-info .nome {
  font-size: 13px;
  font-weight: 500;
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px;
}
.resultado-info .meta {
  font-size: 11px;
  color: var(--fg-muted);
  display: flex;
  gap: var(--s-3);
  flex-wrap: wrap;
  font-variant-numeric: tabular-nums;
}
.resultado-info .meta i { font-size: 9px; margin-right: var(--s-1); }
.resultado-info .meta b { color: var(--fg); font-weight: 500; }
.resultado-info .meta .low-stock { color: var(--warning); font-weight: 500; }
.resultado-info .meta .no-stock { color: var(--danger); font-weight: 500; }

.resultado-preco { text-align: right; flex-shrink: 0; }
.resultado-preco .preco {
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
  display: block;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.resultado-preco .stock {
  font-size: 10px;
  color: var(--fg-muted);
  margin-top: 2px;
  display: block;
}
.resultado-preco .stock.low { color: var(--warning); }
.resultado-preco .stock.zero { color: var(--danger); }

.resultado-add {
  width: 30px; height: 30px;
  border-radius: 4px;
  background: var(--primary);
  color: #fff;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  cursor: pointer;
  transition: background-color .15s;
  flex-shrink: 0;
}
.resultado-add:hover:not(:disabled) { background: var(--primary-hover); }
.resultado-add:active:not(:disabled) { background: var(--primary-active); }
.resultado-add:disabled { background: var(--border); color: var(--fg-muted); cursor: not-allowed; }

.resultados-empty {
  text-align: center;
  padding: var(--s-6) var(--s-4);
  color: var(--fg-muted);
  font-size: 13px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.resultados-empty i { color: var(--fg-muted); font-size: 20px; opacity: .5; margin-bottom: var(--s-3); }

/* ---------- Pay method dot (reutilizável) ---------- */
.pay-method {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.pay-method::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--fg-muted);
  opacity: .8;
}
.pay-dinheiro::before     { background: var(--success); }
.pay-cartao_debito::before { background: var(--info); }
.pay-transferencia::before { background: var(--warning); }

/* ---------- Pre-factura ---------- */
.prefactura {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.prefactura-header {
  padding: var(--s-4) var(--s-4);
  background: #1a1a1a;
  color: #fff;
  flex-shrink: 0;
}
.prefactura-header .title {
  font-size: 11px;
  color: rgba(255,255,255,.6);
  font-weight: 500;
  letter-spacing: .5px;
  margin-bottom: var(--s-2);
}
.prefactura-header .numero {
  font-size: 16px;
  font-weight: 600;
  letter-spacing: .3px;
  font-variant-numeric: tabular-nums;
}
.prefactura-header .meta {
  margin-top: var(--s-2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: rgba(255,255,255,.7);
  font-variant-numeric: tabular-nums;
}
.prefactura-header .cliente-inline {
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
  background: rgba(255,255,255,.1);
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 500;
  color: #fff;
}

.prefactura-itens { flex: 1; overflow-y: auto; min-height: 0; }

.prefactura-item {
  display: grid;
  grid-template-columns: auto 1fr auto 26px;
  gap: var(--s-2);
  align-items: center;
  padding: var(--s-2) var(--s-4);
  border-bottom: 1px solid var(--border);
  transition: background-color .15s;
}
.prefactura-item:last-child { border-bottom: none; }
.prefactura-item:hover { background: var(--bg); }

.qty-mini {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  background: var(--surface);
  flex-shrink: 0;
}
.qty-mini button {
  width: 22px; height: 24px;
  background: var(--bg);
  border: none;
  color: var(--fg-muted);
  font-size: 10px;
  cursor: pointer;
  transition: background-color .15s, color .15s;
}
.qty-mini button:hover:not(:disabled) { background: var(--primary); color: #fff; }
.qty-mini button:active:not(:disabled) { background: var(--primary-active); }
.qty-mini button:disabled { opacity: .3; cursor: not-allowed; }
.qty-mini .qty-value {
  width: 28px;
  text-align: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--fg);
  line-height: 24px;
  font-variant-numeric: tabular-nums;
}

.prefactura-item .info { min-width: 0; }
.prefactura-item .nome {
  font-size: 12px;
  font-weight: 500;
  color: var(--fg);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.prefactura-item .unit { font-size: 11px; color: var(--fg-muted); margin-top: 1px; font-variant-numeric: tabular-nums; }
.prefactura-item .valor {
  font-size: 12px;
  font-weight: 600;
  color: var(--fg);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.prefactura-item .remove {
  width: 24px; height: 24px;
  border-radius: 4px;
  background: transparent;
  border: none;
  color: var(--fg-muted);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 10px;
  cursor: pointer;
  transition: background-color .15s, color .15s;
}
.prefactura-item .remove:hover { background: rgba(198,40,40,.06); color: var(--primary); }

.prefactura-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--fg-muted);
  padding: var(--s-5);
  font-size: 13px;
}
.prefactura-empty i { color: var(--fg-muted); font-size: 20px; opacity: .4; margin-bottom: var(--s-2); }

.prefactura-totais {
  padding: var(--s-3) var(--s-4);
  background: var(--bg);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
.prefactura-totais .linha {
  display: flex;
  justify-content: space-between;
  padding: 2px 0;
  font-size: 12px;
  color: var(--fg-muted);
}
.prefactura-totais .linha .val { font-weight: 500; color: var(--fg); font-variant-numeric: tabular-nums; }
.prefactura-totais .linha .val.red { color: var(--danger); }
.prefactura-totais .linha.grande {
  font-size: 16px;
  font-weight: 600;
  color: var(--fg);
  padding-top: var(--s-2);
  margin-top: var(--s-2);
  border-top: 1px solid var(--border);
}
.prefactura-totais .linha.grande .val { color: var(--primary); font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }

/* ---------- Pagamento ---------- */
.prefactura-pgto {
  padding: var(--s-3) var(--s-4);
  background: var(--bg);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
.prefactura-pgto .label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11px;
  color: var(--fg-muted);
  font-weight: 500;
  margin-bottom: var(--s-2);
}
.prefactura-pgto .btn-add-pgto {
  background: transparent;
  border: 1px dashed var(--border);
  color: var(--fg-muted);
  padding: 1px 8px;
  border-radius: 999px;
  font: inherit;
  font-size: 11px;
  cursor: pointer;
  transition: border-color .15s, color .15s;
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
}
.prefactura-pgto .btn-add-pgto:hover { border-color: var(--fg-muted); color: var(--fg); }

/* Tabs de pagamento */
.pgto-tabs { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--s-2); }
.pgto-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: var(--s-2) var(--s-1);
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  cursor: pointer;
  transition: border-color .15s, background-color .15s, color .15s;
}
.pgto-tab:hover { border-color: var(--fg-muted); }
.pgto-tab.selected {
  border-color: var(--primary);
  background: rgba(198,40,40,.04);
}
.pgto-tab i { font-size: 14px; color: var(--fg-muted); transition: color .15s; }
.pgto-tab.selected i { color: var(--primary); }
.pgto-tab span { font-size: 11px; font-weight: 500; color: var(--fg-muted); transition: color .15s; }
.pgto-tab.selected span { color: var(--primary); }
.pgto-tab input { display: none; }

.pgto-simple-hint {
  margin-top: var(--s-2);
  font-size: 11px;
  color: var(--fg-muted);
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-1) var(--s-3);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  font-variant-numeric: tabular-nums;
}
.pgto-simple-hint strong { color: var(--fg); font-weight: 500; margin-left: auto; }

/* Split */
.pgto-split-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--s-2);
  font-size: 11px;
  color: var(--fg-muted);
}
.pgto-split-header strong { color: var(--fg); font-weight: 500; }
.pgto-split-header .btn-voltar-simples {
  background: transparent;
  border: none;
  color: var(--info);
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: var(--s-1);
  padding: 1px 6px;
  border-radius: 4px;
  transition: background-color .15s;
}
.pgto-split-header .btn-voltar-simples:hover { background: rgba(37,99,235,.06); }

.pgto-linha {
  display: grid;
  grid-template-columns: 1fr 100px 24px;
  gap: var(--s-2);
  align-items: center;
  margin-bottom: var(--s-2);
}
.pgto-linha:last-child { margin-bottom: 0; }

.pgto-metodo {
  padding: var(--s-1) var(--s-2);
  border: 1px solid var(--border);
  border-radius: 4px;
  font: inherit;
  font-size: 12px;
  background: var(--surface);
  color: var(--fg);
  cursor: pointer;
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 10 10'%3e%3cpath fill='%23666' d='M5 7L1 3h8z'/%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 8px center;
  padding-right: 24px;
  transition: border-color .15s;
}
.pgto-metodo:focus { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--fg); }

.pgto-valor-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: var(--surface);
  transition: border-color .15s;
}
.pgto-valor-wrapper:focus-within { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--fg); }
.pgto-valor {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: var(--s-1) 24px var(--s-1) var(--s-2);
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  color: var(--fg);
  text-align: right;
  min-width: 0;
  font-variant-numeric: tabular-nums;
  -moz-appearance: textfield;
}
.pgto-valor::-webkit-outer-spin-button,
.pgto-valor::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.pgto-moeda {
  position: absolute;
  right: var(--s-2);
  font-size: 10px;
  font-weight: 500;
  color: var(--fg-muted);
  pointer-events: none;
}

.pgto-remove {
  width: 24px; height: 24px;
  border-radius: 4px;
  background: transparent;
  border: none;
  color: var(--fg-muted);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 10px;
  cursor: pointer;
  transition: background-color .15s, color .15s;
}
.pgto-remove:hover:not(:disabled) { background: rgba(198,40,40,.06); color: var(--primary); }
.pgto-remove:disabled { opacity: .3; cursor: not-allowed; }

/* Status do pagamento */
.pgto-status {
  margin-top: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: var(--s-2);
  background: var(--surface);
  border: 1px solid var(--border);
  border-left-width: 3px;
  font-variant-numeric: tabular-nums;
}
.pgto-status strong { margin-left: auto; font-size: 13px; font-weight: 600; }
.pgto-status.ok { color: var(--success); border-left-color: var(--success); }
.pgto-status.falta { color: var(--warning); border-left-color: var(--warning); }
.pgto-status.sobra { color: var(--info); border-left-color: var(--info); }

/* Desconto */
.prefactura-desconto {
  padding: 0 var(--s-4) var(--s-3);
  background: var(--bg);
  flex-shrink: 0;
}
.prefactura-desconto .label {
  font-size: 11px;
  color: var(--fg-muted);
  font-weight: 500;
  margin-bottom: var(--s-1);
}
.desconto-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 4px;
  transition: border-color .15s;
}
.desconto-wrapper:focus-within { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--fg); }
.desconto-wrapper i {
  position: absolute;
  left: var(--s-3);
  color: var(--fg-muted);
  font-size: 11px;
  pointer-events: none;
}
.desconto-wrapper input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: var(--s-2) var(--s-2) var(--s-2) 30px;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  color: var(--fg);
  font-variant-numeric: tabular-nums;
  -moz-appearance: textfield;
}
.desconto-wrapper input::-webkit-outer-spin-button,
.desconto-wrapper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

.prefactura-acoes {
  padding: var(--s-3) var(--s-4) var(--s-4);
  background: var(--bg);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}

/* ---------- Modais ---------- */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.5);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: var(--s-4);
  overflow-y: auto;
}
.modal-backdrop.open { display: flex; animation: fadeIn .15s ease; }
.modal {
  background: var(--surface);
  border-radius: 4px;
  width: 100%;
  max-width: 480px;
  box-shadow: 0 8px 24px rgba(0,0,0,.15);
  overflow: hidden;
  margin: auto;
}
.modal.modal-lg { max-width: 780px; }
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-4);
  border-bottom: 1px solid var(--border);
}
.modal-header h3 { font-size: 14px; font-weight: 600; }
.modal-close {
  background: none;
  border: none;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  color: var(--fg-muted);
  padding: 0 var(--s-1);
  transition: color .15s;
}
.modal-close:hover { color: var(--fg); }
.modal-body { padding: var(--s-4); max-height: 75vh; overflow-y: auto; }
.modal-body.documento-body { padding: 0; background: var(--bg); }
.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--s-2);
  padding: var(--s-3) var(--s-4);
  border-top: 1px solid var(--border);
  background: var(--bg);
}

/* ---------- Forms ---------- */
.form-group { margin-bottom: var(--s-3); }
.form-group:last-child { margin-bottom: 0; }
.form-label {
  display: block;
  margin-bottom: var(--s-1);
  color: var(--fg);
  font-weight: 500;
  font-size: 12px;
}
.form-label .required { color: var(--primary); margin-left: 2px; }
.form-label .optional { color: var(--fg-muted); font-weight: 400; font-size: 11px; margin-left: var(--s-1); }
.form-control {
  width: 100%;
  padding: var(--s-2) var(--s-3);
  border: 1px solid var(--border);
  border-radius: 4px;
  font: inherit;
  font-size: 13px;
  background: var(--surface);
  color: var(--fg);
  caret-color: var(--primary);
  transition: border-color .15s;
}
.form-control::placeholder { color: #999; }
.form-control:focus { outline: 2px solid var(--focus); outline-offset: 1px; border-color: var(--fg); }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }

/* Form hint */
.form-hint {
  font-size: 11px;
  color: var(--fg-muted);
  margin-top: var(--s-1);
}
.form-hint.is-warning {
  color: var(--warning);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: var(--s-1);
}
.form-hint i { font-size: 11px; flex-shrink: 0; }

/* Input de moeda */
.input-money {
  position: relative;
  display: flex;
  align-items: center;
}
.input-money input {
  padding-right: 32px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.input-money::after {
  content: 'Kz';
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 10px;
  font-weight: 500;
  color: var(--fg-muted);
  pointer-events: none;
}

/* Preview inline no modal de novo produto */
.np-preview {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-3);
  padding: var(--s-3);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  margin-top: var(--s-2);
}
.np-preview-row { display: flex; flex-direction: column; gap: 1px; }
.np-preview-row .lbl {
  font-size: 10px;
  color: var(--fg-muted);
  text-transform: uppercase;
  letter-spacing: .5px;
  font-weight: 500;
}
.np-preview-row .val {
  font-size: 13px;
  font-weight: 600;
  color: var(--fg);
  font-variant-numeric: tabular-nums;
}

.checkbox-inline {
  display: flex;
  align-items: flex-start;
  gap: var(--s-2);
  font-size: 13px;
  color: var(--fg);
  cursor: pointer;
  padding: var(--s-2) 0;
  user-select: none;
}
.checkbox-inline input { width: 15px; height: 15px; accent-color: var(--primary); cursor: pointer; margin-top: 1px; }
.checkbox-inline .cb-info { display: flex; flex-direction: column; gap: 1px; }
.checkbox-inline .cb-info .cb-title { font-weight: 500; font-size: 13px; }
.checkbox-inline .cb-info .cb-desc { font-size: 11px; color: var(--fg-muted); }

/* ---------- Cliente resultado ---------- */
.cliente-resultado {
  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: var(--s-3);
  align-items: center;
  padding: var(--s-2) var(--s-3);
  border-radius: 4px;
  cursor: pointer;
  border: 1px solid transparent;
  transition: background-color .12s;
}
.cliente-resultado:hover { background: var(--bg); }
.cliente-resultado:active { background: var(--border); }
.cliente-resultado .avatar {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: var(--info);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600;
  font-size: 12px;
}
.cliente-resultado .info .nome { font-size: 13px; font-weight: 500; color: var(--fg); margin-bottom: 2px; }
.cliente-resultado .info .meta {
  font-size: 11px;
  color: var(--fg-muted);
  display: flex;
  gap: var(--s-3);
  font-variant-numeric: tabular-nums;
}
.cliente-resultado .info .meta i { font-size: 9px; margin-right: var(--s-1); }
.cliente-resultado > i.fa-chevron-right { color: var(--fg-muted); font-size: 11px; }

/* ---------- Factura documento ---------- */
.factura-doc {
  background: var(--surface);
  padding: var(--s-6) var(--s-5);
  max-width: 720px;
  margin: var(--s-4) auto;
  border-radius: 4px;
  font-size: 12px;
  color: var(--fg);
}
.fp-header {
  display: flex;
  justify-content: space-between;
  gap: var(--s-5);
  padding-bottom: var(--s-3);
  border-bottom: 2px solid var(--primary);
  margin-bottom: var(--s-4);
  flex-wrap: wrap;
}
.fp-brand { flex: 1; min-width: 200px; }
.fp-brand-logo {
  font-size: 15px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: .5px;
  display: flex;
  align-items: center;
  gap: var(--s-2);
  margin-bottom: var(--s-2);
}
.fp-brand-logo i { font-size: 14px; }
.fp-brand p { font-size: 11px; color: var(--fg-muted); margin: 1px 0; line-height: 1.5; }
.fp-doc { text-align: right; min-width: 200px; }
.fp-doc h3 {
  font-size: 13px;
  letter-spacing: 2.5px;
  font-weight: 700;
  color: var(--fg);
  margin-bottom: var(--s-2);
}
.fp-doc p { font-size: 11px; color: var(--fg-muted); margin: 2px 0; font-variant-numeric: tabular-nums; }
.fp-doc p strong { color: var(--fg); font-weight: 500; }

.fp-cliente {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: var(--s-3) var(--s-4);
  margin-bottom: var(--s-4);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--s-4);
}
.fp-cliente .bloco h4 {
  font-size: 10px;
  color: var(--fg-muted);
  font-weight: 500;
  letter-spacing: .5px;
  text-transform: uppercase;
  margin-bottom: var(--s-1);
}
.fp-cliente .bloco p { margin: 1px 0; font-size: 11px; color: var(--fg); font-variant-numeric: tabular-nums; }
.fp-cliente .bloco p strong { color: var(--fg); font-weight: 500; }
.fp-cliente .bloco p span { color: var(--fg-muted); }

.fp-table { width: 100%; border-collapse: collapse; font-size: 11px; }
.fp-table th {
  background: var(--fg);
  color: #fff;
  text-align: left;
  padding: var(--s-2) var(--s-3);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .3px;
  text-transform: uppercase;
  -webkit-print-color-adjust: exact;
  print-color-adjust: exact;
}
.fp-table th.text-end { text-align: right; }
.fp-table th.text-center { text-align: center; }
.fp-table td { padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--border); font-size: 11px; vertical-align: middle; }
.fp-table td.text-end { text-align: right; font-variant-numeric: tabular-nums; }
.fp-table td.text-center { text-align: center; font-variant-numeric: tabular-nums; }
.fp-table tbody tr:nth-child(even) { background: var(--bg); }
.fp-table tbody tr:last-child td { border-bottom: 1px solid var(--border); }

.fp-totais { padding: var(--s-3) 0 0; display: flex; justify-content: flex-end; }
.fp-totais table { width: 260px; border-collapse: collapse; }
.fp-totais td { padding: var(--s-1) var(--s-2); font-size: 11px; color: var(--fg-muted); font-variant-numeric: tabular-nums; }
.fp-totais td:last-child { text-align: right; font-weight: 600; color: var(--fg); }
.fp-totais tr.grand-total td {
  border-top: 1px solid var(--fg);
  font-size: 13px;
  font-weight: 700;
  color: var(--primary);
  padding-top: var(--s-2);
}

.fp-pgto-bloco { margin-top: var(--s-4); padding-top: var(--s-3); border-top: 1px solid var(--border); }
.fp-pgto-bloco h4 {
  font-size: 10px;
  color: var(--fg-muted);
  font-weight: 500;
  letter-spacing: .5px;
  text-transform: uppercase;
  margin-bottom: var(--s-2);
}
.fp-pgto-linha {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--s-1) 0;
  font-size: 11px;
  border-bottom: 1px solid var(--border);
}
.fp-pgto-linha:last-child { border-bottom: none; }
.fp-pgto-linha .metodo { font-weight: 500; }
.fp-pgto-linha .valor { font-weight: 600; font-variant-numeric: tabular-nums; }
.fp-pgto-linha.troco .valor { color: var(--info); }
.fp-pgto-linha.total-pago {
  border-top: 1px solid var(--fg);
  border-bottom: none;
  padding-top: var(--s-2);
  margin-top: var(--s-1);
  font-weight: 600;
}
.fp-pgto-linha.total-pago .valor { color: var(--primary); font-size: 12px; }

.fp-aviso {
  margin-top: var(--s-3);
  padding: var(--s-2) var(--s-3);
  border-left: 3px solid var(--info);
  background: var(--bg);
  font-size: 10px;
  color: var(--fg-muted);
}
.fp-aviso strong { color: var(--fg); font-weight: 500; }

.fp-assinatura { margin-top: var(--s-5); text-align: center; }
.fp-assinatura .linha { width: 200px; border-top: 1px solid var(--fg-muted); margin: 0 auto var(--s-1); }
.fp-assinatura .lbl { font-size: 10px; color: var(--fg-muted); }

.fp-footer {
  margin-top: var(--s-4);
  padding-top: var(--s-2);
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  gap: var(--s-4);
  font-size: 10px;
  color: var(--fg-muted);
  flex-wrap: wrap;
}

/* ---------- Toast ---------- */
#toast-container {
  position: fixed;
  top: var(--s-4);
  right: var(--s-4);
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: var(--s-2);
}
.toast {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  padding: var(--s-2) var(--s-3);
  border-radius: 4px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-left-width: 3px;
  color: var(--fg);
  font-size: 13px;
  font-weight: 500;
  box-shadow: 0 4px 12px rgba(0,0,0,.08);
  animation: fadeIn .15s ease;
  max-width: 360px;
}
.toast i { font-size: 12px; flex-shrink: 0; }
.toast.success { border-left-color: var(--success); }
.toast.success i { color: var(--success); }
.toast.error { border-left-color: var(--danger); }
.toast.error i { color: var(--danger); }
.toast.info { border-left-color: var(--info); }
.toast.info i { color: var(--info); }
.toast.warning { border-left-color: var(--warning); }
.toast.warning i { color: var(--warning); }

/* ---------- Responsivo ---------- */
@media (max-width: 1100px) {
  .main-grid { grid-template-columns: 1fr; grid-template-rows: 1fr auto; }
  .col-prefactura { max-height: 60vh; }
  .factura-doc { padding: var(--s-4) var(--s-3); margin: var(--s-3); }
  .fp-header { flex-direction: column; gap: var(--s-3); }
  .fp-doc { text-align: left; min-width: 0; }
  .fp-cliente { grid-template-columns: 1fr; gap: var(--s-3); }
  .fp-totais table { width: 100%; }
}

@media (max-width: 900px) {
  .sidebar { width: 60px; }
  .sidebar .logo span, .sidebar .nav-menu a span, .sidebar .user-details { display: none; }
  .sidebar .logo { justify-content: center; padding: 0 0 var(--s-5); gap: 0; }
  .sidebar .nav-menu a { justify-content: center; padding: var(--s-3); }
  .sidebar .user-info { justify-content: center; padding: var(--s-3) 0 0; }
  .main-content { margin-left: 60px; padding: var(--s-3); }
}

@media (max-width: 576px) {
  .main-content { padding: var(--s-2); gap: var(--s-2); }
  .resultado-item { grid-template-columns: 36px 1fr auto; gap: var(--s-2); padding: var(--s-2); }
  .resultado-preco { display: none; }
  .cliente-pill .text .nome { max-width: 100px; }
  .pgto-linha { grid-template-columns: 1fr 90px 24px; }
  .np-preview { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ---------- Impressão ---------- */
@media print {
  .sidebar, .topbar, .main-grid, .modal-header, .modal-actions { display: none !important; }
  .modal-backdrop { position: static; background: none; display: block; padding: 0; }
  .modal { box-shadow: none; max-width: 100%; }
  .modal-body.documento-body { padding: 0; background: #fff; }
  .factura-doc { box-shadow: none; margin: 0; padding: 0; max-width: 100%; }
  .fp-table th, .fp-pgto-linha.total-pago .valor { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
</head>
<body>

<aside class="sidebar">
    <div class="logo"><i class="fas fa-globe-americas"></i><span>BOM MUNDO</span></div>
    <ul class="nav-menu">
        <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i><span>Painel</span></a></li>
        <li><a href="/caixa"><i class="fas fa-cash-register"></i><span>Caixas</span></a></li>
        <li><a href="/vendas" class="active"><i class="fas fa-shopping-cart"></i><span>Vendas</span></a></li>
        <li><a href="/produtos"><i class="fas fa-boxes"></i><span>Estoque</span></a></li>
        <li><a href="#"><i class="fas fa-users"></i><span>Clientes</span></a></li>
        <li><a href="#"><i class="fas fa-chart-bar"></i><span>Relatórios</span></a></li>
        <li><a href="#"><i class="fas fa-cog"></i><span>Config.</span></a></li>
    </ul>
    <div class="user-info">
        <div class="user-avatar"><%= operadorNome.substring(0,2).toUpperCase() %></div>
        <div class="user-details">
            <div class="user-name"><%= operadorNome %></div>
            <div class="user-role">Operador de Caixa</div>
        </div>
    </div>
</aside>

<main class="main-content">

    <div class="topbar">
        <div class="topbar-left">
            <a href="/vendas" class="topbar-back" title="Voltar"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h1>Nova Venda</h1>
                <div class="page-subtitle">
                    <span><kbd>F2</kbd> Finalizar</span>
                    <span><kbd>/</kbd> Buscar</span>
                    <span><kbd>ESC</kbd> Limpar</span>
                    <% if (caixaId) { %>
                    <span class="caixa-open">Caixa #<%= caixaId %></span>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="topbar-right">
            <div class="cliente-pill" id="clientePill" onclick="abrirModalSelecionarCliente()">
                <div class="avatar" id="clienteAvatarPill"><i class="fas fa-user"></i></div>
                <div class="text">
                    <span class="lbl">Cliente</span>
                    <span class="nome" id="clienteNomePill">Consumidor Final</span>
                </div>
                <i class="fas fa-chevron-down caret"></i>
            </div>
        </div>
    </div>

    <% if (!caixa) { %>
        <div class="warning-banner">
            <i class="fas fa-exclamation-triangle"></i>
            <div><strong>Nenhum caixa aberto.</strong> <a href="/caixa/abrir">Abrir caixa</a> antes de registar vendas.</div>
        </div>
    <% } else { %>

    <form id="vendaForm" method="POST" action="/vendas/nova" autocomplete="off">
        <input type="hidden" id="produtosData" name="produtos">
        <input type="hidden" id="quantidadesData" name="quantidades">
        <input type="hidden" id="pagamentosData" name="pagamentos">
        <input type="hidden" id="formaPagamentoPrincipal" name="forma_pagamento">
        <input type="hidden" name="cliente_id" id="clienteIdInput" value="">

        <div class="main-grid">

            <!-- PESQUISA -->
            <div class="col-pesquisa">
                <div class="search-card">
                    <div class="search-wrapper" id="searchWrapper">
                        <i class="fas fa-barcode search-icon"></i>
                        <input type="text" id="produtoSearch"
                               placeholder="Bipe o código ou pesquise pelo nome do produto"
                               autocomplete="off" autofocus>
                        <span class="search-hint">ESC</span>
                        <span class="search-status">
                            <span class="spinner"></span> A buscar…
                        </span>
                    </div>
                    <div class="filtros-rapidos" id="filtrosRapidos">
                        <button type="button" class="chip active" data-filtro="todos">Todos</button>
                        <button type="button" class="chip" data-filtro="stock">Em stock</button>
                        <button type="button" class="chip" data-filtro="low">Stock baixo</button>
                        <button type="button" class="chip-add" onclick="abrirModalNovoProduto()">
                            <i class="fas fa-plus"></i> Novo produto
                        </button>
                    </div>
                </div>

                <div class="resultados-card">
                    <div class="resultados-head">
                        <div class="info"><strong id="resultadosCount">0</strong> produtos</div>
                        <span class="modo" id="resultadosModo"></span>
                    </div>
                    <div class="resultados-list" id="resultadosList">
                        <div class="resultados-empty">
                            <i class="fas fa-keyboard"></i>
                            <span>Sem produtos recentes.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PRÉ-FACTURA LIVE -->
            <div class="col-prefactura">
                <div class="prefactura">
                    <div class="prefactura-header">
                        <div class="title">Pré-factura</div>
                        <div class="numero" id="pfNumero">FT — / —</div>
                        <div class="meta">
                            <span id="pfData">—</span>
                            <span class="cliente-inline" id="pfClienteInline">
                                <i class="fas fa-user"></i> Consumidor Final
                            </span>
                        </div>
                    </div>

                    <div class="prefactura-itens" id="pfItens">
                        <div class="prefactura-empty">
                            <i class="fas fa-shopping-basket"></i>
                            <span>Sem itens.</span>
                        </div>
                    </div>

                    <div class="prefactura-totais">
                        <div class="linha">
                            <span>Subtotal</span>
                            <span class="val" id="pfSubtotal">0,00 Kz</span>
                        </div>
                        <div class="linha" id="pfDescontoLinha" style="display:none;">
                            <span>Desconto</span>
                            <span class="val red" id="pfDesconto">- 0,00 Kz</span>
                        </div>
                        <div class="linha grande">
                            <span>A PAGAR</span>
                            <span class="val" id="pfTotal">0,00 Kz</span>
                        </div>
                    </div>

                    <div class="prefactura-pgto">
                        <div class="label">
                            <span>Forma de pagamento</span>
                            <button type="button" class="btn-add-pgto" id="btnAddPgto" onclick="ativarSplitMode()">
                                <i class="fas fa-plus"></i> Dividir
                            </button>
                        </div>

                        <div id="pgtoSimple">
                            <div class="pgto-tabs">
                                <label class="pgto-tab selected" data-metodo="Dinheiro">
                                    <input type="radio" name="forma_pagamento_simple" value="Dinheiro" checked>
                                    <i class="fas fa-money-bill-wave"></i>
                                    <span>Dinheiro</span>
                                </label>
                                <label class="pgto-tab" data-metodo="cartao_debito">
                                    <input type="radio" name="forma_pagamento_simple" value="cartao_debito">
                                    <i class="fas fa-credit-card"></i>
                                    <span>TPA</span>
                                </label>
                                <label class="pgto-tab" data-metodo="transferencia">
                                    <input type="radio" name="forma_pagamento_simple" value="transferencia">
                                    <i class="fas fa-university"></i>
                                    <span>Transf.</span>
                                </label>
                            </div>
                            <div class="pgto-simple-hint">
                                <span>Valor a receber</span>
                                <strong id="pgtoSimpleValor">0,00 Kz</strong>
                            </div>
                        </div>

                        <div id="pgtoSplit" style="display:none;">
                            <div class="pgto-split-header">
                                <span>Dividido em <strong id="pgtoSplitCount">1</strong> método(s)</span>
                                <button type="button" class="btn-voltar-simples" onclick="desativarSplitMode()">
                                    <i class="fas fa-undo"></i> Voltar
                                </button>
                            </div>
                            <div id="pagamentosList"></div>
                        </div>

                        <div class="pgto-status ok" id="pgtoStatus" style="display:none;"></div>
                    </div>

                    <div class="prefactura-desconto">
                        <div class="label">Desconto</div>
                        <div class="desconto-wrapper">
                            <i class="fas fa-percent"></i>
                            <input type="number" id="desconto" name="desconto" value="0" min="0" step="0.01" placeholder="0,00" inputmode="decimal">
                        </div>
                    </div>

                    <div class="prefactura-acoes">
                        <button type="button" class="btn btn-primary btn-block" id="btnFinalizar" style="padding: var(--s-3);">
                            <i class="fas fa-check"></i> Finalizar venda
                        </button>
                        <button type="button" class="btn btn-ghost btn-block btn-sm" id="btnLimpar" style="display:none;">
                            <i class="fas fa-trash-alt"></i> Limpar venda
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <% } %>
</main>

<!-- MODAL: NOVO PRODUTO (integrado na venda) -->
<div class="modal-backdrop" id="novoProdutoModal" onclick="if(event.target===this) tentarFecharNovoProduto()">
    <div class="modal" style="max-width: 540px;">
        <div class="modal-header">
            <h3>Registar novo produto</h3>
            <button type="button" class="modal-close" onclick="tentarFecharNovoProduto()" aria-label="Fechar">&times;</button>
        </div>
        <form id="novoProdutoForm">
            <div class="modal-body">

                <div class="form-group">
                    <label class="form-label" for="npNome">Nome <span class="required">*</span></label>
                    <input type="text" id="npNome" class="form-control" required maxlength="200"
                           autocomplete="off" placeholder="Nome do produto"
                           oninput="atualizarPreviewNovoProduto()">
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="npCodigo">Código de barras</label>
                        <input type="text" id="npCodigo" class="form-control" maxlength="50"
                               inputmode="numeric" placeholder="0000000000000">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="npCategoria">Categoria</label>
                        <select id="npCategoria" class="form-control">
                            <option value="">Sem categoria</option>
                            <option value="Bebidas">Bebidas</option>
                            <option value="Alimentos">Alimentos</option>
                            <option value="Limpeza">Limpeza</option>
                            <option value="Higiene">Higiene</option>
                            <option value="Papelaria">Papelaria</option>
                            <option value="Outros">Outros</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="npDescricao">
                        Descrição <span class="optional">(opcional)</span>
                    </label>
                    <textarea id="npDescricao" class="form-control" rows="2"
                              maxlength="500" placeholder="Notas internas"></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="npCusto">Preço de custo</label>
                        <div class="input-money">
                            <input type="number" id="npCusto" class="form-control"
                                   step="0.01" min="0" placeholder="0,00" inputmode="decimal"
                                   oninput="atualizarPreviewNovoProduto()">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="npPreco">
                            Preço de venda <span class="required">*</span>
                        </label>
                        <div class="input-money">
                            <input type="number" id="npPreco" class="form-control"
                                   step="0.01" min="0.01" placeholder="0,00" required inputmode="decimal"
                                   oninput="atualizarPreviewNovoProduto()">
                        </div>
                    </div>
                </div>
                <div class="form-hint is-warning" id="npAvisoPrecos" role="status" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i>
                    O preço de venda está abaixo do custo.
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="npEstoque">Quantidade inicial</label>
                        <input type="number" id="npEstoque" class="form-control"
                               min="0" value="0" step="1" placeholder="0" inputmode="numeric"
                               oninput="atualizarPreviewNovoProduto()">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="npMinimo">Stock mínimo</label>
                        <input type="number" id="npMinimo" class="form-control"
                               min="0" value="5" step="1" placeholder="5" inputmode="numeric">
                    </div>
                </div>

                <div class="np-preview" id="npPreview" style="display: none;">
                    <div class="np-preview-row">
                        <span class="lbl">Margem</span>
                        <span class="val" id="npPreviewMargem">0,00 Kz</span>
                    </div>
                    <div class="np-preview-row">
                        <span class="lbl">Valor do inventário</span>
                        <span class="val" id="npPreviewInventario">0,00 Kz</span>
                    </div>
                </div>

                <div class="form-group" style="margin-top: var(--s-3); margin-bottom: 0;">
                    <label class="checkbox-inline">
                        <input type="checkbox" id="npAdicionarAoCarrinho" checked>
                        <span class="cb-info">
                            <span class="cb-title">Adicionar à venda</span>
                            <span class="cb-desc">Coloca o produto no carrinho ao guardar</span>
                        </span>
                    </label>
                </div>

            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline" onclick="tentarFecharNovoProduto()">Cancelar</button>
                <button type="submit" class="btn btn-primary" id="btnGuardarProduto" aria-busy="false">
                    <i class="fas fa-save"></i> Guardar produto
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: CLIENTE -->
<div class="modal-backdrop" id="clienteModal" onclick="if(event.target===this) fecharModal('clienteModal')">
    <div class="modal">
        <div class="modal-header">
            <h3>Cliente da venda</h3>
            <button type="button" class="modal-close" onclick="fecharModal('clienteModal')" aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body">
            <div id="clientePesquisaPanel">
                <div class="search-wrapper" style="margin-bottom: var(--s-3);">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="clienteSearch" placeholder="Pesquisar por nome ou NIF">
                </div>
                <div id="clientesList" style="max-height: 340px; overflow-y: auto;"></div>
            </div>
            <div id="clienteNovoPanel" style="display:none;">
                <button type="button" class="btn btn-ghost btn-sm" onclick="mostrarPainelClientes('pesquisa')" style="margin-bottom: var(--s-3);">
                    <i class="fas fa-arrow-left"></i> Voltar
                </button>
                <form id="novoClienteForm">
                    <div class="form-group">
                        <label class="form-label" for="ncNome">Nome completo <span class="required">*</span></label>
                        <input type="text" id="ncNome" class="form-control" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" for="ncNif">NIF</label>
                            <input type="text" id="ncNif" class="form-control" inputmode="numeric">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="ncTelefone">Telefone</label>
                            <input type="tel" id="ncTelefone" class="form-control" placeholder="+244 900 000 000">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="ncEmail">Email</label>
                        <input type="email" id="ncEmail" class="form-control" placeholder="cliente@email.com">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="ncEndereco">Endereço</label>
                        <input type="text" id="ncEndereco" class="form-control" placeholder="Rua, número, bairro">
                    </div>
                    <div style="display: flex; gap: var(--s-2); justify-content: flex-end; margin-top: var(--s-3);">
                        <button type="button" class="btn btn-outline" onclick="mostrarPainelClientes('pesquisa')">Cancelar</button>
                        <button type="submit" class="btn btn-primary" id="btnGuardarCliente">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="modal-actions" id="clienteModalActions">
            <button type="button" class="btn btn-outline" onclick="selecionarConsumidorFinal()">
                Consumidor final
            </button>
            <button type="button" class="btn btn-primary" id="btnAcaoCliente" onclick="mostrarPainelClientes('novo')">
                <i class="fas fa-plus"></i> Novo cliente
            </button>
        </div>
    </div>
</div>

<!-- MODAL: CONFIRMAÇÃO / FACTURA -->
<div class="modal-backdrop" id="confirmarModal" onclick="if(event.target===this) fecharModal('confirmarModal')">
    <div class="modal modal-lg">
        <div class="modal-header">
            <h3>Confirmação da venda</h3>
            <button type="button" class="modal-close" onclick="fecharModal('confirmarModal')" aria-label="Fechar">&times;</button>
        </div>
        <div class="modal-body documento-body">
            <div class="factura-doc" id="facturaDoc"></div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-outline" onclick="fecharModal('confirmarModal')">
                <i class="fas fa-arrow-left"></i> Voltar
            </button>
            <button type="button" class="btn btn-primary" id="btnConfirmarReal">
                <i class="fas fa-check"></i> Confirmar e gravar
            </button>
        </div>
    </div>
</div>

<div id="toast-container" aria-live="polite"></div>

<script>
window.__CLIENTES__ = <%- JSON.stringify(listaClientes) %>;
window.__OPERADOR__ = <%- JSON.stringify(operadorNome) %>;
window.__CAIXA_ID__ = <%- JSON.stringify(caixaId) %>;
window.__PRODUTOS_INICIAIS__ = <%- JSON.stringify(
  (typeof produtos !== 'undefined' && Array.isArray(produtos)) ?
    produtos.slice(0, 20).map(function(p) {
      return {
        id: p.id,
        nome: p.nome,
        codigo_barras: p.codigo_barras || '',
        preco_venda: Number(p.preco_venda || 0),
        quantidade_estoque: Number(p.quantidade_estoque || 0)
      };
    }) : []
) %>;

function toast(msg, tipo = 'info', dur = 3000) {
    const c = document.getElementById('toast-container');
    const icons = { success: 'fa-check-circle', error: 'fa-exclamation-circle', info: 'fa-info-circle', warning: 'fa-exclamation-triangle' };
    const t = document.createElement('div');
    t.className = 'toast ' + tipo;
    t.innerHTML = '<i class="fas ' + (icons[tipo] || icons.info) + '"></i><span></span>';
    t.querySelector('span').textContent = msg;
    c.appendChild(t);
    setTimeout(() => {
        t.style.transition = 'opacity .2s ease';
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 200);
    }, dur);
}
const fmtKz = v => Number(v || 0).toLocaleString('pt-AO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' Kz';
const escapeHtml = t => { const d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; };
function abrirModal(id) { document.getElementById(id).classList.add('open'); }
function fecharModal(id) { document.getElementById(id).classList.remove('open'); }
function debounce(fn, ms) { let timer; return function (...args) { clearTimeout(timer); timer = setTimeout(() => fn.apply(this, args), ms); }; }

const METODOS_LABEL = {
    'Dinheiro': { nome: 'Dinheiro', payClass: 'pay-dinheiro' },
    'cartao_debito': { nome: 'TPA (Multicaixa)', payClass: 'pay-cartao_debito' },
    'transferencia': { nome: 'Transferência', payClass: 'pay-transferencia' }
};

function renderPayMethod(chave) {
    const meta = METODOS_LABEL[chave] || { nome: chave, payClass: '' };
    return `<span class="pay-method ${meta.payClass}">${escapeHtml(meta.nome)}</span>`;
}

let carrinho = [];
let clienteSelecionado = null;
let filtroAtivo = 'todos';
let filtroTermo = '';
const CLIENTES = Array.isArray(window.__CLIENTES__) ? window.__CLIENTES__ : [];
const OPERADOR = window.__OPERADOR__ || 'Operador';
const CAIXA_ID = window.__CAIXA_ID__ || '';

let modoPagamento = 'simples';
let metodoSimples = 'Dinheiro';
let pagamentos = [];
let nextPagamentoId = 1;

const cacheProdutos = new Map();
const CACHE_MAX = 50;
function cacheAdd(chave, valor) {
    if (cacheProdutos.has(chave)) cacheProdutos.delete(chave);
    cacheProdutos.set(chave, valor);
    if (cacheProdutos.size > CACHE_MAX) { const p = cacheProdutos.keys().next().value; cacheProdutos.delete(p); }
}

function getSubtotal() { return carrinho.reduce((s, i) => s + i.subtotal, 0); }
function getDesconto() { return parseFloat(document.getElementById('desconto')?.value) || 0; }
function getTotal() { return Math.max(0, getSubtotal() - getDesconto()); }
function getDistribuido() {
    if (modoPagamento === 'simples') return getTotal();
    return pagamentos.reduce((s, p) => s + (Number(p.valor) || 0), 0);
}
function gerarNumeroFactura() {
    const seq = String(Math.floor(Math.random() * 99999)).padStart(5, '0');
    return 'FT ' + new Date().getFullYear() + '/' + seq;
}

/* ---------- RENDER PRÉ-FACTURA ---------- */
function renderPreFactura() {
    const agora = new Date();
    document.getElementById('pfData').textContent = agora.toLocaleDateString('pt-AO') + ' · ' + agora.toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit' });
    if (!document.getElementById('pfNumero').textContent.match(/\d{4}\/\d+/)) {
        document.getElementById('pfNumero').textContent = gerarNumeroFactura();
    }

    const clienteInline = document.getElementById('pfClienteInline');
    clienteInline.innerHTML = clienteSelecionado
        ? '<i class="fas fa-user-check"></i> ' + escapeHtml(clienteSelecionado.nome)
        : '<i class="fas fa-user"></i> Consumidor Final';

    const container = document.getElementById('pfItens');
    if (carrinho.length === 0) {
        container.innerHTML = `<div class="prefactura-empty"><i class="fas fa-shopping-basket"></i><span>Sem itens.</span></div>`;
    } else {
        container.innerHTML = carrinho.map(item => `
            <div class="prefactura-item" data-id="${item.id}">
                <div class="qty-mini">
                    <button type="button" onclick="alterarQtdCarrinho('${item.id}', -1)" title="Diminuir"><i class="fas fa-minus"></i></button>
                    <span class="qty-value">${item.quantidade}</span>
                    <button type="button" onclick="alterarQtdCarrinho('${item.id}', 1)" title="Aumentar" ${item.quantidade >= item.estoque ? 'disabled' : ''}><i class="fas fa-plus"></i></button>
                </div>
                <div class="info">
                    <div class="nome">${escapeHtml(item.nome)}</div>
                    <div class="unit">${fmtKz(item.preco)} / un. · stock ${item.estoque}</div>
                </div>
                <div class="valor">${fmtKz(item.subtotal)}</div>
                <button type="button" class="remove" onclick="removerItem('${item.id}')" title="Remover"><i class="fas fa-times"></i></button>
            </div>
        `).join('');
    }

    const subtotal = getSubtotal();
    const desconto = getDesconto();
    const total = getTotal();
    document.getElementById('pfSubtotal').textContent = fmtKz(subtotal);
    document.getElementById('pfDescontoLinha').style.display = desconto > 0 ? 'flex' : 'none';
    document.getElementById('pfDesconto').textContent = '- ' + fmtKz(desconto);
    document.getElementById('pfTotal').textContent = fmtKz(total);
    document.getElementById('btnLimpar').style.display = carrinho.length > 0 ? '' : 'none';

    if (modoPagamento === 'simples') {
        document.getElementById('pgtoSimpleValor').textContent = fmtKz(total);
        document.getElementById('pgtoStatus').style.display = 'none';
    } else {
        if (pagamentos.length === 1) pagamentos[0].valor = total;
        renderPagamentos();
    }
}

/* ---------- MODO SIMPLES ---------- */
document.querySelectorAll('.pgto-tab').forEach(tab => {
    tab.addEventListener('click', function() {
        document.querySelectorAll('.pgto-tab').forEach(t => t.classList.remove('selected'));
        this.classList.add('selected');
        const radio = this.querySelector('input[type="radio"]');
        radio.checked = true;
        metodoSimples = radio.value;
    });
});

/* ---------- MODO SPLIT ---------- */
function ativarSplitMode() {
    modoPagamento = 'split';
    const total = getTotal();
    if (pagamentos.length === 0) {
        pagamentos = [{ id: nextPagamentoId++, metodo: metodoSimples, valor: total }];
    } else {
        pagamentos[0].valor = total;
    }
    document.getElementById('pgtoSimple').style.display = 'none';
    document.getElementById('pgtoSplit').style.display = '';
    document.getElementById('pgtoStatus').style.display = 'flex';
    document.getElementById('btnAddPgto').style.display = '';
    renderPagamentos();
}

function desativarSplitMode() {
    if (pagamentos.length > 1) {
        if (!confirm('Tem métodos adicionais. Voltar a método único irá descartá-los. Continuar?')) return;
    }
    modoPagamento = 'simples';
    if (pagamentos.length > 0) {
        metodoSimples = pagamentos[0].metodo;
        document.querySelectorAll('.pgto-tab').forEach(t => {
            const radio = t.querySelector('input[type="radio"]');
            const sel = radio.value === metodoSimples;
            t.classList.toggle('selected', sel);
            radio.checked = sel;
        });
    }
    pagamentos = [];
    document.getElementById('pgtoSimple').style.display = '';
    document.getElementById('pgtoSplit').style.display = 'none';
    document.getElementById('pgtoStatus').style.display = 'none';
    document.getElementById('btnAddPgto').style.display = '';
    renderPreFactura();
}

function renderPagamentos() {
    const container = document.getElementById('pagamentosList');
    const total = getTotal();
    document.getElementById('pgtoSplitCount').textContent = pagamentos.length;

    container.innerHTML = pagamentos.map(p => {
        const valor = Number(p.valor) || 0;
        return `
            <div class="pgto-linha" data-pgto-id="${p.id}">
                <select class="pgto-metodo" onchange="alterarMetodoPagamento(${p.id}, this.value)">
                    <option value="Dinheiro" ${p.metodo === 'Dinheiro' ? 'selected' : ''}>Dinheiro</option>
                    <option value="cartao_debito" ${p.metodo === 'cartao_debito' ? 'selected' : ''}>TPA (Multicaixa)</option>
                    <option value="transferencia" ${p.metodo === 'transferencia' ? 'selected' : ''}>Transferência</option>
                </select>
                <div class="pgto-valor-wrapper">
                    <input type="number" class="pgto-valor"
                           value="${valor.toFixed(2)}"
                           min="0" step="0.01"
                           oninput="alterarValorPagamento(${p.id}, this.value)">
                    <span class="pgto-moeda">Kz</span>
                </div>
                <button type="button" class="pgto-remove"
                        onclick="removerPagamento(${p.id})"
                        ${pagamentos.length === 1 ? 'disabled' : ''}
                        title="${pagamentos.length === 1 ? 'Último método' : 'Remover'}">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;
    }).join('');

    if (pagamentos.length < 3) {
        const addBtn = document.createElement('button');
        addBtn.type = 'button';
        addBtn.className = 'btn-add-pgto';
        addBtn.style.marginTop = 'var(--s-1)';
        addBtn.innerHTML = '<i class="fas fa-plus"></i> Adicionar';
        addBtn.onclick = adicionarPagamento;
        container.appendChild(addBtn);
    }

    atualizarStatusPagamento();
}

function atualizarStatusPagamento() {
    const total = getTotal();
    const distribuido = getDistribuido();
    const diff = total - distribuido;
    const status = document.getElementById('pgtoStatus');
    if (Math.abs(diff) < 0.01) {
        status.className = 'pgto-status ok';
        status.innerHTML = `<i class="fas fa-check-circle"></i> Completo <strong>${fmtKz(distribuido)}</strong>`;
    } else if (diff > 0) {
        status.className = 'pgto-status falta';
        status.innerHTML = `<i class="fas fa-exclamation-circle"></i> Falta <strong>${fmtKz(diff)}</strong>`;
    } else {
        status.className = 'pgto-status sobra';
        status.innerHTML = `<i class="fas fa-info-circle"></i> Troco <strong>${fmtKz(-diff)}</strong>`;
    }
}

function adicionarPagamento() {
    const total = getTotal();
    const distribuido = getDistribuido();
    const restante = Math.max(0, total - distribuido);
    const usados = new Set(pagamentos.map(p => p.metodo));
    const proximos = ['Dinheiro', 'cartao_debito', 'transferencia'].filter(m => !usados.has(m));
    pagamentos.push({ id: nextPagamentoId++, metodo: proximos[0] || 'Dinheiro', valor: restante });
    renderPagamentos();
}

function removerPagamento(id) {
    if (pagamentos.length === 1) { toast('Pelo menos um método é necessário.', 'warning'); return; }
    pagamentos = pagamentos.filter(p => p.id !== id);
    renderPagamentos();
}

function alterarMetodoPagamento(id, metodo) {
    const p = pagamentos.find(x => x.id === id);
    if (p) p.metodo = metodo;
}

function alterarValorPagamento(id, valor) {
    const p = pagamentos.find(x => x.id === id);
    if (!p) return;
    p.valor = Math.max(0, parseFloat(valor) || 0);
    atualizarStatusPagamento();
}

/* ---------- CARRINHO ---------- */
function adicionarAoCarrinho(produto) {
    if (produto.quantidade_estoque <= 0) { toast('Produto sem stock.', 'error'); return; }
    const existente = carrinho.find(i => i.id === produto.id);
    if (existente) {
        if (existente.quantidade < produto.quantidade_estoque) {
            existente.quantidade++;
            existente.subtotal = existente.quantidade * existente.preco;
        } else {
            toast('Stock máximo: ' + produto.quantidade_estoque, 'warning');
            return;
        }
    } else {
        carrinho.push({
            id: produto.id,
            nome: produto.nome,
            preco: produto.preco_venda,
            quantidade: 1,
            subtotal: produto.preco_venda,
            estoque: produto.quantidade_estoque
        });
    }
    renderPreFactura();
}

function alterarQtdCarrinho(id, delta) {
    const item = carrinho.find(i => String(i.id) === String(id));
    if (!item) return;
    const nova = item.quantidade + delta;
    if (nova < 1) { removerItem(id); return; }
    if (nova > item.estoque) { toast('Stock insuficiente. Máx: ' + item.estoque, 'warning'); return; }
    item.quantidade = nova;
    item.subtotal = nova * item.preco;
    renderPreFactura();
}

function removerItem(id) {
    const item = carrinho.find(i => String(i.id) === String(id));
    if (!item) return;
    carrinho = carrinho.filter(i => String(i.id) !== String(id));
    renderPreFactura();
}

document.getElementById('btnLimpar')?.addEventListener('click', () => {
    if (carrinho.length === 0) return;
    if (!confirm('Remover todos os itens?')) return;
    carrinho = [];
    pagamentos = [];
    modoPagamento = 'simples';
    document.getElementById('pgtoSimple').style.display = '';
    document.getElementById('pgtoSplit').style.display = 'none';
    document.getElementById('pgtoStatus').style.display = 'none';
    renderPreFactura();
});

/* ---------- PESQUISA ---------- */
const searchInput = document.getElementById('produtoSearch');
const searchWrapper = document.getElementById('searchWrapper');
const resultadosList = document.getElementById('resultadosList');
const resultadosCount = document.getElementById('resultadosCount');
const resultadosModo = document.getElementById('resultadosModo');

async function buscarProdutos(termo) {
    if (!termo || termo.length < 2) { mostrarProdutosIniciais(); return; }
    const cacheKey = termo.toLowerCase().trim();
    if (cacheProdutos.has(cacheKey)) { renderResultados(cacheProdutos.get(cacheKey)); return; }
    searchWrapper.classList.add('loading');
    try {
        const resp = await fetch('/api/produtos/buscar?q=' + encodeURIComponent(termo) + '&limit=15', { headers: { 'Accept': 'application/json' } });
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        const data = await resp.json();
        const lista = Array.isArray(data) ? data : (data.produtos || []);
        cacheAdd(cacheKey, lista);
        renderResultados(lista);
    } catch (err) {
        const t = termo.toLowerCase();
        const filtrados = (window.__PRODUTOS_INICIAIS__ || []).filter(p =>
            (p.nome || '').toLowerCase().includes(t) || (p.codigo_barras || '').toLowerCase().includes(t)
        );
        renderResultados(filtrados);
    } finally {
        searchWrapper.classList.remove('loading');
    }
}
const buscarDebounced = debounce(buscarProdutos, 250);

function renderResultados(lista) {
    if (!lista || lista.length === 0) {
        resultadosList.innerHTML = `<div class="resultados-empty"><i class="fas fa-search"></i><span>Nenhum produto encontrado.</span></div>`;
        resultadosCount.textContent = '0';
        return;
    }
    let filtrados = lista;
    if (filtroAtivo === 'stock') filtrados = lista.filter(p => p.quantidade_estoque > 0);
    if (filtroAtivo === 'low') filtrados = lista.filter(p => p.quantidade_estoque > 0 && p.quantidade_estoque <= 5);
    if (filtrados.length === 0) {
        resultadosList.innerHTML = `<div class="resultados-empty"><i class="fas fa-filter"></i><span>Nenhum produto neste filtro.</span></div>`;
        resultadosCount.textContent = lista.length;
        return;
    }
    resultadosList.innerHTML = filtrados.map(p => {
        const estoque = Number(p.quantidade_estoque) || 0;
        const preco = Number(p.preco_venda) || 0;
        const outOfStock = estoque <= 0;
        const stockClass = estoque <= 0 ? 'zero' : (estoque <= 5 ? 'low' : '');
        const metaStockClass = estoque <= 0 ? 'no-stock' : (estoque <= 5 ? 'low-stock' : '');
        return `
            <div class="resultado-item ${outOfStock ? 'out-of-stock' : ''}" data-id="${p.id}">
                <div class="resultado-thumb"><i class="fas fa-box"></i></div>
                <div class="resultado-info">
                    <div class="nome">${escapeHtml(p.nome)}</div>
                    <div class="meta">
                        <span><i class="fas fa-barcode"></i>${escapeHtml(p.codigo_barras || '—')}</span>
                        <span><i class="fas fa-cubes"></i><b class="${metaStockClass}">${estoque}</b></span>
                    </div>
                </div>
                <div class="resultado-preco">
                    <span class="preco">${preco.toLocaleString('pt-AO',{minimumFractionDigits:2,maximumFractionDigits:2})}</span>
                    <span class="stock ${stockClass}">${outOfStock ? 'Sem stock' : 'Kz'}</span>
                </div>
                <button type="button" class="resultado-add" ${outOfStock ? 'disabled' : ''} tabindex="-1"><i class="fas fa-plus"></i></button>
            </div>`;
    }).join('');
    resultadosCount.textContent = filtrados.length;
    resultadosList.querySelectorAll('.resultado-item').forEach(el => {
        const produto = lista.find(p => String(p.id) === String(el.dataset.id));
        if (!produto) return;
        el.addEventListener('click', () => {
            if (produto.quantidade_estoque <= 0) return;
            adicionarAoCarrinho(produto);
        });
    });
}

function mostrarProdutosIniciais() {
    const iniciais = window.__PRODUTOS_INICIAIS__ || [];
    if (iniciais.length === 0) {
        resultadosList.innerHTML = `<div class="resultados-empty"><i class="fas fa-keyboard"></i><span>Bipe um código ou pesquise.</span></div>`;
        resultadosCount.textContent = '0';
        if (resultadosModo) resultadosModo.textContent = '';
        return;
    }
    renderResultados(iniciais);
    if (resultadosModo) resultadosModo.textContent = 'Recentes';
}

if (searchInput) {
    searchInput.addEventListener('input', function() {
        filtroTermo = this.value.trim();
        if (filtroTermo.length === 0) mostrarProdutosIniciais();
        else if (filtroTermo.length >= 2) buscarDebounced(filtroTermo);
    });
    searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { this.value = ''; filtroTermo = ''; mostrarProdutosIniciais(); return; }
        if (e.key === 'Enter') {
            e.preventDefault();
            const itens = resultadosList.querySelectorAll('.resultado-item:not(.out-of-stock)');
            if (itens.length >= 1) { itens[0].click(); this.select(); }
        }
    });
}
document.querySelectorAll('#filtrosRapidos .chip[data-filtro]').forEach(chip => {
    chip.addEventListener('click', function() {
        document.querySelectorAll('#filtrosRapidos .chip').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        filtroAtivo = this.dataset.filtro;
        if (filtroTermo.length >= 2) buscarDebounced(filtroTermo);
        else mostrarProdutosIniciais();
    });
});
document.getElementById('desconto')?.addEventListener('input', renderPreFactura);

/* ---------- NOVO PRODUTO (integrado na venda) ---------- */
function abrirModalNovoProduto() {
    const form = document.getElementById('novoProdutoForm');
    form.reset();
    document.getElementById('npAdicionarAoCarrinho').checked = true;
    document.getElementById('npMinimo').value = '5';
    document.getElementById('npEstoque').value = '0';
    document.getElementById('npAvisoPrecos').style.display = 'none';
    document.getElementById('npPreview').style.display = 'none';
    abrirModal('novoProdutoModal');
    setTimeout(() => document.getElementById('npNome')?.focus(), 100);
}

function tentarFecharNovoProduto() {
    const nome = document.getElementById('npNome').value.trim();
    const preco = document.getElementById('npPreco').value;
    const temDados = nome || preco;
    if (temDados && !confirm('Descartar dados do novo produto?')) return;
    fecharModal('novoProdutoModal');
}

function atualizarPreviewNovoProduto() {
    const custo = parseFloat(document.getElementById('npCusto').value) || 0;
    const venda = parseFloat(document.getElementById('npPreco').value) || 0;
    const estoque = parseInt(document.getElementById('npEstoque').value, 10) || 0;

    const temDados = custo > 0 || venda > 0 || estoque > 0;
    const preview = document.getElementById('npPreview');
    preview.style.display = temDados ? 'grid' : 'none';

    if (temDados) {
        const margem = venda - custo;
        const margemEl = document.getElementById('npPreviewMargem');
        margemEl.textContent = fmtKz(margem);
        margemEl.style.color = margem < 0 ? 'var(--danger)'
                             : margem > 0 ? 'var(--success)'
                             : 'var(--fg)';
        document.getElementById('npPreviewInventario').textContent = fmtKz(venda * estoque);
    }

    const temAviso = custo > 0 && venda > 0 && venda < custo;
    document.getElementById('npAvisoPrecos').style.display = temAviso ? 'flex' : 'none';
}

function produtoNormalizado(p) {
    return {
        id: p.id,
        nome: p.nome,
        preco_venda: Number(p.preco_venda || 0),
        quantidade_estoque: Number(p.quantidade_estoque || 0)
    };
}

document.getElementById('novoProdutoForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('btnGuardarProduto');

    const dados = {
        nome: document.getElementById('npNome').value.trim(),
        codigo_barras: document.getElementById('npCodigo').value.trim(),
        categoria: document.getElementById('npCategoria').value,
        descricao: document.getElementById('npDescricao').value.trim(),
        preco_custo: parseFloat(document.getElementById('npCusto').value) || 0,
        preco_venda: parseFloat(document.getElementById('npPreco').value),
        quantidade_estoque: parseInt(document.getElementById('npEstoque').value, 10) || 0,
        quantidade_minima: parseInt(document.getElementById('npMinimo').value, 10) || 5
    };
    const adicionarAoCarrinhoFlag = document.getElementById('npAdicionarAoCarrinho').checked;

    if (!dados.nome) { toast('Introduza o nome.', 'error'); document.getElementById('npNome').focus(); return; }
    if (!dados.preco_venda || dados.preco_venda <= 0) { toast('Preço inválido.', 'error'); document.getElementById('npPreco').focus(); return; }
    if (dados.preco_custo > 0 && dados.preco_venda < dados.preco_custo) {
        if (!confirm('O preço de venda está abaixo do custo. Guardar mesmo assim?')) return;
    }

    btn.disabled = true;
    btn.setAttribute('aria-busy', 'true');
    btn.dataset.original = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A guardar…';

    let novoProduto = null;
    try {
        const resp = await fetch('/produtos/novo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(dados)
        });
        let data = {};
        try { data = await resp.json(); } catch (err) {}
        if (!resp.ok) throw new Error(data.erro || 'Falha ao registar.');
        novoProduto = data.produto || {
            id: data.id || ('local-' + Date.now()),
            nome: dados.nome,
            codigo_barras: dados.codigo_barras,
            preco_venda: dados.preco_venda,
            quantidade_estoque: dados.quantidade_estoque
        };
    } catch (err) {
        console.warn('Fallback local:', err.message);
        novoProduto = {
            id: 'local-' + Date.now(),
            nome: dados.nome,
            codigo_barras: dados.codigo_barras,
            preco_venda: dados.preco_venda,
            quantidade_estoque: dados.quantidade_estoque
        };
        toast('Guardado localmente. Sincronize quando houver rede.', 'warning', 3500);
    } finally {
        btn.disabled = false;
        btn.setAttribute('aria-busy', 'false');
        btn.innerHTML = btn.dataset.original;
    }

    if (!Array.isArray(window.__PRODUTOS_INICIAIS__)) window.__PRODUTOS_INICIAIS__ = [];
    window.__PRODUTOS_INICIAIS__.unshift(novoProduto);

    let adicionado = false;
    if (adicionarAoCarrinhoFlag) {
        if (Number(novoProduto.quantidade_estoque) > 0) {
            adicionarAoCarrinho(produtoNormalizado(novoProduto));
            adicionado = true;
        } else {
            toast('Produto sem stock. Não foi adicionado ao carrinho.', 'warning', 3000);
        }
    }

    if (filtroTermo.length >= 2) buscarProdutos(filtroTermo);
    else mostrarProdutosIniciais();

    toast(adicionado
        ? `"${novoProduto.nome}" guardado e adicionado ao carrinho.`
        : `"${novoProduto.nome}" guardado.`,
        'success', 2500);

    fecharModal('novoProdutoModal');

    if (adicionado) {
        setTimeout(() => {
            const pref = document.querySelector('.prefactura-itens');
            if (pref) pref.scrollTop = pref.scrollHeight;
        }, 100);
    }
});

/* ---------- CLIENTE ---------- */
function atualizarClientePill() {
    const pill = document.getElementById('clientePill');
    const nomeEl = document.getElementById('clienteNomePill');
    const avatarEl = document.getElementById('clienteAvatarPill');
    if (clienteSelecionado) {
